rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'israt.connect@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserDoc(data, userId) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('role' in data) || data.role in ['user', 'admin'])
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidChatDoc(data) {
      return data.keys().hasAll(['userId', 'title'])
        && data.keys().hasOnly(['userId', 'title', 'createdAt'])
        && data.userId is string && isValidId(data.userId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserDoc(incoming(), userId)
        && (!('role' in incoming()) || incoming().role == 'user' || isAdmin());
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserDoc(incoming(), userId)
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChatDoc(incoming())
        && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChatDoc(incoming())
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['title'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(chatId)
        && (existing().userId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }
  }
}
