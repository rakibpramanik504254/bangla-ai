# Bangla AI (বাংলা এআই) Environment Configuration Template

# Server & Port Configuration
PORT=3000
NODE_ENV="development"
APP_URL="https://ais-dev-viywiqxns7sqv4qvsjio2j-517651776127.asia-east1.run.app"

# Session & Security
# Secret key used for signing session tokens and hashing
AUTH_SECRET="bangla-ai-secret-salt-super-secure-key-2026"

# Default Model Provider Keys (Placeholders to be configured by the owner or in the Admin Panel)
# OpenRouter Unified API Key (One key to access all workspace models: Claude, Gemini, GPT, DeepSeek, Grok, Kimi)
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE"

# Google Gemini API Key (Can be auto-injected from AI Studio secrets or set here)
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# OpenAI API Key (Optional default, also configurable in Admin Panel)
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# Anthropic Claude API Key (Optional default, also configurable in Admin Panel)
ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_API_KEY_HERE"

# DeepSeek API Key (Optional default, also configurable in Admin Panel)
DEEPSEEK_API_KEY="sk-YOUR_DEEPSEEK_API_KEY_HERE"

# Bangladeshi Payment Gateway Configuration (Placeholders)
# bKash Merchant API Credentials
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Nagad Merchant Credentials
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"

# SSLCommerz Credentials
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASS="your_sslcommerz_store_password"
SSLCOMMERZ_IS_SANDBOX=true

# Database Path (Local persistent storage file or PostgreSQL connection)
DATABASE_FILE="data/bangla_ai.json"
