      thinking_signature: "\022\232\v\n\227\v\001i\024}\023~\305\342\361\353\212\310\024\206\276\'\024\210-Bm\311\225C\303\367i\210\361\0037\271f\267Etg\252\352\215\035\346o\276\242W\227\024\326t\302\273}Ho\305g\264\326\331/\217\352\331\363\307\023\303gN\266+\376\356gx\247\305\211\211@u<\307\353\006\247\000\243\254n\270\003\236}|X`\354\004\306\266\227\202\246\a7\323\376\372\223\251\373\212\315\310\220\005A9\352\355\2479\257gv8\aX\033!D\220\247\300\241\244\336\213\303\370\023O\314\00051J\241\031I\201\263\370jR\324\022x\005\336~\350N\230\3133\272?\217w\006.H\230\370|\226=\035\357\030\213\267j?\301{R\373\030\362y\024\254O\024\026\322\262\b\225XQ\306ua:\233|)o\0201\031(\377!\264}-\362\230\203\221\231\037\343\362&6J\023\364\217\023\206\322\v\300\345\022B\313\376\351\244\331\341\037\335[c\034\234JU\177\272\336\030\315n\237\367\201\205\224>\267gwV^\377\377M\222\255\326n\2159`\t\377\353\324J\357u\351\360\255\266\250\352\353\305S\031\0006\251 \356\210\345\211\240\300|\317\213\334Z\237\205\017\234O9(\247\0319\0300\341\310\255=\352;\214\030\334k4^\223\037\254\364\350\335\255\242\244\211\207\346\366+\330S\3629\261`6\b\346\314\301\273#q\302\350\206\232\344\262\b\204\037d`\335\262\330\316t\221\363\017\376\321\2769\260\322\2148\"~-\023|\000\306\030_N\350\301c\307[1\223\\\343jrR\367\244\025\206C\325\2063\307n\036/\261\372<\244M\371a\246\350\240X\024]\375m\254\026\352e\237\270)\313\220!1\242n4r\177\270p/P&A\256\275\266\004\334\222\312\025\332V\355\363\220\3127\316J\233&\t\334\316\330\363YY\340\355\'\301R\216J\353+\344\364\310\235\373\316\244Y\017\351\006\v-\262\325d\334-h\364\235=\037\311o`B\324 \r\030\0257\276\213\333+#T\270(\233~\242)\275D\027\307:\237\373:\224\307\006=\003\031\275;X\224z\200\330\210\025\343\2053\215\257\022\241\316v\303\310\32673\350\363P\235F\367$?6\210uddgzbPl\274\017>\202uQ\260\'x\256\306\233\022\017\031A\312\022vr\341\310\252;#\024\034{\251\t+\035U\226}\347\371\355\372+Cn\360\333RR6\235\327\353L\210y\332\327X\342\304\273\355g\243\030$w\200\347\"\n\024Y\203$Gb