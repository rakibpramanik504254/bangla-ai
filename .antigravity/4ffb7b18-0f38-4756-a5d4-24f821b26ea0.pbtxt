  code_action {
    action_spec {
      create_file {
        instruction: "import test from \'node:test\';\nimport assert from \'node:assert/strict\';\nimport {\n  toBanglaDigits,\n  formatBDT,\n  isSubscriptionActive,\n  calculateExpiryDate,\n  calculateUsageStats,\n  estimateTokens,\n  PLANS\n} from \'./billing.ts\';\n\ntest(\'toBanglaDigits converts Western digits to Bengali numerals\', () => {\n  assert.equal(toBanglaDigits(1299), \'\340\247\247\340\247\250\340\247\257\340\247\257\');\n  assert.equal(toBanglaDigits(9999), \'\340\247\257\340\247\257\340\247\257\340\247\257\');\n  assert.equal(toBanglaDigits(0), \'\340\247\246\');\n  assert.equal(toBanglaDigits(\'2026-11-11\'), \'\340\247\250\340\247\246\340\247\250\340\247\254-\340\247\247\340\247\247-\340\247\247\340\247\247\');\n});\n\ntest(\'formatBDT formats amounts with BDT currency symbol and Bengali digits\', () => {\n  assert.equal(formatBDT(1299), \'\340\247\263\340\247\247,\340\247\250\340\247\257\340\247\257\');\n  assert.equal(formatBDT(9999), \'\340\247\263\340\247\257,\340\247\257\340\247\257\340\247\257\');\n  assert.equal(formatBDT(50000), \'\340\247\263\340\247\253\340\247\246,\340\247\246\340\247\246\340\247\246\');\n});\n\ntest(\'isSubscriptionActive properly validates subscription status and expiry\', () => {\n  assert.equal(isSubscriptionActive(null), false);\n  assert.equal(isSubscriptionActive(undefined), false);\n\n  // Expired in past\n  const pastDate = new Date(Date.now() - 3600 * 1000).toISOString();\n  assert.equal(isSubscriptionActive({ status: \'active\', expires_at: pastDate }), false);\n\n  // Future active\n  const futureDate = new Date(Date.now() + 86400 * 1000 * 10).toISOString();\n  assert.equal(isSubscriptionActive({ status: \'active\', expires_at: futureDate }), true);\n\n  // Inactive status even if date in future\n  assert.equal(isSubscriptionActive({ status: \'cancelled\', expires_at: futureDate }), false);\n  assert.equal(isSubscriptionActive({ status: \'expired\', expires_at: futureDate }), false);\n});\n\ntest(\'calculateExpiryDate calculates 30 days for monthly and 365 days for yearly\', () => {\n  const now = Date.now();\n  const monthlyExpiry = calculateExpiryDate(\'monthly\');\n  const daysMonthly = Math.round((monthlyExpiry.getTime() - now) / (1000 * 60 * 60 * 24));\n  assert.equal(daysMonthly, 30);\n\n  const yearlyExpiry = calculateExpiryDate(\'yearly\');\n  const daysYearly = Math.round((yearlyExpiry.getTime() - now) / (1000 * 60 * 60 * 24));\n  assert.equal(daysYearly, 365);\n});\n\ntest(\'calculateUsageStats calculates remaining tokens and limits properly\', () => {\n  const stats = calculateUsageStats(50000, 12500);\n  assert.equal(stats.limit, 50000);\n  assert.equal(stats.used, 12500);\n  assert.equal(stats.remaining, 37500);\n  assert.equal(stats.percentage, 25);\n  assert.equal(stats.isLimitReached, false);\n\n  const limitReached = calculateUsageStats(50000, 50000);\n  assert.equal(limitReached.isLimitReached, true);\n  assert.equal(limitReached.remaining, 0);\n  assert.equal(limitReached.percentage, 100);\n});\n\ntest(\'estimateTokens calculates realistic token approximations for Bengali and English\', () => {\n  const bnPrompt = \'\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266 \340\246\217\340\246\225\340\246\237\340\246\277 \340\246\270\340\247\201\340\246\250\340\247\215\340\246\246\340\246\260 \340\246\246\340\247\207\340\246\266\';\n  const tokens = estimateTokens(bnPrompt, \'\340\246\271\340\247\215\340\246\257\340\246\276\340\246\201, \340\246\217\340\246\237\340\246\277 \340\246\270\340\246\244\340\247\215\340\246\257\340\245\244\');\n  assert.ok(tokens.promptTokens > 0);\n  assert.ok(tokens.completionTokens > 0);\n  assert.equal(tokens.totalTokens, tokens.promptTokens + tokens.completionTokens);\n});\n\ntest(\'PLANS contains exact specified pricing for Bangladesh\', () => {\n  assert.equal(PLANS.monthly.priceBDT, 1299);\n  assert.equal(PLANS.yearly.priceBDT, 9999);\n});\n"
        path {
          absolute_uri: "file:///src/utils/billing.test.ts"
        }
        overwrite: true
      }
    }
