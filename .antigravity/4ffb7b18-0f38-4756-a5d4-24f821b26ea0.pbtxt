              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      <option value=\"monthly\">\340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 (\340\247\251\340\247\246 \340\246\246\340\246\277\340\246\250)</option>"
