0\246\270\340\246\276/\340\246\256\340\246\276\340\246\270\340\247\215\340\246\237\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\270\340\246\256\340\246\260\340\247\215\340\246\245\340\246\277\340\246\244\340\245\244\\n              </p>\\n            </div>\\n          </div>\\n          <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n            <span className=\\\"px-3 py-1.5 rounded-lg bg-pink-100 text-[#E2136E] text-xs font-bold\\\">bKash</span>\\n            <span className=\\\"px-3 py-1.5 rounded-lg bg-orange-100 text-[#F7941D] text-xs font-bold\\\">Nagad</span>\\n            <span className=\\\"px-3 py-1.5 rounded-lg bg-purple-100 text-[#8C3494] text-xs font-bold\\\">Rocket</span>\\n            <span className=\\\"px-3 py-1.5 rounded-lg bg-blue-100 text-blue-700 text-xs font-bold\\\">Cards</span>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* FAQ Section */}\\n      <section className=\\\"max-w-4xl mx-auto px-4 sm:px-6\\\">\\n        <div className=\\\"text-center mb-10\\\">\\n          <h2 className=\\\"text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white\\\">\\n            \340\246\270\340\246\276\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\234\340\246\277\340\246\234\340\247\215\340\246\236\340\246\276\340\246\270\340\246\276 (FAQ)\\n          </h2>\\n          <p className=\\\"text-xs text-gray-500 mt-1\\\">\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\270\340\246\254 \340\246\252\340\247\215\340\246\260\340\246\266\340\247\215\340\246\250\340\247\207\340\246\260 \340\246\270\340\246\271\340\246\234 \340\246\211\340\246\244\340\247\215\340\246\244\340\246\260</p>\\n        </div>\\n\\n        <div className=\\\"space-y-4\\\">\\n          <div className=\\\"bg-white dark:bg-gray-800 rounded-2xl p-5 border border-gray-200 dark:border-gray-700\\\">\\n            <h4 className=\\\"text-sm font-bold text-gray-900 dark:text-white\\\">\\