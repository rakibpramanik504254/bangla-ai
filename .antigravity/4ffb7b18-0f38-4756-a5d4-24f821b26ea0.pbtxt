  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport {\n  Shield,\n  Users,\n  CreditCard,\n  Cpu,\n  Settings,\n  Search,\n  CheckCircle,\n  AlertCircle,\n  Trash2,\n  Edit,\n  Key,\n  TrendingUp,\n  RefreshCw,\n  Plus,\n  Sliders,\n  Sparkles,\n  Lock,\n  Unlock,\n  Save\n} from \'lucide-react\';\nimport { useAuth } from \'../../context/AuthContext.tsx\';\nimport { formatBDT, toBanglaDigits } from \'../../utils/billing.ts\';\nimport { AdminStats, AiProvider, AiModel } from \'../../types/index.ts\';\n\ninterface AdminUser {\n  id: string;\n  email: string;\n  name: string;\n  phone: string;\n  role: \'user\' | \'admin\';\n  status: \'active\' | \'suspended\';\n  usage_limit: number;\n  current_usage: number;\n  created_at: string;\n  subscription?: {\n    id: string;\n    plan_name: string;\n    status: string;\n    expires_at: string;\n  } | null;\n}\n\nexport const AdminPanel: React.FC = () => {\n  const { user, token } = useAuth();\n  const [activeTab, setActiveTab] = useState<\'overview\' | \'users\' | \'providers\' | \'models\' | \'settings\'>(\'overview\');\n\n  // Stats\n  const [stats, setStats] = useState<AdminStats | null>(null);\n  const [loadingStats, setLoadingStats] = useState(false);\n\n  // Users state\n  const [users, setUsers] = useState<AdminUser[]>([]);\n  const [userSearch, setUserSearch] = useState(\'\');\n  const [loadingUsers, setLoadingUsers] = useState(false);\n  const [selectedUserForSub, setSelectedUserForSub] = useState<AdminUser | null>(null);\n  const [grantPlanId, setGrantPlanId] = useState<\'monthly\' | \'yearly\'>(\'monthly\');\n  const [grantDays, setGrantDays] = useState(30);\n\n  // Providers & Models\n  const [providers, setProviders] = useState<AiProvider[]>([]);\n  const [models, setModels] = useState<AiModel[]>([]);\n  const [editingProviderId, setEditingProviderId] = useState<string | null>(null);\n  const [newApiKey, setNewApiKey] = useState(\'\');\n  const [newBaseUrl, setNewBaseUrl] = useState(\'\');\n\n  // Global settings\n  const [globalSettings, setGlobalSettings] = useState<any>({});\n  const [savingSettings, setSavingSettings] = useState(false);\n  const [feedback, setFeedback] = useState<string | null>(null);\n\n  // Access check\n  if (!user || user.role !== \'admin\') {\n    return (\n      <div className=\"max-w-xl mx-auto py-24 text-center px-4\">\n        <Shield className=\"w-12 h-12 text-red-500 mx-auto mb-3\" />\n        <h2 className=\"text-2xl font-bold text-gray-900 dark:text-white\">\340\246\205\340\246\250\340\246\250\340\247\201\340\246\256\340\247\213\340\246\246\340\246\277\340\246\244 \340\246\252\340\247\215\340\246\260\340\246\254\340\247\207\340\246\266\340\246\276\340\246\247\340\246\277\340\246\225\340\246\276\340\246\260</h2>\n        <p className=\"text-xs text-gray-500 mt-2\">\n          \340\246\217\340\246\207 \340\246\252\340\247\203\340\246\267\340\247\215\340\246\240\340\246\276\340\246\237\340\246\277 \340\246\266\340\247\201\340\246\247\340\247\201\340\246\256\340\246\276\340\246\244\340\247\215\340\246\260 \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\217\340\246\206\340\246\207 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\246\256\340\246\277\340\246\250\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\247\207\340\246\237\340\246\260\340\246\246\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244\340\245\244\n        </p>\n      </div>\n    );\n  }\n\n  // Load Admin Stats\n  const fetchStats = async () => {\n    if (!token) return;\n    setLoadingStats(true);\n    try {\n      const res = await fetch(\'/api/admin/stats\', {\n        headers: { Authorization: `Bearer ${token}` }\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setStats(data);\n      }\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setLoadingStats(false);\n    }\n  };\n\n  // Load Users\n  const fetchUsers = async () => {\n    if (!token) return;\n    setLoadingUsers(true);\n    try {\n      const res = await fetch(`/api/admin/users?search=${encodeURIComponent(userSearch)}`, {\n        headers: { Authorization: `Bearer ${token}` }\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setUsers(data);\n      }\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setLoadingUsers(false);\n    }\n  };\n\n  // Load Providers & Models\n  const fetchProvidersAndModels = async () => {\n    if (!token) return;\n    try {\n      const [pRes, mRes, sRes] = await Promise.all([\n        fetch(\'/api/admin/providers\', { headers: { Authorization: `Bearer ${token}` } }),\n        fetch(\'/api/admin/models\', { headers: { Authorization: `Bearer ${token}` } }),\n        fetch(\'/api/admin/settings\', { headers: { Authorization: `Bearer ${token}` } })\n      ]);\n      if (pRes.ok) setProviders(await pRes.json());\n      if (mRes.ok) setModels(await mRes.json());\n      if (sRes.ok) setGlobalSettings(await sRes.json());\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  useEffect(() => {\n    fetchStats();\n    fetchUsers();\n    fetchProvidersAndModels();\n  }, [token]);\n\n  // Suspend/Activate User\n  const handleToggleUserStatus = async (targetUser: AdminUser) => {\n    const newStatus = targetUser.status === \'active\' ? \'suspended\' : \'active\';\n    try {\n      const res = await fetch(`/api/admin/users/${targetUser.id}`, {\n        method: \'PUT\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({ status: newStatus })\n      });\n      if (res.ok) {\n        fetchUsers();\n        setFeedback(`\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 ${targetUser.name}-\340\246\217\340\246\260 \340\246\270\340\247\215\340\246\237\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\270 ${newStatus === \'active\' ? \'\340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274\' : \'\340\246\270\340\247\215\340\246\245\340\246\227\340\246\277\340\246\244\'} \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244`);\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Update User Limit\n  const handleUpdateUserLimit = async (userId: string, newLimit: string) => {\n    const parsed = parseInt(newLimit, 10);\n    if (isNaN(parsed) || parsed < 0) return;\n    try {\n      const res = await fetch(`/api/admin/users/${userId}`, {\n        method: \'PUT\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({ usage_limit: parsed })\n      });\n      if (res.ok) {\n        fetchUsers();\n        setFeedback(\'\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\270\340\247\200\340\246\256\340\246\276 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\206\340\246\252\340\246\241\340\247\207\340\246\237 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\');\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Delete User\n  const handleDeleteUser = async (userId: string) => {\n    if (!window.confirm(\'\340\246\206\340\246\252\340\246\250\340\246\277 \340\246\225\340\246\277 \340\246\250\340\246\277\340\246\266\340\247\215\340\246\232\340\246\277\340\246\244 \340\246\257\340\247\207 \340\246\217\340\246\207 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237\340\246\237\340\246\277 \340\246\256\340\247\201\340\246\233\340\247\207 \340\246\253\340\247\207\340\246\262\340\246\244\340\247\207 \340\246\232\340\246\276\340\246\250?\')) return;\n    try {\n      const res = await fetch(`/api/admin/users/${userId}`, {\n        method: \'DELETE\',\n        headers: { Authorization: `Bearer ${token}` }\n      });\n      if (res.ok) {\n        fetchUsers();\n        fetchStats();\n        setFeedback(\'\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\241\340\246\277\340\246\262\340\246\277\340\246\237 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\');\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Grant Subscription\n  const handleGrantSubscription = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedUserForSub) return;\n    try {\n      const res = await fetch(`/api/admin/users/${selectedUserForSub.id}/subscription`, {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({\n          planId: grantPlanId,\n          days: grantDays\n        })\n      });\n      if (res.ok) {\n        fetchUsers();\n        fetchStats();\n        setSelectedUserForSub(null);\n        setFeedback(\'\340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\252\340\247\215\340\246\260\340\246\246\340\246\276\340\246\250 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207!\');\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Save Provider API Key\n  const handleSaveProvider = async (providerId: string) => {\n    try {\n      const res = await fetch(`/api/admin/providers/${providerId}`, {\n        method: \'PUT\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({\n          api_key: newApiKey || undefined,\n          base_url: newBaseUrl || undefined\n        })\n      });\n      if (res.ok) {\n        fetchProvidersAndModels();\n        setEditingProviderId(null);\n        setNewApiKey(\'\');\n        setNewBaseUrl(\'\');\n        setFeedback(\'\340\246\252\340\247\215\340\246\260\340\247\213\340\246\255\340\246\276\340\246\207\340\246\241\340\246\276\340\246\260 \340\246\225\340\246\250\340\246\253\340\246\277\340\246\227\340\246\276\340\246\260\340\247\207\340\246\266\340\246\250 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\');\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Toggle Model Enabled\n  const handleToggleModel = async (model: AiModel) => {\n    try {\n      const res = await fetch(`/api/admin/models/${model.id}`, {\n        method: \'PUT\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({ is_enabled: !model.is_enabled })\n      });\n      if (res.ok) {\n        fetchProvidersAndModels();\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  // Save Global Settings\n  const handleSaveSettings = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setSavingSettings(true);\n    try {\n      const res = await fetch(\'/api/admin/settings\', {\n        method: \'PUT\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify(globalSettings)\n      });\n      if (res.ok) {\n        setFeedback(\'\340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\270\340\247\207\340\246\237\340\246\277\340\246\202\340\246\270 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\206\340\246\252\340\246\241\340\247\207\340\246\237 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\');\n      }\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setSavingSettings(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6 animate-in fade-in\">\n      {/* Top Admin Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 dark:border-gray-800 pb-5\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold\">\n            <Shield className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <h1 className=\"text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n              <span>\340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\246\256\340\246\277\340\246\250 \340\246\225\340\246\250\340\247\215\340\246\237\340\247\215\340\246\260\340\247\213\340\246\262 \340\246\252\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\262</span>\n              <span className=\"text-xs bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 px-2 py-0.5 rounded-full font-bold\">\n                RBAC \340\246\270\340\247\201\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244\n              </span>\n            </h1>\n            <p className=\"text-xs text-gray-500\">\n              \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200, \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250, \340\246\217\340\246\206\340\246\207 \340\246\256\340\246\241\340\247\207\340\246\262 \340\246\217\340\246\252\340\246\277\340\246\206\340\246\207 \340\246\225\340\246\277 \340\246\223 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260 \340\246\270\340\247\200\340\246\256\340\246\276 \340\246\250\340\246\277\340\246\257\340\246\274\340\246\250\340\247\215\340\246\244\340\247\215\340\246\260\340\246\243\n            </p>\n          </div>\n        </div>\n\n        <button\n          onClick={() => {\n            fetchStats();\n            fetchUsers();\n            fetchProvidersAndModels();\n          }}\n          className=\"self-start sm:self-auto px-3 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 text-xs font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-1.5 transition-colors\"\n        >\n          <RefreshCw className=\"w-3.5 h-3.5\" />\n          <span>\340\246\260\340\246\277\340\246\253\340\247\215\340\246\260\340\247\207\340\246\266 \340\246\241\340\247\207\340\246\237\340\246\276</span>\n        </button>\n      </div>\n\n      {feedback && (\n        <div className=\"p-3 text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 rounded-xl flex items-center justify-between animate-in fade-in\">\n          <div className=\"flex items-center gap-2\">\n            <CheckCircle className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n            <span>{feedback}</span>\n          </div>\n          <button onClick={() => setFeedback(null)} className=\"text-emerald-700 hover:underline\">\n            \342\234\225\n          </button>\n        </div>\n      )}\n\n      {/* Tabs Navigation */}\n      <div className=\"flex items-center gap-2 border-b border-gray-200 dark:border-gray-800 overflow-x-auto pb-1 text-xs sm:text-sm font-semibold\">\n        <button\n          onClick={() => setActiveTab(\'overview\')}\n          className={`px-4 py-2 rounded-xl transition-colors flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'overview\'\n              ? \'bg-amber-500 text-white shadow-sm\'\n              : \'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800\'\n          }`}\n        >\n          <TrendingUp className=\"w-4 h-4\" />\n          <span>\340\246\241\340\247\215\340\246\257\340\246\276\340\246\266\340\246\254\340\247\213\340\246\260\340\247\215\340\246\241 \340\246\223 \340\246\252\340\246\260\340\246\277\340\246\270\340\246\202\340\246\226\340\247\215\340\246\257\340\246\276\340\246\250</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'users\')}\n          className={`px-4 py-2 rounded-xl transition-colors flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'users\'\n              ? \'bg-amber-500 text-white shadow-sm\'\n              : \'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800\'\n          }`}\n        >\n          <Users className=\"w-4 h-4\" />\n          <span>\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 \340\246\223 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'providers\')}\n          className={`px-4 py-2 rounded-xl transition-colors flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'providers\'\n              ? \'bg-amber-500 text-white shadow-sm\'\n              : \'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800\'\n          }`}\n        >\n          <Key className=\"w-4 h-4\" />\n          <span>\340\246\217\340\246\206\340\246\207 \340\246\252\340\247\215\340\246\260\340\247\213\340\246\255\340\246\276\340\246\207\340\246\241\340\246\276\340\246\260 \340\246\223 API Keys</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'models\')}\n          className={`px-4 py-2 rounded-xl transition-colors flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'models\'\n              ? \'bg-amber-500 text-white shadow-sm\'\n              : \'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800\'\n          }`}\n        >\n          <Cpu className=\"w-4 h-4\" />\n          <span>\340\246\256\340\246\241\340\247\207\340\246\262\340\246\270\340\246\256\340\247\202\340\246\271 \340\246\252\340\246\260\340\246\277\340\246\232\340\246\276\340\246\262\340\246\250\340\246\276</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'settings\')}\n          className={`px-4 py-2 rounded-xl transition-colors flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'settings\'\n              ? \'bg-amber-500 text-white shadow-sm\'\n              : \'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800\'\n          }`}\n        >\n          <Settings className=\"w-4 h-4\" />\n          <span>\340\246\227\340\247\215\340\246\262\340\247\213\340\246\254\340\246\276\340\246\262 \340\246\262\340\246\277\340\246\256\340\246\277\340\246\237 \340\246\223 \340\246\270\340\247\207\340\246\237\340\246\277\340\246\202\340\246\270</span>\n        </button>\n      </div>\n\n      {/* Tab 1: Overview */}\n      {activeTab === \'overview\' && (\n        <div className=\"space-y-6\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n            <div className=\"bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm\">\n              <span className=\"text-xs text-gray-500 block\">\340\246\256\340\247\213\340\246\237 \340\246\250\340\246\277\340\246\254\340\246\250\340\247\215\340\246\247\340\246\277\340\246\244 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200</span>\n              <p className=\"text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white mt-1\">\n                {stats ? toBanglaDigits(stats.totalUsers) : \'...\'} \340\246\234\340\246\250\n              </p>\n              <span className=\"text-[11px] text-emerald-600 font-medium\">\340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237\340\246\270</span>\n            </div>\n\n            <div className=\"bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm\">\n              <span className=\"text-xs text-gray-500 block\">\340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\252\340\247\207\340\246\207\340\246\241 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\276\340\246\207\340\246\254\340\246\276\340\246\260</span>\n              <p className=\"text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1\">\n                {stats ? toBanglaDigits(stats.activeSubscribers) : \'...\'} \340\246\234\340\246\250\n              </p>\n              <span className=\"text-[11px] text-gray-400\">\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\247\215\340\246\270\340\247\207\340\246\270 \340\246\270\340\247\201\340\246\254\340\246\277\340\246\247\340\246\276\340\246\255\340\247\213\340\246\227\340\247\200</span>\n            </div>\n\n            <div className=\"bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm\">\n              <span className=\"text-xs text-gray-500 block\">\340\246\256\340\247\213\340\246\237 \340\246\270\340\246\202\340\246\227\340\247\203\340\246\271\340\247\200\340\246\244 \340\246\206\340\246\257\340\246\274 (Revenue)</span>\n              <p className=\"text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white mt-1\">\n                {stats ? formatBDT(stats.totalRevenue) : \'...\'}\n              </p>\n              <span className=\"text-[11px] text-emerald-600 font-medium\">\340\246\254\340\246\277\340\246\225\340\246\276\340\246\266/\340\246\250\340\246\227\340\246\246 \340\246\270\340\246\253\340\246\262 \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237\340\246\270</span>\n            </div>\n\n            <div className=\"bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm\">\n              <span className=\"text-xs text-gray-500 block\">\340\246\256\340\247\213\340\246\237 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\247\203\340\246\244 \340\246\217\340\246\206\340\246\207 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250</span>\n              <p className=\"text-2xl sm:text-3xl font-extrabold text-purple-600 dark:text-purple-400 mt-1\">\n                {stats ? toBanglaDigits(stats.totalTokensUsed.toLocaleString()) : \'...\'}\n              </p>\n              <span className=\"text-[11px] text-gray-400\">\340\246\270\340\246\260\340\247\215\340\246\254\340\246\256\340\247\213\340\246\237 \340\246\252\340\247\215\340\246\260\340\246\256\340\247\215\340\246\252\340\246\237 \340\246\223 \340\246\260\340\247\207\340\246\270\340\246\252\340\246\250\340\247\215\340\246\270</span>\n            </div>\n          </div>\n\n          {/* Model Breakdown */}\n          <div className=\"bg-white dark:bg-gray-800 p-6 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm\">\n            <h3 className=\"font-bold text-gray-900 dark:text-white text-base mb-4\">\n              \340\246\256\340\246\241\340\247\207\340\246\262\340\246\255\340\246\277\340\246\244\340\247\215\340\246\244\340\246\277\340\246\225 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\254\340\246\277\340\246\255\340\246\276\340\246\234\340\246\250\n            </h3>\n            {stats && Object.keys(stats.modelUsageMap).length > 0 ? (\n              <div className=\"space-y-3\">\n                {Object.entries(stats.modelUsageMap).map(([modelId, tokens]) => {\n                  const m = models.find(mod => mod.id === modelId);\n                  return (\n                    <div key={modelId} className=\"flex items-center justify-between text-xs py-2 border-b border-gray-100 dark:border-gray-700\">\n                      <span className=\"font-semibold text-gray-800 dark:text-gray-200\">{m?.display_name || modelId}</span>\n                      <span className=\"font-mono text-emerald-600 font-bold\">{toBanglaDigits(tokens.toLocaleString())} \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250</span>\n                    </div>\n                  );\n                })}\n              </div>\n            ) : (\n              <p className=\"text-xs text-gray-400\">\340\246\217\340\246\226\340\246\250\340\247\213 \340\246\225\340\247\213\340\246\250\340\247\213 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260 \340\246\260\340\247\207\340\246\225\340\246\260\340\247\215\340\246\241 \340\246\244\340\247\210\340\246\260\340\246\277 \340\246\271\340\246\257\340\246\274\340\246\250\340\246\277\340\245\244</p>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Tab 2: Users Management */}\n      {activeTab === \'users\' && (\n        <div className=\"space-y-4\">\n          <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <div className=\"relative w-full sm:w-72\">\n              <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-gray-400\" />\n              <input\n                type=\"text\"\n                value={userSearch}\n                onChange={e => setUserSearch(e.target.value)}\n                onKeyDown={e => e.key === \'Enter\' && fetchUsers()}\n                placeholder=\"\340\246\250\340\246\276\340\246\256 \340\246\254\340\246\276 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\246\340\246\277\340\246\257\340\246\274\340\247\207 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\201\340\246\250...\"\n                className=\"w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-amber-500\"\n              />\n            </div>\n            <span className=\"text-xs text-gray-500 self-end sm:self-auto\">\n              \340\246\256\340\247\213\340\246\237 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200: {toBanglaDigits(users.length)} \340\246\234\340\246\250\n            </span>\n          </div>\n\n          <div className=\"bg-white dark:bg-gray-800 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-gray-50 dark:bg-gray-900/50 border-b border-gray-200 dark:border-gray-700 text-gray-500\">\n                  <tr>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\260\340\247\213\340\246\262</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260 / \340\246\262\340\246\277\340\246\256\340\246\277\340\246\237</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\270\340\247\215\340\246\237\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\270</th>\n                    <th className=\"py-3 px-4 font-semibold text-right\">\340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\266\340\246\250</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-gray-100 dark:divide-gray-700/60\">\n                  {users.map(u => (\n                    <tr key={u.id} className=\"hover:bg-gray-50 dark:hover:bg-gray-900/30\">\n                      <td className=\"py-3 px-4\">\n                        <div className=\"font-bold text-gray-900 dark:text-white\">{u.name}</div>\n                        <div className=\"text-[11px] text-gray-500\">{u.email}</div>\n                        {u.phone && <div className=\"text-[10px] text-gray-400\">{u.phone}</div>}\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                          u.role === \'admin\'\n                            ? \'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300\'\n                            : \'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300\'\n                        }`}>\n                          {u.role === \'admin\' ? \'\340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\246\256\340\246\277\340\246\250\' : \'\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200\'}\n                        </span>\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        {u.subscription ? (\n                          <div>\n                            <span className=\"font-semibold text-emerald-600 block\">{u.subscription.plan_name}</span>\n                            <span className=\"text-[10px] text-gray-400\">\n                              \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246: {new Date(u.subscription.expires_at).toLocaleDateString(\'bn-BD\')}\n                            </span>\n                          </div>\n                        ) : (\n                          <span className=\"text-gray-400 italic\">\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\250\340\247\207\340\246\207</span>\n                        )}\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        <div className=\"flex items-center gap-1.5\">\n                          <span className=\"font-bold text-gray-800 dark:text-gray-200\">\n                            {toBanglaDigits((u.current_usage || 0).toLocaleString())}\n                          </span>\n                          <span className=\"text-gray-400\">/</span>\n                          <input\n                            type=\"number\"\n                            defaultValue={u.usage_limit}\n                            onBlur={e => handleUpdateUserLimit(u.id, e.target.value)}\n                            className=\"w-20 px-1.5 py-0.5 rounded border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-xs font-mono\"\n                          />\n                        </div>\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        <button\n                          onClick={() => handleToggleUserStatus(u)}\n                          className={`px-2.5 py-1 rounded-full text-[10px] font-bold flex items-center gap-1 ${\n                            u.status === \'active\'\n                              ? \'bg-emerald-100 text-emerald-800 hover:bg-emerald-200\'\n                              : \'bg-red-100 text-red-800 hover:bg-red-200\'\n                          }`}\n                        >\n                          {u.status === \'active\' ? (\n                            <>\n                              <CheckCircle className=\"w-3 h-3\" />\n                              <span>\340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274</span>\n                            </>\n                          ) : (\n                            <>\n                              <Lock className=\"w-3 h-3\" />\n                              <span>\340\246\270\340\247\215\340\246\245\340\246\227\340\246\277\340\246\244</span>\n                            </>\n                          )}\n                        </button>\n                      </td>\n                      <td className=\"py-3 px-4 text-right space-x-1\">\n                        <button\n                          onClick={() => setSelectedUserForSub(u)}\n                          className=\"px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-semibold hover:bg-emerald-100\"\n                        >\n                          \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\246\340\246\277\340\246\250\n                        </button>\n                        {u.role !== \'admin\' && (\n                          <button\n                            onClick={() => handleDeleteUser(u.id)}\n                            className=\"p-1 text-gray-400 hover:text-red-500 rounded\"\n                            title=\"\340\246\256\340\247\201\340\246\233\340\247\207 \340\246\253\340\247\207\340\246\262\340\247\201\340\246\250\"\n                          >\n                            <Trash2 className=\"w-4 h-4\" />\n                          </button>\n                        )}\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          {/* Grant Subscription Modal */}\n          {selectedUserForSub && (\n            <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\">\n              <div className=\"bg-white dark:bg-gray-800 rounded-3xl p-6 max-w-md w-full border border-gray-200 dark:border-gray-700 shadow-2xl\">\n                <h3 className=\"font-bold text-base text-gray-900 dark:text-white mb-2\">\n                  \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200\340\246\225\340\247\207 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\252\340\247\215\340\246\260\340\246\246\340\246\276\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\n                </h3>\n                <p className=\"text-xs text-gray-500 mb-4\">\n                  \340\246\227\340\247\215\340\246\260\340\246\276\340\246\271\340\246\225: <strong>{selectedUserForSub.name}</strong> ({selectedUserForSub.email})\n                </p>\n\n                <form onSubmit={handleGrantSubscription} className=\"space-y-4 text-xs\">\n                  <div>\n                    <label className=\"block font-semibold mb-1\">\340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250:</label>\n                    <select\n                      value={grantPlanId}\n                      onChange={e => {\n                        const val = e.target.value as \'monthly\' | \'yearly\';\n                        setGrantPlanId(val);\n                        setGrantDays(val === \'yearly\' ? 365 : 30);\n                      }}\n                      className=\"w-full p-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900\"\n                    >\n                      <option value=\"monthly\">\340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 (\340\247\251\340\247\246 \340\246\246\340\246\277\340\246\250)</option>\n                      <option value=\"yearly\">\340\246\254\340\246\276\340\247\216\340\246\270\340\246\260\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 (\340\247\251\340\247\254\340\247\253 \340\246\246\340\246\277\340\246\250)</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block font-semibold mb-1\">\340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246 (\340\246\246\340\246\277\340\246\250 \340\246\270\340\246\202\340\246\226\340\247\215\340\246\257\340\246\276):</label>\n                    <input\n                      type=\"number\"\n                      value={grantDays}\n                      onChange={e => setGrantDays(parseInt(e.target.value, 10))}\n                      className=\"w-full p-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 font-mono\"\n                    />\n                  </div>\n\n                  <div className=\"flex justify-end gap-2 pt-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setSelectedUserForSub(null)}\n                      className=\"px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700\"\n                    >\n                      \340\246\254\340\246\276\340\246\244\340\246\277\340\246\262\n                    </button>\n                    <button\n                      type=\"submit\"\n                      className=\"px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold\"\n                    >\n                      \340\246\250\340\246\277\340\246\266\340\247\215\340\246\232\340\246\277\340\246\244 \340\246\223 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\225\340\246\260\340\247\201\340\246\250\n                    </button>\n                  </div>\n                </form>\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Tab 3: Providers & API Keys */}\n      {activeTab === \'providers\' && (\n        <div className=\"space-y-4\">\n          <div className=\"bg-amber-50 dark:bg-amber-950/30 p-4 rounded-2xl border border-amber-200 dark:border-amber-800 text-xs text-amber-800 dark:text-amber-300 flex items-start gap-2.5\">\n            <Lock className=\"w-4 h-4 shrink-0 mt-0.5\" />\n            <span>\n              <strong>\340\246\250\340\246\277\340\246\260\340\246\276\340\246\252\340\246\244\340\247\215\340\246\244\340\246\276 \340\246\250\340\247\200\340\246\244\340\246\277:</strong> \340\246\217\340\246\226\340\246\276\340\246\250\340\247\207 \340\246\225\340\246\250\340\246\253\340\246\277\340\246\227\340\246\276\340\246\260 \340\246\225\340\246\260\340\246\276 \340\246\257\340\247\207\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\217\340\246\206\340\246\207 \340\246\217\340\246\252\340\246\277\340\246\206\340\246\207 \340\246\225\340\246\277 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\255\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\270\340\247\201\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\241\340\247\207\340\246\237\340\246\276\340\246\254\340\247\207\340\246\234\340\247\207 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\245\340\246\276\340\246\225\340\247\207 \340\246\217\340\246\254\340\246\202 \340\246\225\340\246\226\340\246\250\340\247\213\340\246\207 \340\246\253\340\247\215\340\246\260\340\246\250\340\247\215\340\246\237\340\246\217\340\246\250\340\247\215\340\246\241 \340\246\225\340\247\215\340\246\262\340\246\276\340\246\257\340\246\274\340\247\207\340\246\250\340\247\215\340\246\237\340\247\207 \340\246\252\340\247\215\340\246\260\340\246\225\340\246\276\340\246\266 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274 \340\246\250\340\246\276\340\245\244\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {providers.map(p => (\n              <div key={p.id} className=\"bg-white dark:bg-gray-800 p-5 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <Key className=\"w-4 h-4 text-amber-500\" />\n                    <h3 className=\"font-bold text-gray-900 dark:text-white text-sm\">{p.name}</h3>\n                  </div>\n                  <span className=\"text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300\">\n                    \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\252\340\247\215\340\246\260\340\247\213\340\246\255\340\246\276\340\246\207\340\246\241\340\246\276\340\246\260\n                  </span>\n                </div>\n\n                <div className=\"text-xs space-y-2\">\n                  <div className=\"flex items-center justify-between text-gray-500\">\n                    <span>\340\246\225\340\246\250\340\246\253\340\246\277\340\246\227\340\246\276\340\246\260\340\247\207\340\246\266\340\246\250 \340\246\270\340\247\215\340\246\262\340\246\276\340\246\227:</span>\n                    <span className=\"font-mono text-gray-700 dark:text-gray-300\">{p.slug}</span>\n                  </div>\n\n                  <div className=\"flex items-center justify-between text-gray-500\">\n                    <span>\340\246\254\340\246\260\340\247\215\340\246\244\340\246\256\340\246\276\340\246\250 API Key:</span>\n                    <span className=\"font-mono font-bold text-gray-800 dark:text-gray-200\">\n                      {p.api_key_masked || (p.slug === \'gemini\' ? \'AI Studio Env Key (\340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274)\' : \'\340\246\270\340\247\207\340\246\237 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\246\250\340\246\277 (\340\246\252\340\247\215\340\246\262\340\247\207\340\246\270\340\246\271\340\247\213\340\246\262\340\247\215\340\246\241\340\246\276\340\246\260)\')}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center justify-between text-gray-500\">\n                    <span>\340\246\254\340\247\207\340\246\270 \340\246\207\340\246\211\340\246\206\340\246\260\340\246\217\340\246\262:</span>\n                    <span className=\"font-mono text-[11px] truncate max-w-[200px]\">{p.base_url || \'\340\246\241\340\246\277\340\246\253\340\246\262\340\247\215\340\246\237\'}</span>\n                  </div>\n                </div>\n\n                {editingProviderId === p.id ? (\n                  <div className=\"pt-3 border-t border-gray-100 dark:border-gray-700 space-y-2\">\n                    <input\n                      type=\"password\"\n                      placeholder=\"\340\246\250\340\246\244\340\247\201\340\246\250 API Key \340\246\252\340\247\215\340\246\260\340\246\254\340\247\207\340\246\266 \340\246\225\340\246\260\340\246\276\340\246\250 (sk-...)\"\n                      value={newApiKey}\n                      onChange={e => setNewApiKey(e.target.value)}\n                      className=\"w-full p-2 text-xs rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 font-mono\"\n                    />\n                    <input\n                      type=\"text\"\n                      placeholder=\"\340\246\225\340\246\276\340\246\270\340\247\215\340\246\237\340\246\256 Base URL (\340\246\220\340\246\232\340\247\215\340\246\233\340\246\277\340\246\225)\"\n                      value={newBaseUrl}\n                      onChange={e => setNewBaseUrl(e.target.value)}\n                      className=\"w-full p-2 text-xs rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 font-mono\"\n                    />\n                    <div className=\"flex justify-end gap-2 pt-1\">\n                      <button\n                        onClick={() => setEditingProviderId(null)}\n                        className=\"px-3 py-1 rounded-lg border text-xs\"\n                      >\n                        \340\246\254\340\246\276\340\246\244\340\246\277\340\246\262\n                      </button>\n                      <button\n                        onClick={() => handleSaveProvider(p.id)}\n                        className=\"px-3 py-1 rounded-lg bg-emerald-600 text-white text-xs font-bold\"\n                      >\n                        \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\n                      </button>\n                    </div>\n                  </div>\n                ) : (\n                  <button\n                    onClick={() => {\n                      setEditingProviderId(p.id);\n                      setNewApiKey(\'\');\n                      setNewBaseUrl(p.base_url || \'\');\n                    }}\n                    className=\"w-full py-2 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-xs font-semibold text-gray-800 dark:text-white transition-colors\"\n                  >\n                    API Key \340\246\252\340\246\260\340\246\277\340\246\254\340\246\260\340\247\215\340\246\244\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\n                  </button>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Tab 4: Models Management */}\n      {activeTab === \'models\' && (\n        <div className=\"space-y-4\">\n          <div className=\"bg-white dark:bg-gray-800 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden\">\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-gray-50 dark:bg-gray-900/50 border-b border-gray-200 dark:border-gray-700 text-gray-500\">\n                  <tr>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\256\340\246\241\340\247\207\340\246\262\340\247\207\340\246\260 \340\246\250\340\246\276\340\246\256</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\254\340\247\215\340\246\257\340\246\276\340\246\234</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\225\340\246\250\340\246\237\340\247\207\340\246\225\340\247\215\340\246\270\340\246\237 \340\246\211\340\246\207\340\246\250\340\247\215\340\246\241\340\247\213</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\256\340\247\215\340\246\257\340\246\276\340\246\225\340\247\215\340\246\270 \340\246\206\340\246\211\340\246\237\340\246\252\340\247\201\340\246\237</th>\n                    <th className=\"py-3 px-4 font-semibold\">\340\246\270\340\247\215\340\246\237\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\270</th>\n                    <th className=\"py-3 px-4 font-semibold text-right\">\340\246\237\340\246\227\340\246\262</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-gray-100 dark:divide-gray-700/60\">\n                  {models.map(m => (\n                    <tr key={m.id} className=\"hover:bg-gray-50 dark:hover:bg-gray-900/30\">\n                      <td className=\"py-3 px-4\">\n                        <div className=\"font-bold text-gray-900 dark:text-white\">{m.display_name}</div>\n                        <div className=\"text-[10px] font-mono text-gray-400\">{m.model_name}</div>\n                      </td>\n                      <td className=\"py-3 px-4\">\n                        <span className=\"px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-[10px] font-bold\">\n                          {m.badge}\n                        </span>\n                      </td>\n                      <td className=\"py-3 px-4 font-mono\">{toBanglaDigits(m.context_window.toLocaleString())}</td>\n                      <td className=\"py-3 px-4 font-mono\">{toBanglaDigits(m.max_output_tokens.toLocaleString())}</td>\n                      <td className=\"py-3 px-4\">\n                        <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                          m.is_enabled\n                            ? \'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300\'\n                            : \'bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400\'\n                        }`}>\n                          {m.is_enabled ? \'\340\246\270\340\246\225\340\247\215\340\246\267\340\246\256\' : \'\340\246\250\340\246\277\340\246\267\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274\'}\n                        </span>\n                      </td>\n                      <td className=\"py-3 px-4 text-right\">\n                        <button\n                          onClick={() => handleToggleModel(m)}\n                          className={`px-3 py-1 rounded-lg text-xs font-semibold ${\n                            m.is_enabled\n                              ? \'bg-red-50 text-red-600 hover:bg-red-100\'\n                              : \'bg-emerald-50 text-emerald-600 hover:bg-emerald-100\'\n                          }`}\n                        >\n                          {m.is_enabled ? \'\340\246\254\340\246\250\340\247\215\340\246\247 \340\246\225\340\246\260\340\247\201\340\246\250\' : \'\340\246\232\340\246\276\340\246\262\340\247\201 \340\246\225\340\246\260\340\247\201\340\246\250\'}\n                        </button>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Tab 5: Settings */}\n      {activeTab === \'settings\' && (\n        <form onSubmit={handleSaveSettings} className=\"bg-white dark:bg-gray-800 p-6 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-sm space-y-4 max-w-2xl text-xs\">\n          <h3 className=\"font-bold text-sm text-gray-900 dark:text-white mb-2\">\n            \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\237\340\246\253\340\246\260\340\247\215\340\246\256 \340\246\227\340\247\215\340\246\262\340\247\213\340\246\254\340\246\276\340\246\262 \340\246\262\340\246\277\340\246\256\340\246\277\340\246\237 \340\246\223 \340\246\270\340\246\276\340\246\252\340\247\213\340\246\260\340\247\215\340\246\237 \340\246\225\340\246\250\340\246\253\340\246\277\340\246\227\340\246\276\340\246\260\340\247\207\340\246\266\340\246\250\n          </h3>\n\n          <div>\n            <label className=\"block font-semibold mb-1\">\340\246\241\340\246\277\340\246\253\340\246\262\340\247\215\340\246\237 \340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\270\340\247\200\340\246\256\340\246\276 (\340\246\237\340\247\213\340\246\225\340\247\207\340\246\250):</label>\n            <input\n              type=\"number\"\n              value={globalSettings.global_usage_limit || 50000}\n              onChange={e => setGlobalSettings({ ...globalSettings, global_usage_limit: parseInt(e.target.value, 10) })}\n              className=\"w-full p-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 font-mono text-sm\"\n            />\n            <p className=\"text-[10px] text-gray-400 mt-1\">\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\260\340\247\207\340\246\234\340\246\277\340\246\270\340\247\215\340\246\237\340\246\276\340\246\260 \340\246\225\340\246\260\340\246\276 \340\246\270\340\246\254 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 \340\246\266\340\247\201\340\246\260\340\247\201\340\246\244\340\247\207 \340\246\217\340\246\207 \340\246\270\340\247\200\340\246\256\340\246\276 \340\246\252\340\246\276\340\246\254\340\247\207\340\246\250\340\245\244</p>\n          </div>\n\n          <div>\n            <label className=\"block font-semibold mb-1\">\340\246\270\340\246\276\340\246\252\340\247\213\340\246\260\340\247\215\340\246\237 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262:</label>\n            <input\n              type=\"email\"\n              value={globalSettings.support_email || \'support@bangla.ai\'}\n              onChange={e => setGlobalSettings({ ...globalSettings, support_email: e.target.value })}\n              className=\"w-full p-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block font-semibold mb-1\">\340\246\270\340\246\276\340\246\252\340\247\213\340\246\260\340\247\215\340\246\237 \340\246\253\340\247\213\340\246\250 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260:</label>\n            <input\n              type=\"text\"\n              value={globalSettings.support_phone || \'+880 9612-000000\'}\n              onChange={e => setGlobalSettings({ ...globalSettings, support_phone: e.target.value })}\n              className=\"w-full p-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm\"\n            />\n          </div>\n\n          <div className=\"pt-2\">\n            <button\n              type=\"submit\"\n              disabled={savingSettings}\n              className=\"px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-2 shadow-sm\"\n            >\n              <Save className=\"w-4 h-4\" />\n              <span>{savingSettings ? \'\340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\271\340\246\232\340\247\215\340\246\233\340\247\207...\' : \'\340\246\270\340\247\207\340\246\237\340\246\277\340\246\202\340\246\270 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250\'}</span>\n            </button>\n          </div>\n        </form>\n      )}\n    </div>\n  );\n};\n"
