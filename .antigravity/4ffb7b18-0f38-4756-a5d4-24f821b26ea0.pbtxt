      create_file {
        instruction: "import fs from \'node:fs\';\nimport path from \'node:path\';\nimport crypto from \'node:crypto\';\nimport { PLANS, calculateExpiryDate } from \'../utils/billing.ts\';\n\nexport interface User {\n  id: string;\n  email: string;\n  password_hash: string;\n  name: string;\n  phone: string;\n  role: \'user\' | \'admin\';\n  status: \'active\' | \'suspended\';\n  usage_limit: number; // e.g. 50000 tokens\n  current_usage: number;\n  reset_token?: string | null;\n  reset_token_expires_at?: string | null;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Subscription {\n  id: string;\n  user_id: string;\n  plan_id: \'monthly\' | \'yearly\';\n  plan_name: string;\n  amount: number;\n  currency: \'BDT\';\n  status: \'active\' | \'expired\' | \'cancelled\';\n  started_at: string;\n  expires_at: string;\n  auto_renew: boolean;\n  payment_method: string;\n  trx_id: string;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Payment {\n  id: string;\n  user_id: string;\n  subscription_id?: string;\n  amount: number;\n  currency: \'BDT\';\n  gateway: \'bkash\' | \'nagad\' | \'rocket\' | \'sslcommerz\';\n  trx_id: string;\n  sender_number: string;\n  status: \'completed\' | \'pending\' | \'failed\';\n  gateway_response?: string;\n  created_at: string;\n}\n\nexport interface Chat {\n  id: string;\n  user_id: string;\n  title: string;\n  model_id: string;\n  pinned: boolean;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Message {\n  id: string;\n  chat_id: string;\n  role: \'user\' | \'assistant\' | \'system\';\n  content: string;\n  model_id: string;\n  tokens_used: number;\n  created_at: string;\n}\n\nexport interface AiProvider {\n  id: string;\n  name: string;\n  slug: string; // \'gemini\' | \'openai\' | \'anthropic\' | \'deepseek\' | \'groq\'\n  api_key: string;\n  base_url?: string;\n  is_active: boolean;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface AiModel {\n  id: string;\n  provider_id: string;\n  model_name: string;\n  display_name: string;\n  description_bn: string;\n  badge: \'super_fast\' | \'reasoning\' | \'coding\' | \'balanced\';\n  is_enabled: boolean;\n  is_default: boolean;\n  context_window: number;\n  max_output_tokens: number;\n  sort_order: number;\n  created_at: string;\n}\n\nexport interface UsageRecord {\n  id: string;\n  user_id: string;\n  chat_id?: string;\n  model_id: string;\n  prompt_tokens: number;\n  completion_tokens: number;\n  total_tokens: number;\n  created_at: string;\n}\n\nexport interface SystemSettings {\n  global_usage_limit: number;\n  default_monthly_price: number;\n  default_yearly_price: number;\n  support_email: string;\n  support_phone: string;\n  announcement_bn?: string;\n}\n\ninterface DatabaseData {\n  users: User[];\n  subscriptions: Subscription[];\n  payments: Payment[];\n  chats: Chat[];\n  messages: Message[];\n  ai_providers: AiProvider[];\n  ai_models: AiModel[];\n  usage_records: UsageRecord[];\n  settings: SystemSettings;\n}\n\n// Password hashing utility using scrypt\nexport function hashPassword(password: string): string {\n  const salt = \'bangla_ai_salt_2026\';\n  return crypto.scryptSync(password, salt, 64).toString(\'hex\');\n}\n\nexport function verifyPassword(password: string, hash: string): boolean {\n  return hashPassword(password) === hash;\n}\n\nclass Database {\n  private dataFile: string;\n  private data: DatabaseData;\n\n  constructor() {\n    const dataDir = path.resolve(process.cwd(), \'data\');\n    if (!fs.existsSync(dataDir)) {\n      fs.mkdirSync(dataDir, { recursive: true });\n    }\n    this.dataFile = path.resolve(dataDir, \'bangla_ai.json\');\n    this.data = this.loadOrSeed();\n  }\n\n  private save(): void {\n    try {\n      fs.writeFileSync(this.dataFile, JSON.stringify(this.data, null, 2), \'utf-8\');\n    } catch (err) {\n      console.error(\'Failed to save database to disk:\', err);\n    }\n  }\n\n  private loadOrSeed(): DatabaseData {\n    if (fs.existsSync(this.dataFile)) {\n      try {\n        const raw = fs.readFileSync(this.dataFile, \'utf-8\');\n        return JSON.parse(raw);\n      } catch (err) {\n        console.warn(\'Corrupted database file, reseeding initial data:\', err);\n      }\n    }\n\n    return this.createSeedData();\n  }\n\n  private createSeedData(): DatabaseData {\n    const now = new Date().toISOString();\n    const futureMonthly = calculateExpiryDate(\'monthly\').toISOString();\n    const futureYearly = calculateExpiryDate(\'yearly\').toISOString();\n\n    const adminId = \'usr_admin_001\';\n    const subscriberId = \'usr_sub_002\';\n    const unpaidId = \'usr_unpaid_003\';\n\n    const users: User[] = [\n      {\n        id: adminId,\n        email: \'admin@bangla.ai\',\n        password_hash: hashPassword(\'AdminPassword123!\'),\n        name: \'\340\246\270\340\247\201\340\246\252\340\246\276\340\246\260 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\246\256\340\246\277\340\246\250 (Admin)\',\n        phone: \'+8801711000000\',\n        role: \'admin\',\n        status: \'active\',\n        usage_limit: 1000000,\n        current_usage: 1240,\n        created_at: now,\n        updated_at: now\n      },\n      {\n        id: subscriberId,\n        email: \'subscriber@bangla.ai\',\n        password_hash: hashPassword(\'UserPassword123!\'),\n        name: \'\340\246\244\340\246\276\340\246\250\340\246\255\340\247\200\340\246\260 \340\246\206\340\246\271\340\246\256\340\247\207\340\246\246\',\n        phone: \'+8801812345678\',\n        role: \'user\',\n        status: \'active\',\n        usage_limit: 50000,\n        current_usage: 4850,\n        created_at: now,\n        updated_at: now\n      },\n      {\n        id: unpaidId,\n        email: \'unpaid@bangla.ai\',\n        password_hash: hashPassword(\'UserPassword123!\'),\n        name: \'\340\246\260\340\246\276\340\246\225\340\246\277\340\246\254\340\247\201\340\246\262 \340\246\271\340\246\276\340\246\270\340\246\276\340\246\250\',\n        phone: \'+8801911223344\',\n        role: \'user\',\n        status: \'active\',\n        usage_limit: 50000,\n        current_usage: 0,\n        created_at: now,\n        updated_at: now\n      }\n    ];\n\n    const subscriptions: Subscription[] = [\n      {\n        id: \'sub_admin_001\',\n        user_id: adminId,\n        plan_id: \'yearly\',\n        plan_name: \'\340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\246\256\340\246\277\340\246\250 \340\246\252\340\247\215\340\246\260\340\246\277\340\246\256\340\246\277\340\246\257\340\246\274\340\246\276\340\246\256 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250\',\n        amount: 9999,\n        currency: \'BDT\',\n        status: \'active\',\n        started_at: now,\n        expires_at: futureYearly,\n        auto_renew: true,\n        payment_method: \'system\',\n        trx_id: \'SYS_ADMIN_LIFETIME\',\n        created_at: now,\n        updated_at: now\n      },\n      {\n        id: \'sub_user_002\',\n        user_id: subscriberId,\n        plan_id: \'monthly\',\n        plan_name: \'\340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 (\340\247\263\340\247\247,\340\247\250\340\247\257\340\247\257)\',\n        amount: 1299,\n        currency: \'BDT\',\n        status: \'active\',\n        started_at: now,\n        expires_at: futureMonthly,\n        auto_renew: true,\n        payment_method: \'bkash\',\n        trx_id: \'BKB8792019X\',\n        created_at: now,\n        updated_at: now\n      }\n    ];\n\n    const payments: Payment[] = [\n      {\n        id: \'pay_001\',\n        user_id: subscriberId,\n        subscription_id: \'sub_user_002\',\n        amount: 1299,\n        currency: \'BDT\',\n        gateway: \'bkash\',\n        trx_id: \'BKB8792019X\',\n        sender_number: \'01812345678\',\n        status: \'completed\',\n        created_at: now\n      }\n    ];\n\n    const ai_providers: AiProvider[] = [\n      {\n        id: \'prov_gemini\',\n        name: \'Google Gemini\',\n        slug: \'gemini\',\n        api_key: process.env.GEMINI_API_KEY || \'\',\n        base_url: \'https://generativelanguage.googleapis.com\',\n        is_active: true,\n        created_at: now,\n        updated_at: now\n      },\n      {\n        id: \'prov_openai\',\n        name: \'OpenAI\',\n        slug: \'openai\',\n        api_key: process.env.OPENAI_API_KEY || \'\',\n        base_url: \'https://api.openai.com/v1\',\n        is_active: true,\n        created_at: now,\n        updated_at: now\n      },\n      {\n        id: \'prov_anthropic\',\n        name: \'Anthropic Claude\',\n        slug: \'anthropic\',\n        api_key: process.env.ANTHROPIC_API_KEY || \'\',\n        base_url: \'https://api.anthropic.com/v1\',\n        is_active: true,\n        created_at: now,\n        updated_at: now\n      },\n      {\n        id: \'prov_deepseek\',\n        name: \'DeepSeek AI\',\n        slug: \'deepseek\',\n        api_key: process.env.DEEPSEEK_API_KEY || \'\',\n        base_url: \'https://api.deepseek.com/v1\',\n        is_active: true,\n        created_at: now,\n        updated_at: now\n      }\n    ];\n\n    const ai_models: AiModel[] = [\n      {\n        id: \'mod_gemini_2_5_flash\',\n        provider_id: \'prov_gemini\',\n        model_name: \'gemini-2.5-flash\',\n        display_name: \'Gemini 2.5 Flash\',\n        description_bn: \'\340\246\270\340\247\201\340\246\252\340\246\276\340\246\260\340\246\253\340\246\276\340\246\270\340\247\215\340\246\237 \340\246\227\340\246\244\340\246\277 \340\246\223 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\255\340\247\201\340\246\262 \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\260\340\247\207\340\246\270\340\246\252\340\246\250\340\247\215\340\246\270\340\245\244 \340\246\246\340\247\210\340\246\250\340\246\250\340\247\215\340\246\246\340\246\277\340\246\250 \340\246\262\340\247\207\340\246\226\340\246\276\340\246\262\340\247\207\340\246\226\340\246\277 \340\246\223 \340\246\246\340\247\215\340\246\260\340\247\201\340\246\244 \340\246\205\340\246\250\340\247\201\340\246\270\340\246\250\340\247\215\340\246\247\340\246\276\340\246\250\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\270\340\247\207\340\246\260\340\246\276\340\245\244\',\n        badge: \'super_fast\',\n        is_enabled: true,\n        is_default: true,\n        context_window: 1000000,\n        max_output_tokens: 8192,\n        sort_order: 1,\n        created_at: now\n      },\n      {\n        id: \'mod_gpt_4o\',\n        provider_id: \'prov_openai\',\n        model_name: \'gpt-4o\',\n        display_name: \'OpenAI GPT-4o\',\n        description_bn: \'\340\246\223\340\246\252\340\247\207\340\246\250\340\246\217\340\246\206\340\246\207-\340\246\217\340\246\260 \340\246\253\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\227\340\246\266\340\246\277\340\246\252 \340\246\256\340\246\276\340\246\262\340\247\215\340\246\237\340\246\277\340\246\256\340\247\213\340\246\241\340\246\276\340\246\262 \340\246\256\340\246\241\340\247\207\340\246\262\340\245\244 \340\246\225\340\247\213\340\246\241\340\246\277\340\246\202, \340\246\234\340\246\237\340\246\277\340\246\262 \340\246\254\340\246\277\340\246\266\340\247\215\340\246\262\340\247\207\340\246\267\340\246\243 \340\246\217\340\246\254\340\246\202 \340\246\270\340\247\203\340\246\234\340\246\250\340\246\266\340\247\200\340\246\262 \340\246\225\340\246\250\340\246\237\340\247\207\340\246\250\340\247\215\340\246\237\340\247\207 \340\246\205\340\246\252\340\247\215\340\246\260\340\246\244\340\246\277\340\246\246\340\247\215\340\246\254\340\246\250\340\247\215\340\246\246\340\247\215\340\246\254\340\247\200\340\245\244\',\n        badge: \'balanced\',\n        is_enabled: true,\n        is_default: false,\n        context_window: 128000,\n        max_output_tokens: 4096,\n        sort_order: 2,\n        created_at: now\n      },\n      {\n        id: \'mod_claude_3_5_sonnet\',\n        provider_id: \'prov_anthropic\',\n        model_name: \'claude-3-5-sonnet\',\n        display_name: \'Claude 3.5 Sonnet\',\n        description_bn: \'\340\246\205\340\247\215\340\246\257\340\246\276\340\246\250\340\246\245\340\247\215\340\246\260\340\246\252\340\246\277\340\246\225\340\247\207\340\246\260 \340\246\266\340\247\200\340\246\260\340\247\215\340\246\267 \340\246\225\340\247\213\340\246\241\340\246\277\340\246\202 \340\246\223 \340\246\257\340\247\201\340\246\225\340\247\215\340\246\244\340\246\277\340\246\250\340\246\277\340\246\260\340\247\215\340\246\255\340\246\260 \340\246\256\340\246\241\340\247\207\340\246\262\340\245\244 \340\246\270\340\246\276\340\246\254\340\246\262\340\247\200\340\246\262 \340\246\227\340\246\246\340\247\215\340\246\257 \340\246\223 \340\246\227\340\246\255\340\247\200\340\246\260 \340\246\254\340\246\277\340\246\266\340\247\215\340\246\262\340\247\207\340\246\267\340\246\243\340\247\207 \340\246\252\340\246\276\340\246\260\340\246\246\340\246\260\340\247\215\340\246\266\340\247\200\340\245\244\',\n        badge: \'coding\',\n        is_enabled: true,\n        is_default: false,\n        context_window: 200000,\n        max_output_tokens: 8192,\n        sort_order: 3,\n        created_at: now\n      },\n      {\n        id: \'mod_deepseek_r1\',\n        provider_id: \'prov_deepseek\',\n        model_name: \'deepseek-r1\',\n        display_name: \'DeepSeek R1 (Reasoning)\',\n        description_bn: \'\340\246\223\340\246\252\340\247\207\340\246\250 \340\246\270\340\247\213\340\246\260\340\247\215\340\246\270 \340\246\257\340\247\201\340\246\225\340\247\215\340\246\244\340\246\277\340\246\266\340\246\225\340\247\215\340\246\244\340\246\277 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\256\340\247\215\340\246\252\340\246\277\340\246\257\340\246\274\340\246\250\340\245\244 \340\246\227\340\246\243\340\246\277\340\246\244, \340\246\205\340\247\215\340\246\257\340\246\276\340\246\262\340\246\227\340\246\260\340\246\277\340\246\246\340\246\256 \340\246\223 \340\246\247\340\246\276\340\246\252\340\247\207 \340\246\247\340\246\276\340\246\252\340\247\207 \340\246\232\340\246\277\340\246\250\340\247\215\340\246\244\340\246\276 \340\246\252\340\247\215\340\246\260\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274\340\246\276\340\246\257\340\246\274 \340\246\270\340\247\207\340\246\260\340\246\276\340\245\244\',\n        badge: \'reasoning\',\n        is_enabled: true,\n        is_default: false,\n        context_window: 64000,\n        max_output_tokens: 4096,\n        sort_order: 4,\n        created_at: now\n      }\n    ];\n\n    const demoChatId = \'chat_demo_001\';\n    const chats: Chat[] = [\n      {\n        id: demoChatId,\n        user_id: subscriberId,\n        title: \'\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\247\237 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\246\276\340\246\260 \340\246\252\340\246\260\340\246\277\340\246\225\340\246\262\340\247\215\340\246\252\340\246\250\340\246\276 \340\246\223 \340\246\241\340\246\277\340\246\234\340\246\277\340\246\237\340\246\276\340\246\262 \340\246\256\340\246\276\340\246\260\340\247\215\340\246\225\340\247\207\340\246\237\340\246\277\340\246\202\',\n        model_id: \'mod_gemini_2_5_flash\',\n        pinned: true,\n        created_at: now,\n        updated_at: now\n      }\n    ];\n\n    const messages: Message[] = [\n      {\n        id: \'msg_001\',\n        chat_id: demoChatId,\n        role: \'user\',\n        content: \'\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266\340\247\207 \340\246\217\340\246\225\340\246\237\340\246\277 \340\246\207-\340\246\225\340\246\256\340\246\276\340\246\260\340\247\215\340\246\270 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\246\276 \340\246\266\340\247\201\340\246\260\340\247\201 \340\246\225\340\246\260\340\246\276\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\252\340\247\215\340\246\260\340\246\276\340\246\245\340\246\256\340\246\277\340\246\225 \340\246\225\340\246\277 \340\246\225\340\246\277 \340\246\254\340\246\277\340\246\267\340\246\257\340\246\274 \340\246\256\340\246\276\340\246\245\340\246\276\340\246\257\340\246\274 \340\246\260\340\246\276\340\246\226\340\246\276 \340\246\246\340\246\260\340\246\225\340\246\276\340\246\260?\',\n        model_id: \'mod_gemini_2_5_flash\',\n        tokens_used: 120,\n        created_at: now\n      },\n      {\n        id: \'msg_002\',\n        chat_id: demoChatId,\n        role: \'assistant\',\n        content: `\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266\340\247\207 \340\246\217\340\246\225\340\246\237\340\246\277 \340\246\270\340\246\253\340\246\262 \340\246\207-\340\246\225\340\246\256\340\246\276\340\246\260\340\247\215\340\246\270 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\246\276 \340\246\266\340\247\201\340\246\260\340\247\201 \340\246\225\340\246\260\340\246\276\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\252\340\247\215\340\246\260\340\246\247\340\246\276\340\246\250 \340\246\247\340\246\276\340\246\252\340\246\270\340\246\256\340\247\202\340\246\271 \340\246\250\340\246\277\340\246\256\340\247\215\340\246\250\340\246\260\340\247\202\340\246\252:\n\n1. **\340\246\206\340\246\207\340\246\250\340\246\277 \340\246\252\340\247\215\340\246\260\340\246\270\340\247\215\340\246\244\340\247\201\340\246\244\340\246\277 \340\246\223 \340\246\205\340\246\250\340\247\201\340\246\256\340\247\213\340\246\246\340\246\250:**\n   - \340\246\237\340\247\215\340\246\260\340\247\207\340\246\241 \340\246\262\340\246\276\340\246\207\340\246\270\340\247\207\340\246\250\340\247\215\340\246\270 (\340\246\270\340\247\215\340\246\245\340\246\276\340\246\250\340\247\200\340\246\257\340\246\274 \340\246\270\340\246\277\340\246\237\340\246\277 \340\246\225\340\246\260\340\247\215\340\246\252\340\247\213\340\246\260\340\247\207\340\246\266\340\246\250/\340\246\207\340\246\211\340\246\250\340\246\277\340\246\257\340\246\274\340\246\250 \340\246\252\340\246\260\340\246\277\340\246\267\340\246\246 \340\246\245\340\247\207\340\246\225\340\247\207)\n   - \340\246\207-\340\246\237\340\246\277\340\246\206\340\246\207\340\246\217\340\246\250 (TIN) \340\246\270\340\246\276\340\246\260\340\247\215\340\246\237\340\246\277\340\246\253\340\246\277\340\246\225\340\247\207\340\246\237\n   - \340\246\255\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\260\340\247\207\340\246\234\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\247\207\340\246\266\340\246\250 (BIN)\n   - \340\246\207-\340\246\225\340\247\215\340\246\257\340\246\276\340\246\254 (e-CAB) \340\246\270\340\246\246\340\246\270\340\247\215\340\246\257\340\246\252\340\246\246 \340\246\223 \340\246\241\340\246\277\340\246\254\340\246\277\340\246\206\340\246\207\340\246\241\340\246\277 (DBID)\n\n2. **\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\227\340\247\207\340\246\237\340\246\223\340\246\257\340\246\274\340\247\207 \340\246\207\340\246\250\340\247\215\340\246\237\340\246\277\340\246\227\340\247\215\340\246\260\340\247\207\340\246\266\340\246\250:**\n   - \340\246\254\340\246\277\340\246\225\340\246\276\340\246\266 (bKash) \340\246\223 \340\246\250\340\246\227\340\246\246 (Nagad) \340\246\256\340\246\276\340\246\260\340\247\215\340\246\232\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237\n   - \340\246\255\340\246\277\340\246\270\340\246\276/\340\246\256\340\246\276\340\246\270\340\247\215\340\246\237\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\215\340\246\241\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 SSLCommerz \340\246\254\340\246\276 Shurjopay \340\246\227\340\247\207\340\246\237\340\246\223\340\246\257\340\246\274\340\247\207\n\n3. **\340\246\262\340\246\234\340\246\277\340\246\270\340\247\215\340\246\237\340\246\277\340\246\225\340\246\270 \340\246\223 \340\246\241\340\247\207\340\246\262\340\246\277\340\246\255\340\246\276\340\246\260\340\246\277 \340\246\252\340\246\276\340\246\260\340\247\215\340\246\237\340\246\250\340\246\276\340\246\260:**\n   - \340\246\252\340\246\276\340\246\240\340\246\276\340\246\223 \340\246\225\340\247\201\340\246\260\340\246\277\340\246\257\340\246\274\340\246\276\340\246\260, \340\246\260\340\247\207\340\246\241\340\246\217\340\246\225\340\247\215\340\246\270, \340\246\205\340\246\245\340\246\254\340\246\276 \340\246\270\340\247\215\340\246\237\340\246\277\340\246\241\340\246\253\340\246\276\340\246\270\340\247\215\340\246\237 \340\246\225\340\247\201\340\246\260\340\246\277\340\246\257\340\246\274\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\270\340\246\276\340\246\245\340\247\207 \340\246\232\340\247\201\340\246\225\340\247\215\340\246\244\340\246\277\n\n\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\246\276\340\246\257\340\246\274\340\246\277\340\246\225 \340\246\252\340\246\243\340\247\215\340\246\257 \340\246\254\340\246\276 \340\246\270\340\247\207\340\246\254\340\246\276\340\246\260 \340\246\225\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\227\340\246\260\340\246\277 \340\246\234\340\246\276\340\246\250\340\246\276\340\246\262\340\247\207 \340\246\206\340\246\260\340\246\223 \340\246\254\340\246\277\340\246\270\340\247\215\340\246\244\340\246\276\340\246\260\340\246\277\340\246\244 \340\246\225\340\247\214\340\246\266\340\246\262 \340\246\244\340\247\210\340\246\260\340\246\277 \340\246\225\340\246\260\340\247\207 \340\246\246\340\246\277\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\260\340\246\277!`,\n        model_id: \'mod_gemini_2_5_flash\',\n        tokens_used: 350,\n        created_at: now\n      }\n    ];\n\n    const usage_records: UsageRecord[] = [\n      {\n        id: \'usg_001\',\n        user_id: subscriberId,\n        chat_id: demoChatId,\n        model_id: \'mod_gemini_2_5_flash\',\n        prompt_tokens: 120,\n        completion_tokens: 350,\n        total_tokens: 470,\n        created_at: now\n      }\n    ];\n\n    const settings: SystemSettings = {\n      global_usage_limit: 50000,\n      default_monthly_price: 1299,\n      default_yearly_price: 9999,\n      support_email: \'support@bangla.ai\',\n      support_phone: \'+880 9612-000000\',\n      announcement_bn: \'\340\246\270\340\247\215\340\246\254\340\246\276\340\246\227\340\246\244\340\246\256 \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\217\340\246\206\340\246\207-\340\246\244\340\247\207! \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266\340\247\207\340\246\260 \340\246\270\340\247\207\340\246\260\340\246\276 \340\246\225\340\247\203\340\246\244\340\247\215\340\246\260\340\246\277\340\246\256 \340\246\254\340\247\201\340\246\246\340\247\215\340\246\247\340\246\277\340\246\256\340\246\244\340\247\215\340\246\244\340\246\276 \340\246\271\340\246\276\340\246\254\340\245\244\'\n    };\n\n    const initialData: DatabaseData = {\n      users,\n      subscriptions,\n      payments,\n      chats,\n      messages,\n      ai_providers,\n      ai_models,\n      usage_records,\n      settings\n    };\n\n    fs.writeFileSync(this.dataFile, JSON.stringify(initialData, null, 2), \'utf-8\');\n    return initialData;\n  }\n\n  // --- User Operations ---\n  public getUserByEmail(email: string): User | undefined {\n    return this.data.users.find(u => u.email.toLowerCase() === email.toLowerCase());\n  }\n\n  public getUserById(id: string): User | undefined {\n    return this.data.users.find(u => u.id === id);\n  }\n\n  public createUser(userData: {\n    email: string;\n    password: string;\n    name: string;\n    phone?: string;\n    role?: \'user\' | \'admin\';\n  }): User {\n    const now = new Date().toISOString();\n    const newUser: User = {\n      id: `usr_${crypto.randomUUID().slice(0, 8)}`,\n      email: userData.email.toLowerCase(),\n      password_hash: hashPassword(userData.password),\n      name: userData.name,\n      phone: userData.phone || \'\',\n      role: userData.role || \'user\',\n      status: \'active\',\n      usage_limit: this.data.settings.global_usage_limit || 50000,\n      current_usage: 0,\n      created_at: now,\n      updated_at: now\n    };\n    this.data.users.push(newUser);\n    this.save();\n    return newUser;\n  }\n\n  public updateUser(id: string, updates: Partial<User>): User | undefined {\n    const user = this.getUserById(id);\n    if (!user) return undefined;\n\n    Object.assign(user, updates, { updated_at: new Date().toISOString() });\n    this.save();\n    return user;\n  }\n\n  public deleteUser(id: string): boolean {\n    const initialLen = this.data.users.length;\n    this.data.users = this.data.users.filter(u => u.id !== id);\n    this.data.subscriptions = this.data.subscriptions.filter(s => s.user_id !== id);\n    this.data.chats = this.data.chats.filter(c => c.user_id !== id);\n    this.save();\n    return this.data.users.length < initialLen;\n  }\n\n  public listUsers(search?: string, role?: string, status?: string): User[] {\n    return this.data.users.filter(u => {\n      if (role && u.role !== role) return false;\n      if (status && u.status !== status) return false;\n      if (search) {\n        const q = search.toLowerCase();\n        return u.name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q) || u.phone.includes(q);\n      }\n      return true;\n    });\n  }\n\n  // --- Subscriptions ---\n  public getSubscriptionByUserId(userId: string): Subscription | undefined {\n    return this.data.subscriptions\n      .filter(s => s.user_id === userId)\n      .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())[0];\n  }\n\n  public createOrRenewSubscription(params: {\n    userId: string;\n    planId: \'monthly\' | \'yearly\';\n    paymentMethod: string;\n    trxId: string;\n    senderNumber?: string;\n  }): { subscription: Subscription; payment: Payment } {\n    const plan = PLANS[params.planId];\n    const user = this.getUserById(params.userId);\n    const existing = this.getSubscriptionByUserId(params.userId);\n\n    const now = new Date().toISOString();\n    const expiresAt = calculateExpiryDate(\n      params.planId,\n      existing && existing.status === \'active\' ? existing.expires_at : null\n    ).toISOString();\n\n    const subId = `sub_${crypto.randomUUID().slice(0, 8)}`;\n    const newSub: Subscription = {\n      id: subId,\n      user_id: params.userId,\n      plan_id: params.planId,\n      plan_name: plan.nameBn,\n      amount: plan.priceBDT,\n      currency: \'BDT\',\n      status: \'active\',\n      started_at: now,\n      expires_at: expiresAt,\n      auto_renew: true,\n      payment_method: params.paymentMethod,\n      trx_id: params.trxId,\n      created_at: now,\n      updated_at: now\n    };\n\n    // Replace or add subscription\n    this.data.subscriptions = this.data.subscriptions.filter(s => s.user_id !== params.userId);\n    this.data.subscriptions.push(newSub);\n\n    // Create payment entry\n    const paymentId = `pay_${crypto.randomUUID().slice(0, 8)}`;\n    const newPayment: Payment = {\n      id: paymentId,\n      user_id: params.userId,\n      subscription_id: subId,\n      amount: plan.priceBDT,\n      currency: \'BDT\',\n      gateway: params.paymentMethod as any,\n      trx_id: params.trxId,\n      sender_number: params.senderNumber || user?.phone || \'\',\n      status: \'completed\',\n      created_at: now\n    };\n    this.data.payments.push(newPayment);\n\n    // Reset current usage on new subscription\n    if (user) {\n      user.current_usage = 0;\n      // Bonus limit for yearly plan\n      if (params.planId === \'yearly\') {\n        user.usage_limit = 750000;\n      } else {\n        user.usage_limit = 50000;\n      }\n    }\n\n    this.save();\n    return { subscription: newSub, payment: newPayment };\n  }\n\n  public updateSubscription(id: string, updates: Partial<Subscription>): Subscription | undefined {\n    const sub = this.data.subscriptions.find(s => s.id === id);\n    if (!sub) return undefined;\n    Object.assign(sub, updates, { updated_at: new Date().toISOString() });\n    this.save();\n    return sub;\n  }\n\n  public listPayments(userId?: string): Payment[] {\n    if (userId) {\n      return this.data.payments.filter(p => p.user_id === userId);\n    }\n    return this.data.payments;\n  }\n\n  // --- Chats & Messages ---\n  public listChats(userId: string): Chat[] {\n    return this.data.chats\n      .filter(c => c.user_id === userId)\n      .sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());\n  }\n\n  public getChat(id: string, userId: string): Chat | undefined {\n    return this.data.chats.find(c => c.id === id && c.user_id === userId);\n  }\n\n  public createChat(userId: string, title: string, modelId: string): Chat {\n    const now = new Date().toISOString();\n    const chat: Chat = {\n      id: `chat_${crypto.randomUUID().slice(0, 8)}`,\n      user_id: userId,\n      title: title || \'\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237\',\n      model_id: modelId,\n      pinned: false,\n      created_at: now,\n      updated_at: now\n    };\n    this.data.chats.unshift(chat);\n    this.save();\n    return chat;\n  }\n\n  public updateChat(id: string, userId: string, updates: Partial<Chat>): Chat | undefined {\n    const chat = this.getChat(id, userId);\n    if (!chat) return undefined;\n    Object.assign(chat, updates, { updated_at: new Date().toISOString() });\n    this.save();\n    return chat;\n  }\n\n  public deleteChat(id: string, userId: string): boolean {\n    const chat = this.getChat(id, userId);\n    if (!chat) return false;\n    this.data.chats = this.data.chats.filter(c => c.id !== id);\n    this.data.messages = this.data.messages.filter(m => m.chat_id !== id);\n    this.save();\n    return true;\n  }\n\n  public getMessages(chatId: string): Message[] {\n    return this.data.messages\n      .filter(m => m.chat_id === chatId)\n      .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime());\n  }\n\n  public addMessage(chatId: string, role: \'user\' | \'assistant\' | \'system\', content: string, modelId: string, tokensUsed: number = 0): Message {\n    const now = new Date().toISOString();\n    const msg: Message = {\n      id: `msg_${crypto.randomUUID().slice(0, 8)}`,\n      chat_id: chatId,\n      role,\n      content,\n      model_id: modelId,\n      tokens_used: tokensUsed,\n      created_at: now\n    };\n    this.data.messages.push(msg);\n\n    // Update chat updated_at\n    const chat = this.data.chats.find(c => c.id === chatId);\n    if (chat) {\n      chat.updated_at = now;\n      if (chat.title === \'\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237\' && role === \'user\') {\n        chat.title = content.slice(0, 40) + (content.length > 40 ? \'...\' : \'\');\n      }\n    }\n\n    this.save();\n    return msg;\n  }\n\n  // --- AI Providers & Models ---\n  public listProviders(): AiProvider[] {\n    return this.data.ai_providers;\n  }\n\n  public getProviderById(id: string): AiProvider | undefined {\n    return this.data.ai_providers.find(p => p.id === id);\n  }\n\n  public updateProvider(id: string, updates: Partial<AiProvider>): AiProvider | undefined {\n    const provider = this.getProviderById(id);\n    if (!provider) return undefined;\n    Object.assign(provider, updates, { updated_at: new Date().toISOString() });\n    this.save();\n    return provider;\n  }\n\n  public listModels(enabledOnly: boolean = false): AiModel[] {\n    let models = this.data.ai_models;\n    if (enabledOnly) {\n      models = models.filter(m => m.is_enabled);\n    }\n    return models.sort((a, b) => a.sort_order - b.sort_order);\n  }\n\n  public getModelById(id: string): AiModel | undefined {\n    return this.data.ai_models.find(m => m.id === id);\n  }\n\n  public updateModel(id: string, updates: Partial<AiModel>): AiModel | undefined {\n    const model = this.getModelById(id);\n    if (!model) return undefined;\n    Object.assign(model, updates);\n    this.save();\n    return model;\n  }\n\n  // --- Usage Tracking ---\n  public recordUsage(userId: string, chatId: string | undefined, modelId: string, promptTokens: number, completionTokens: number): UsageRecord {\n    const now = new Date().toISOString();\n    const totalTokens = promptTokens + completionTokens;\n    const record: UsageRecord = {\n      id: `usg_${crypto.randomUUID().slice(0, 8)}`,\n      user_id: userId,\n      chat_id: chatId,\n      model_id: modelId,\n      prompt_tokens: promptTokens,\n      completion_tokens: completionTokens,\n      total_tokens: totalTokens,\n      created_at: now\n    };\n    this.data.usage_records.push(record);\n\n    // Increment user\'s current usage\n    const user = this.getUserById(userId);\n    if (user) {\n      user.current_usage = (user.current_usage || 0) + totalTokens;\n      user.updated_at = now;\n    }\n\n    this.save();\n    return record;\n  }\n\n  // --- Settings & Admin Stats ---\n  public getSettings(): SystemSettings {\n    return this.data.settings;\n  }\n\n  public updateSettings(updates: Partial<SystemSettings>): SystemSettings {\n    Object.assign(this.data.settings, updates);\n    this.save();\n    return this.data.settings;\n  }\n\n  public getAdminStats() {\n    const totalUsers = this.data.users.length;\n    const now = Date.now();\n    const activeSubscribers = this.data.subscriptions.filter(s => s.status === \'active\' && new Date(s.expires_at).getTime() > now).length;\n    const totalRevenue = this.data.payments.filter(p => p.status === \'completed\').reduce((sum, p) => sum + p.amount, 0);\n    const totalTokensUsed = this.data.usage_records.reduce((sum, r) => sum + r.total_tokens, 0);\n\n    const modelUsageMap: Record<string, number> = {};\n    for (const r of this.data.usage_records) {\n      modelUsageMap[r.model_id] = (modelUsageMap[r.model_id] || 0) + r.total_tokens;\n    }\n\n    return {\n      totalUsers,\n      activeSubscribers,\n      totalRevenue,\n      totalTokensUsed,\n      modelUsageMap,\n      totalChats: this.data.chats.length,\n      totalMessages: this.data.messages.length\n    };\n  }\n}\n\nexport const db = new Database();\n"
