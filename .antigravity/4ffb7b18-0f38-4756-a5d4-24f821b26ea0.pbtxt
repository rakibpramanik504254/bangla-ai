  code_action {
    action_spec {
      create_file {
        instruction: "import express, { Request, Response } from \'express\';\nimport path from \'node:path\';\nimport dotenv from \'dotenv\';\nimport { db, User } from \'./src/db/database.ts\';\nimport { authenticate, requireAdmin, generateToken, AuthenticatedRequest } from \'./src/server/auth.ts\';\nimport { AiService } from \'./src/server/ai-service.ts\';\nimport { isSubscriptionActive, calculateUsageStats, PLANS } from \'./src/utils/billing.ts\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = process.env.PORT || 3000;\n\napp.use(express.json());\n\n// Request logger for API calls\napp.use((req, res, next) => {\n  if (req.path.startsWith(\'/api\')) {\n    console.log(`[API] ${req.method} ${req.path}`);\n  }\n  next();\n});\n\n// ==========================================\n// 1. Authentication Endpoints\n// ==========================================\n\napp.post(\'/api/auth/register\', (req: Request, res: Response) => {\n  try {\n    const { email, password, name, phone } = req.body;\n    if (!email || !password || !name) {\n      res.status(400).json({ error: \'\340\246\250\340\246\276\340\246\256, \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\217\340\246\254\340\246\202 \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\206\340\246\254\340\246\266\340\247\215\340\246\257\340\246\225\340\245\244\' });\n      return;\n    }\n\n    if (password.length < 6) {\n      res.status(400).json({ error: \'\340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\250\340\247\215\340\246\257\340\247\202\340\246\250\340\246\244\340\246\256 \340\247\254 \340\246\205\340\246\225\340\247\215\340\246\267\340\246\260\340\247\207\340\246\260 \340\246\271\340\246\244\340\247\207 \340\246\271\340\246\254\340\247\207\340\245\244\' });\n      return;\n    }\n\n    const existing = db.getUserByEmail(email);\n    if (existing) {\n      res.status(400).json({ error: \'\340\246\217\340\246\207 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\246\340\246\277\340\246\257\340\246\274\340\247\207 \340\246\207\340\246\244\340\246\277\340\246\256\340\246\247\340\247\215\340\246\257\340\247\207 \340\246\217\340\246\225\340\246\237\340\246\277 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237 \340\246\260\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\' });\n      return;\n    }\n\n    const newUser = db.createUser({\n      email,\n      password,\n      name,\n      phone: phone || \'\',\n      role: \'user\'\n    });\n\n    const token = generateToken(newUser);\n    const sub = db.getSubscriptionByUserId(newUser.id);\n\n    res.status(201).json({\n      token,\n      user: {\n        id: newUser.id,\n        email: newUser.email,\n        name: newUser.name,\n        phone: newUser.phone,\n        role: newUser.role,\n        usage_limit: newUser.usage_limit,\n        current_usage: newUser.current_usage,\n        subscription: sub || null,\n        isSubscribed: isSubscriptionActive(sub)\n      }\n    });\n  } catch (err: any) {\n    res.status(500).json({ error: \'\340\246\260\340\247\207\340\246\234\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\247\207\340\246\266\340\246\250 \340\246\254\340\247\215\340\246\257\340\246\260\340\247\215\340\246\245 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207: \' + err.message });\n  }\n});\n\napp.post(\'/api/auth/login\', (req: Request, res: Response) => {\n  try {\n    const { email, password } = req.body;\n    if (!email || !password) {\n      res.status(400).json({ error: \'\340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\217\340\246\254\340\246\202 \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\252\340\247\215\340\246\260\340\246\246\340\246\276\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\' });\n      return;\n    }\n\n    const user = db.getUserByEmail(email);\n    if (!user) {\n      res.status(401).json({ error: \'\340\246\255\340\247\201\340\246\262 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\254\340\246\276 \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241\340\245\244\' });\n      return;\n    }\n\n    if (user.status === \'suspended\') {\n      res.status(403).json({ error: \'\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237\340\246\237\340\246\277 \340\246\270\340\247\215\340\246\245\340\246\227\340\246\277\340\246\244 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244 \340\246\270\340\246\276\340\246\252\340\247\213\340\246\260\340\247\215\340\246\237\340\247\207 \340\246\257\340\247\213\340\246\227\340\246\276\340\246\257\340\247\213\340\246\227 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\' });\n      return;\n    }\n\n    const { verifyPassword } = require(\'./src/db/database.ts\');\n    if (!verifyPassword(password, user.password_hash)) {\n      res.status(401).json({ error: \'\340\246\255\340\247\201\340\246\262 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\254\340\246\276 \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241\340\245\244\' });\n      return;\n    }\n\n    const token = generateToken(user);\n    const sub = db.getSubscriptionByUserId(user.id);\n\n    res.json({\n      token,\n      user: {\n        id: user.id,\n        email: user.email,\n        name: user.name,\n        phone: user.phone,\n        role: user.role,\n        usage_limit: user.usage_limit,\n        current_usage: user.current_usage,\n        subscription: sub || null,\n        isSubscribed: user.role === \'admin\' || isSubscriptionActive(sub)\n      }\n    });\n  } catch (err: any) {\n    res.status(500).json({ error: \'\340\246\262\340\246\227\340\246\207\340\246\250 \340\246\244\340\247\215\340\246\260\340\247\201\340\246\237\340\246\277: \' + err.message });\n  }\n});\n\napp.get(\'/api/auth/me\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const user = req.user!;\n  const sub = db.getSubscriptionByUserId(user.id);\n  const usageStats = calculateUsageStats(user.usage_limit || 50000, user.current_usage || 0);\n\n  res.json({\n    id: user.id,\n    email: user.email,\n    name: user.name,\n    phone: user.phone,\n    role: user.role,\n    usage: usageStats,\n    subscription: sub || null,\n    isSubscribed: user.role === \'admin\' || isSubscriptionActive(sub)\n  });\n});\n\napp.post(\'/api/auth/forgot-password\', (req: Request, res: Response) => {\n  const { email } = req.body;\n  if (!email) {\n    res.status(400).json({ error: \'\340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\206\340\246\254\340\246\266\340\247\215\340\246\257\340\246\225\' });\n    return;\n  }\n  const user = db.getUserByEmail(email);\n  if (!user) {\n    // For privacy, don\'t expose user existence\n    res.json({ message: \'\340\246\257\340\246\246\340\246\277 \340\246\217\340\246\207 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262\340\246\237\340\246\277 \340\246\206\340\246\256\340\246\276\340\246\246\340\247\207\340\246\260 \340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256\340\247\207 \340\246\250\340\246\277\340\246\254\340\246\250\340\247\215\340\246\247\340\246\277\340\246\244 \340\246\245\340\246\276\340\246\225\340\247\207, \340\246\244\340\246\254\340\247\207 \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\260\340\246\277\340\246\270\340\247\207\340\246\237 \340\246\262\340\246\277\340\246\231\340\247\215\340\246\225 \340\246\252\340\246\276\340\246\240\340\246\276\340\246\250\340\247\213 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\' });\n    return;\n  }\n\n  const resetToken = \'RESET-\' + Math.floor(100000 + Math.random() * 900000);\n  db.updateUser(user.id, {\n    reset_token: resetToken,\n    reset_token_expires_at: new Date(Date.now() + 15 * 60 * 1000).toISOString()\n  });\n\n  res.json({\n    message: \'\340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\260\340\246\277\340\246\270\340\247\207\340\246\237 \340\246\223\340\246\237\340\246\277\340\246\252\340\246\277 (OTP) \340\246\244\340\247\210\340\246\260\340\246\277 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\',\n    demoOtp: resetToken // Displayed for seamless testing in demo environment\n  });\n});\n\napp.post(\'/api/auth/reset-password\', (req: Request, res: Response) => {\n  const { email, token, newPassword } = req.body;\n  if (!email || !token || !newPassword) {\n    res.status(400).json({ error: \'\340\246\270\340\246\254 \340\246\244\340\246\245\340\247\215\340\246\257 \340\246\252\340\247\215\340\246\260\340\246\246\340\246\276\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\' });\n    return;\n  }\n  const user = db.getUserByEmail(email);\n  if (!user || user.reset_token !== token) {\n    res.status(400).json({ error: \'\340\246\205\340\246\254\340\247\210\340\246\247 \340\246\254\340\246\276 \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246\340\247\213\340\246\244\340\247\215\340\246\244\340\247\200\340\246\260\340\247\215\340\246\243 \340\246\260\340\246\277\340\246\270\340\247\207\340\246\237 \340\246\225\340\247\213\340\246\241\340\245\244\' });\n    return;\n  }\n\n  const { hashPassword } = require(\'./src/db/database.ts\');\n  db.updateUser(user.id, {\n    password_hash: hashPassword(newPassword),\n    reset_token: null,\n    reset_token_expires_at: null\n  });\n\n  res.json({ message: \'\340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\252\340\246\260\340\246\277\340\246\254\340\246\260\340\247\215\340\246\244\340\246\250 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244 \340\246\217\340\246\226\340\246\250 \340\246\250\340\246\244\340\247\201\340\246\250 \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241 \340\246\246\340\246\277\340\246\257\340\246\274\340\247\207 \340\246\262\340\246\227\340\246\207\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\' });\n});\n\n// ==========================================\n// 2. Subscription & Payment Endpoints\n// ==========================================\n\napp.get(\'/api/subscription/plans\', (_req: Request, res: Response) => {\n  res.json(PLANS);\n});\n\napp.post(\'/api/subscription/checkout\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  try {\n    const { planId, paymentMethod, trxId, senderNumber } = req.body;\n    if (!planId || !paymentMethod || !trxId) {\n      res.status(400).json({ error: \'\340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250, \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256 \340\246\217\340\246\254\340\246\202 \340\246\237\340\247\215\340\246\260\340\246\276\340\246\250\340\246\234\340\247\215\340\246\257\340\246\276\340\246\225\340\246\266\340\246\250 \340\246\206\340\246\207\340\246\241\340\246\277 (TrxID) \340\246\206\340\246\254\340\246\266\340\247\215\340\246\257\340\246\225\340\245\244\' });\n      return;\n    }\n\n    if (planId !== \'monthly\' && planId !== \'yearly\') {\n      res.status(400).json({ error: \'\340\246\205\340\246\254\340\247\210\340\246\247 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250\340\245\244\' });\n      return;\n    }\n\n    const result = db.createOrRenewSubscription({\n      userId: req.user!.id,\n      planId,\n      paymentMethod,\n      trxId: trxId.trim(),\n      senderNumber: senderNumber || req.user!.phone\n    });\n\n    res.json({\n      message: \'\340\246\205\340\246\255\340\246\277\340\246\250\340\246\250\340\247\215\340\246\246\340\246\250! \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\225\340\246\260\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\340\245\244\',\n      subscription: result.subscription,\n      payment: result.payment\n    });\n  } catch (err: any) {\n    res.status(500).json({ error: \'\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\252\340\247\215\340\246\260\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274\340\246\276\340\246\225\340\246\260\340\246\243\340\247\207 \340\246\244\340\247\215\340\246\260\340\247\201\340\246\237\340\246\277: \' + err.message });\n  }\n});\n\napp.get(\'/api/payments/history\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const payments = db.listPayments(req.user!.id);\n  res.json(payments);\n});\n\n// ==========================================\n// 3. AI Models & Public Info Endpoints\n// ==========================================\n\napp.get(\'/api/models\', (_req: Request, res: Response) => {\n  const models = db.listModels(true);\n  res.json(models);\n});\n\n// ==========================================\n// 4. Chat Endpoints\n// ==========================================\n\napp.get(\'/api/chats\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const chats = db.listChats(req.user!.id);\n  res.json(chats);\n});\n\napp.post(\'/api/chats\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const { title, modelId } = req.body;\n  const defaultModel = db.listModels(true).find(m => m.is_default) || db.listModels(true)[0];\n  const chat = db.createChat(req.user!.id, title || \'\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237\', modelId || defaultModel?.id || \'mod_gemini_2_5_flash\');\n  res.status(201).json(chat);\n});\n\napp.get(\'/api/chats/:id\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const chat = db.getChat(req.params.id, req.user!.id);\n  if (!chat) {\n    res.status(404).json({ error: \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\207 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n  const messages = db.getMessages(chat.id);\n  res.json({ chat, messages });\n});\n\napp.patch(\'/api/chats/:id\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const { title, pinned } = req.body;\n  const updated = db.updateChat(req.params.id, req.user!.id, {\n    ...(title !== undefined && { title }),\n    ...(pinned !== undefined && { pinned })\n  });\n  if (!updated) {\n    res.status(404).json({ error: \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\207 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n  res.json(updated);\n});\n\napp.delete(\'/api/chats/:id\', authenticate, (req: AuthenticatedRequest, res: Response) => {\n  const success = db.deleteChat(req.params.id, req.user!.id);\n  if (!success) {\n    res.status(404).json({ error: \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\207 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n  res.json({ success: true, message: \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\256\340\247\201\340\246\233\340\247\207 \340\246\253\340\247\207\340\246\262\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\' });\n});\n\n// Streaming Chat Completion Endpoint (SSE)\napp.post(\'/api/chat/stream\', authenticate, async (req: AuthenticatedRequest, res: Response) => {\n  const user = req.user!;\n  const { chatId, message, modelId } = req.body;\n\n  if (!message || !message.trim()) {\n    res.status(400).json({ error: \'\340\246\254\340\246\276\340\246\260\340\247\215\340\246\244\340\246\276 \340\246\226\340\246\276\340\246\262\340\246\277 \340\246\271\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\260\340\247\207 \340\246\250\340\246\276\340\245\244\' });\n    return;\n  }\n\n  // Verify chat ownership\n  let targetChat = chatId ? db.getChat(chatId, user.id) : null;\n  if (!targetChat) {\n    targetChat = db.createChat(user.id, message.slice(0, 30), modelId || \'mod_gemini_2_5_flash\');\n  }\n\n  // 1. Subscription & usage verification gating\n  const accessCheck = AiService.validateAccess(user);\n  if (!accessCheck.allowed) {\n    res.status(accessCheck.statusCode || 403).json({ error: accessCheck.reasonBn });\n    return;\n  }\n\n  // Resolve model & provider\n  const selectedModelId = modelId || targetChat.model_id || \'mod_gemini_2_5_flash\';\n  const model = db.getModelById(selectedModelId) || db.listModels(true)[0];\n  const provider = db.getProviderById(model.provider_id) || db.listProviders()[0];\n\n  // Save user message to database\n  const userMsg = db.addMessage(targetChat.id, \'user\', message.trim(), model.id);\n\n  // Set SSE Headers\n  res.setHeader(\'Content-Type\', \'text/event-stream\');\n  res.setHeader(\'Cache-Control\', \'no-cache\');\n  res.setHeader(\'Connection\', \'keep-alive\');\n  res.flushHeaders?.();\n\n  // Send initial metadata\n  res.write(`data: ${JSON.stringify({ type: \'start\', chatId: targetChat.id, userMessage: userMsg })}\\n\\n`);\n\n  // Prepare history\n  const previousMessages = db.getMessages(targetChat.id);\n  const formattedHistory = previousMessages.map(m => ({\n    role: m.role,\n    content: m.content\n  }));\n\n  try {\n    await AiService.streamCompletion(user, model, provider, formattedHistory, {\n      onChunk: (chunk: string) => {\n        res.write(`data: ${JSON.stringify({ type: \'chunk\', text: chunk })}\\n\\n`);\n      },\n      onDone: (fullText: string, promptTokens: number, completionTokens: number) => {\n        const assistantMsg = db.addMessage(targetChat!.id, \'assistant\', fullText, model.id, completionTokens);\n        const usageRecord = db.recordUsage(user.id, targetChat!.id, model.id, promptTokens, completionTokens);\n\n        const updatedUser = db.getUserById(user.id);\n        const usageStats = calculateUsageStats(updatedUser?.usage_limit || 50000, updatedUser?.current_usage || 0);\n\n        res.write(`data: ${JSON.stringify({\n          type: \'done\',\n          assistantMessage: assistantMsg,\n          usageRecord,\n          usageStats\n        })}\\n\\n`);\n        res.end();\n      },\n      onError: (err: Error) => {\n        console.error(\'Streaming error:\', err);\n        res.write(`data: ${JSON.stringify({ type: \'error\', error: \'\340\246\217\340\246\206\340\246\207 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\255\340\246\276\340\246\260\340\247\207 \340\246\270\340\246\256\340\246\270\340\247\215\340\246\257\340\246\276 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207: \' + err.message })}\\n\\n`);\n        res.end();\n      }\n    });\n  } catch (err: any) {\n    console.error(\'Stream completion failed:\', err);\n    res.write(`data: ${JSON.stringify({ type: \'error\', error: err.message })}\\n\\n`);\n    res.end();\n  }\n});\n\n// ==========================================\n// 5. Admin Panel Endpoints (Role Protected)\n// ==========================================\n\napp.get(\'/api/admin/stats\', requireAdmin, (_req: AuthenticatedRequest, res: Response) => {\n  const stats = db.getAdminStats();\n  res.json(stats);\n});\n\napp.get(\'/api/admin/users\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  const { search, role, status } = req.query as { search?: string; role?: string; status?: string };\n  const users = db.listUsers(search, role, status);\n  const userListWithSubs = users.map(u => ({\n    id: u.id,\n    email: u.email,\n    name: u.name,\n    phone: u.phone,\n    role: u.role,\n    status: u.status,\n    usage_limit: u.usage_limit,\n    current_usage: u.current_usage,\n    created_at: u.created_at,\n    subscription: db.getSubscriptionByUserId(u.id) || null\n  }));\n  res.json(userListWithSubs);\n});\n\napp.put(\'/api/admin/users/:id\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  const { status, role, usage_limit } = req.body;\n  const updated = db.updateUser(req.params.id, {\n    ...(status && { status }),\n    ...(role && { role }),\n    ...(usage_limit !== undefined && { usage_limit: parseInt(usage_limit, 10) })\n  });\n  if (!updated) {\n    res.status(404).json({ error: \'\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\207 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n  res.json(updated);\n});\n\napp.delete(\'/api/admin/users/:id\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  if (req.params.id === req.user!.id) {\n    res.status(400).json({ error: \'\340\246\250\340\246\277\340\246\234\340\247\207\340\246\260 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237 \340\246\256\340\247\201\340\246\233\340\247\207 \340\246\253\340\247\207\340\246\262\340\246\276 \340\246\257\340\246\276\340\246\254\340\247\207 \340\246\250\340\246\276\340\245\244\' });\n    return;\n  }\n  const deleted = db.deleteUser(req.params.id);\n  res.json({ success: deleted });\n});\n\napp.post(\'/api/admin/users/:id/subscription\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  const { planId, days } = req.body;\n  const user = db.getUserById(req.params.id);\n  if (!user) {\n    res.status(404).json({ error: \'\340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\207 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n\n  const result = db.createOrRenewSubscription({\n    userId: user.id,\n    planId: planId === \'yearly\' ? \'yearly\' : \'monthly\',\n    paymentMethod: \'admin_grant\',\n    trxId: \'ADMIN_GRANT_\' + Date.now()\n  });\n\n  if (days && parseInt(days, 10) > 0) {\n    const customExpiry = new Date(Date.now() + parseInt(days, 10) * 86400 * 1000).toISOString();\n    db.updateSubscription(result.subscription.id, { expires_at: customExpiry });\n    result.subscription.expires_at = customExpiry;\n  }\n\n  res.json(result);\n});\n\napp.get(\'/api/admin/providers\', requireAdmin, (_req: AuthenticatedRequest, res: Response) => {\n  const providers = db.listProviders().map(p => ({\n    ...p,\n    // Mask sensitive API key for display\n    api_key_masked: p.api_key ? (p.api_key.slice(0, 7) + \'...\' + p.api_key.slice(-4)) : \'\'\n  }));\n  res.json(providers);\n});\n\napp.put(\'/api/admin/providers/:id\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  const { name, api_key, base_url, is_active } = req.body;\n  const updates: any = {};\n  if (name !== undefined) updates.name = name;\n  if (base_url !== undefined) updates.base_url = base_url;\n  if (is_active !== undefined) updates.is_active = is_active;\n  if (api_key !== undefined && api_key !== \'\') {\n    updates.api_key = api_key;\n  }\n\n  const updated = db.updateProvider(req.params.id, updates);\n  if (!updated) {\n    res.status(404).json({ error: \'\340\246\252\340\247\215\340\246\260\340\247\213\340\246\255\340\246\276\340\246\207\340\246\241\340\246\276\340\246\260 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n  res.json(updated);\n});\n\napp.get(\'/api/admin/models\', requireAdmin, (_req: AuthenticatedRequest, res: Response) => {\n  const models = db.listModels(false);\n  res.json(models);\n});\n\napp.put(\'/api/admin/models/:id\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  const { is_enabled, is_default, badge, display_name } = req.body;\n  const updated = db.updateModel(req.params.id, {\n    ...(is_enabled !== undefined && { is_enabled }),\n    ...(is_default !== undefined && { is_default }),\n    ...(badge !== undefined && { badge }),\n    ...(display_name !== undefined && { display_name })\n  });\n  if (!updated) {\n    res.status(404).json({ error: \'\340\246\256\340\246\241\340\247\207\340\246\262 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' });\n    return;\n  }\n  res.json(updated);\n});\n\napp.get(\'/api/admin/settings\', requireAdmin, (_req: AuthenticatedRequest, res: Response) => {\n  res.json(db.getSettings());\n});\n\napp.put(\'/api/admin/settings\', requireAdmin, (req: AuthenticatedRequest, res: Response) => {\n  const updated = db.updateSettings(req.body);\n  res.json(updated);\n});\n\n// ==========================================\n// 6. Vite Middleware Integration\n// ==========================================\n\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const { createServer } = await import(\'vite\');\n    const vite = await createServer({\n      server: {\n        middlewareMode: true,\n        hmr: process.env.DISABLE_HMR !== \'true\',\n        watch: process.env.DISABLE_HMR === \'true\' ? null : {}\n      },\n      appType: \'spa\'\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, () => {\n    console.log(`[Bangla AI Server] Running on http://localhost:${PORT}`);\n  });\n}\n\nstartServer().catch(err => {\n  console.error(\'Failed to start server:\', err);\n});\n"
