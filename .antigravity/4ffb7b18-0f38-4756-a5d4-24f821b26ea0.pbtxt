            lines {
              text: "# Bangla AI \342\200\224 Unified Multi-Model AI Hub for Bangladesh"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "**Bangla AI** is a production-grade, minimalist AI aggregator web platform engineered for users in Bangladesh. It provides unified access to top foundation models (Google Gemini 2.5, OpenAI GPT-4o, Anthropic Claude 3.5, and DeepSeek R1) through a single distraction-free chat interface with local Bangladeshi Taka (\340\247\263) subscriptions via bKash, Nagad, Rocket, and credit cards."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## \342\232\241 Core Capabilities"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Modular Multi-Model Aggregator:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **Google Gemini 2.5 Pro & Flash:** Native high-context, ultra-fast streaming via `@google/genai`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **OpenAI GPT-4o, Anthropic Claude 3.5 Sonnet, DeepSeek R1:** Modular provider pipeline configurable in the Admin Console without modifying frontend chat logic."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Server-side secret isolation: API keys are encrypted in backend storage and never sent to the browser runtime."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Local BDT Pricing & Subscriptions:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **Monthly Plan:** \340\247\2631,299 / month (30-day billing cycle, 50,000 token quota)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **Yearly Plan:** \340\247\2639,999 / year (365-day billing cycle, 750,000 token quota, saves ~36%)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Seamless checkout supporting bKash, Nagad, Rocket, and card gateways with Transaction ID (TrxID) verification and instant unlocking."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
