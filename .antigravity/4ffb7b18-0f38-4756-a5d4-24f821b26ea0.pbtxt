      thinking_signature: "\022\224\a\n\221\a\001i\024}\023\001NUb\276=\301\260\250v\264\026\263q\247\t8\370\2171\212\370\204\237\337\b\273H\357\241\356\370\277\262\340\323\306\206c!Q\253,\331\353\034\200P\250W\347M*@\366\337\325\017\316\310*\370\016n)~k\316\177\243r\301\a\372\264\253\001d\227RY\235c\254\020\235\376<\272\233\331\230\331J\332\021u\231\020\211\211@\016\376\a\004\276\033)\031C\227*\367\351q\0245\236w;>\266\035\226u\005\371E\254e\235,\236\210\003#\351l(\357\300p\375/\342}\362\305\021\311\253\230[\"\"\303\250\343\260\217V\302^\376\200\377M#\340V\3768\363U\340o\220\373\305Q\035WFq}x!?\311I\210\357L;\250\263\023\246\302c\200\263\f\215tG\323\255\253Eg\341\341\000\a\211*-n\002\271\375\254\302\344&y\326\370*\311+\314W\370J\353\000\216\245%\372\201}\022\372\252\006\2042/ \3625D\326\313\000\214D\311\312c\336\363AT\324X\307\326\251%\221\311p\300}(T~\320=\234\241\336\356\016+\236\211\004\231\255\tQ`&\272\203_m\330\275\351\312\360/_U\254\321\213o\3069\214*\264~6P\330\202\030\322\302\001\375\222mXf\202\355\374\371\310D\256p\274^;\252\257\206j\034>S\006ZY\237v_\265f\211x=A\270_q\204\030\031\243\304\354\324\327\227\274\357RFm\222k\230\221N\255+\347\032\2345\\\242\227\307#\016|>\177\307\252N\034\274\f\374\322_x\003L,\020\251WW\\U%\017\242\330\246\204>\360d\2456N#\034\031(\344\237[J\360\t\276\223\207\246\335\035\305f\312n\341\232\003\024 \324\347\360?\241\251\265F\264c\374\2578G\n\333\315\300\b|\221\273\275\023\254P\366J\371\020\002\375r/x\321Ds\365N\350\303\270\311a<,\377(3\v\233\221\"W \332\b\300\361\2134\fJf\264Gg\003`Ye\263\303\341\004\324\r\2671\250\243\253\016\326\214VN\340C\024o\253\205/fV\000\236\330\342\315f\227\360\307r\213\222\201\224\225\260y\363\340\000\257C\213\0364t\253\344\250Am\200\a\275\254\177\023x\200\222\035\352\024^\345\2368e\024m\244\031\233\370U\311\273\2231\274\225m\245\207&~\242{\307C\rv\264\360K\231\263AQ\355?[\233\342@\3205:E\001[J=w\246\223~\316\224T0\215\333}G\305\222\311H\206\207\332,\210\251G\374\362K\r[\3212\216\335\251\204\237\311\247\024\216\002\023H\267\036lp&\262\272\314\333\315\032\006\324\306\260VO\005\037^\032\370\205+*\251\036R\277i\310\235\306Er\210\310\022I\312\270\373\347\333j\200\v\266*\262\220\242\363\320y\212m\201\357\000\325\231\216\000\345\344T\3366\252\265\t\205\201\275\275A\"\244E\362\223\260y_A\005\024=ou?\027\241\3419\342\025\245\350\221\3654\000\201\f\243(n\241\323\335y\242\315\022E#\034\355\016,\223\213\220\375\vqL\016\037\v\212\016\n\035\212T\352\027\301I_\276\275AH\244\204\031\224\034t\313dX\240\344]\346\253\361\241\316i\233\030g\024N\030\307\320\236\335]\256\320\213\221 \200c\372\221\261Ao\217{b\236\027\'n\315Y\001\312vJ%\303U\n\376\204`4\273\000\347\3136\263\374r\346\311"
