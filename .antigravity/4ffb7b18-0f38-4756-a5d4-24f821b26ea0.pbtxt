            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "2. **\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\227\340\247\207\340\246\237\340\246\223\340\246\257\340\246\274\340\247\207 \340\246\207\340\246\250\340\247\215\340\246\237\340\246\277\340\246\227\340\247\215\340\246\260\340\247\207\340\246\266\340\246\250:**"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - \340\246\254\340\246\277\340\246\225\340\246\276\340\246\266 (bKash) \340\246\223 \340\246\250\340\246\227\340\246\246 (Nagad) \340\246\256\340\246\276\340\246\260\340\247\215\340\246\232\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - \340\246\255\340\246\277\340\246\270\340\246\276/\340\246\256\340\246\276\340\246\270\340\247\215\340\246\237\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\215\340\246\241\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 SSLCommerz \340\246\254\340\246\276 Shurjopay \340\246\227\340\247\207\340\246\237\340\246\223\340\246\257\340\246\274\340\247\207"
