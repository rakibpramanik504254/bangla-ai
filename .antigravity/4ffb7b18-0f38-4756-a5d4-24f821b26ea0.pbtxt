      thinking_signature: "\022\363\026\n\360\026\001i\024}\023\250\323\246\374\n\334\317M\234[\320<\312\337\022>\365\342~\367\022tq\306$\366\032\326\266t\377\304\f\r\261pp\027\330\f\362\233\021\a\262>\223\320B\021^\023\257W\004B\230+\023\221\344\216\232\335\002\302$\351\372\223\340\357#\207\347\335\303=\312\342KW\315:\240\b\253n1G\236\257Z\3617L\326z\223\177\206\024\262\201\247\267\310\224d\271\330\333\307\237\205\353\312j)\332i;\346\242o\327\365-&\251\n\346\325\235\315\250\362\335\216\330\375l\vGK\331y\222\364\311\227s\3729NY\315\253\214\326\310\263$q\251\350\315ro\223\t=EP\262\037_\322O]l!\251\246\343e\032\3064\315\034\263\203]\256b~a\3018\034\2750\331\343\233\nPm\vX\307\305\357%*\306T\232\251\037\357]\017L\244\326s\275\262M\024\246E\250\351{\021\331\323\323e\231\260EZ\266\314#/\371\222\030\305\345\235\036\244\224\223T\205\350\333u\372t\257\215\351@\360d*\ba\305\310w\b\300\313V\252\255S\351N|N\267\374\216:hN\227\001a\374\304\f.\350\222km\330=\350\234\253\270B\377,(\242$\373\302\177\004\262+S\303\023J\223\364\000E0\243#\371\217\270\222\216\375\030\220\263\205\b/\370r\354\201\375\207\v\331\t\033\263\344\260\376\307\027\254L\332z\251\3570\r\304\177I\362\266\bx\177{\371\020<\255)\321\267\327\265+a\177i\325J\220\034g\220\315\312\374\270p\224\313\207\027\304D\347z\r\223\257\244\375\362\242\255\025^=L>\363:Z\033\22779\236\362\23144u\033Gj~\367\220\313H\371t\267\314\032\277\333\034O\3015\001\213\340\270\260\231b\355\b\271\237\272}\345\210\000\203\213\260\304\335A\272\177\204\277W4\301\273@\314\300\372\301R\272`\2618A\031\303\032RO\360\355\266\276\fk/za\037\245\002oo\230 \030p\3032\320\031\000\327l\221\202/\024\254\241\216\364\033$5\317t\b:\217\004\177\374\002\261\357$\263u\243\335\b\231\316M\356\3309m>\022],\0256\325+r\262\230\331E\',sw\241\330$\334\267\337\355\347\362\333FP\ry!\006\0039\311W\311\234\267\f\t|\302.#ceV(\026\356\375\351\263m\'\364\217\344\351Z|\227\032m\365\234h\266\2549\340\024\220\346>\020\266\314\312\236w\240\000}X\"\254\236t\214\235~\360\234\034?\276z\