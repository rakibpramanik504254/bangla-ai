      arguments_json: "{\"Append\":false, \"CodeContent\":\"export interface User {\\n  id: string;\\n  email: string;\\n  name: string;\\n  phone: string;\\n  role: \'user\' | \'admin\';\\n  status: \'active\' | \'suspended\';\\n  usage_limit: number;\\n  current_usage: number;\\n  created_at?: string;\\n  subscription?: Subscription | null;\\n  isSubscribed: boolean;\\n}\\n\\nexport interface Subscription {\\n  id: string;\\n  user_id: string;\\n  plan_id: \'monthly\' | \'yearly\';\\n  plan_name: string;\\n  amount: number;\\n  currency: \'BDT\';\\n  status: \'active\' | \'expired\' | \'cancelled\';\\n  started_at: string;\\n  expires_at: string;\\n  auto_renew: boolean;\\n  payment_method: string;\\n  trx_id: string;\\n}\\n\\nexport interface Payment {\\n  id: string;\\n  user_id: string;\\n  subscription_id?: string;\\n  amount: number;\\n  currency: \'BDT\';\\n  gateway: \'bkash\' | \'nagad\' | \'rocket\' | \'sslcommerz\';\\n  trx_id: string;\\n  sender_number: string;\\n  status: \'completed\' | \'pending\' | \'failed\';\\n  created_at: string;\\n}\\n\\nexport interface Chat {\\n  id: string;\\n  user_id: string;\\n  title: string;\\n  model_id: string;\\n  pinned: boolean;\\n  created_at: string;\\n  updated_at: string;\\n}\\n\\nexport interface Message {\\n  id: string;\\n  chat_id: string;\\n  role: \'user\' | \'assistant\' | \'system\';\\n  content: string;\\n  model_id: string;\\n  tokens_used: number;\\n  created_at: string;\\n}\\n\\nexport interface AiModel {\\n  id: string;\\n  provider_id: string;\\n  model_name: string;\\n  display_name: string;\\n  description_bn: string;\\n  badge: \'super_fast\' | \'reasoning\' | \'coding\' | \'balanced\';\\n  is_enabled: boolean;\\n  is_default: boolean;\\n  context_window: number;\\n  max_output_tokens: number;\\n  sort_order: number;\\n}\\n\\nexport interface AiProvider {\\n  id: string;\\n  name: string;\\n  slug: string;\\n  api_key_masked?: string;\\n  base_url?: string;\\n  is_active: boolean;\\n}\\n\\nexport interface AdminStats {\\n  totalUsers: number;\\n  activeSubscribers: number;\\n  totalRevenue: number;\\n  totalTokensUsed: number;\\n  modelUsageMap: Record<string, number>;\\n  totalChats: number;\\n  totalMessages: number;\\n}\\n\\nexport interface UsageStats {\\n  limit: number;\\n  used: number;\\n  remaining: number;\\n  percentage: number;\\n  isLimitReached: boolean;\\n}\\n\", \"Description\":\"Type definitions for user, subscription, payment, chat, models, and admin stats\", \"Overwrite\":true, \"TargetFile\":\"/src/types/index.ts\", \"toolAction\":\"Writing frontend types\", \"toolSummary\":\"Create src/types/index.ts\"}"
