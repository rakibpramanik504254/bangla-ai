      thinking_signature: "\022\355\r\n\352\r\001i\024}\023\020q\222\030\032\320Fd\277\202\262+\3573\260\260\371\352N\016\322\236w\333\340\020\307N\340n\257\031(\213\306\366\370\346\256\307\021\"Eel\326\363\276\222\373\345\377R\215\233|\2562\270\364<\345W4\307\326*f\020\256\365\274\2440\250\251\005\025);\301\003\a\020%\212\203\016F\037Su\235#}\211\277\207\364\365(w\356\000=\211W\351\207\311\3152\257\027\363-0\273\277\327\305ffV\234\222\234czg\027\335\323\211\342\216\365#\311/H !TJ\233\361\311\315\306z\256\350\312\301\034\257\207\231\'\201\031\017O\025\250\025\335@o\332\345\334eu\347\303\003\371\323\315v\205\272Y\243\fH\216{\223\322\225C\327\'\336t\321p\206\223\017#\"B\274\2046\350\254\316\373\030\357\254P(\314\365\315\343f \210\212\022P\3369{i\222\377?\ag\263MFe\362\245\346.\306_+\272\223\301\vR\272\2158\fe;\317\345\235\234\aZ\025\307\312\344z\024\335R\354\213\037\201_\332|[R\272&\031\337\247\277!g\257R\200,\217o_H)P\255U\352\006\355\364\226\315E\226\t\020\325_\t\030\3375)\004\220\254\351\003\340v\331\347\255\a\364\252\033\213\216\b\251\273\213j\257}&\277\265\352(\246\327C\302\247\036\024\327\343{\333\241\006\330\250x\0023\376\240\002\030\335\216\315\a\251\v\035A\242\271\264\326\364\000\260\274b\207\267-\026w\210\025\355m\366\276\304\351\255 \365\001t\271jZ\360\301\342\326.\215#Pg\206\260\364\023\327`\302\301voXF?\225\264\374\375\343\276A\264\327vr\330\372:/\243lW\222\016\325\320\b\270Z\363(?2M;\352\310\340b\364Q\273\252Pz\325\316nm\256\247\356\340\272\244\240\262S6S\2007\336kOE`\341\272\\\323\036\306\243\t\2750t\374(J\266.\027\322\345\266\221+\235\236\322\201N\264%\337\314\275\242\231\211\221\275\355;{\0308H\203\323\233eA\372\320\a\240\205\242?8\307\272&\256s{\355\236\242\005\307\304\272\227w\"\001\264\310I\326\263:u\327\234\345\272\035\017\241\271\240\246H\222\314\213i\313j\0003.\317\200H\364\322v\342\306l\002\344%]\371j\364\321\025`\000\375c\331]\374N\v*\017\354\020\230\340\266\000\231U\213~\213\f\335E8\305\317\024\341\037((\317\222W\250T\360\327\335\251.\a\005\207\354\345\267\270}\203B\277\v@\222\342,I\336Q]t\335f\262\233\311\325A2\222\255\362\030\231\245\313o\237\237\216\260\355`K\0176\234\022\237,\301\344[\017P^<\362\f\253:?\346\322\370:\363\334\236?\314\216\251\203\216\201\277)\301\300\212\320S\253\346\v\264q\203\313}I\375\276\030V\351\221\222\230\354\267\323\271\371\026\006\347|\022S\330Q\325D\001l\024\024\031/e\326\263\373\214\005m\356\220B`\334\212\312\211v\316\256uRn}\001\016\252\3358h\301\016Wos\033\317\032\366aD\226\227 \037\326\303\023\245\033\322O\340\027\234\270\237)\203\']x\016\243\276\341L\335/2}V\327\351\341\306\313\261}\201\372u\344\214r\202\350j3\207\005\340\001\216\352,%\362\315\342\003wb\302\250\037<\236\027\006@\311Cr0S\251\270\305 4\310\276N\252+e\275V.U/I\306\323\020`5\232\027\324T\030\266\263/\2425\231\211]\374E/(\317\351\365\025\273\273p\261e\023\002\364\243\0324\311\177TkdE\314_A\375\260\317w9\334|D\245,X\033\237f\001\004\276\252\235\374r\214\205\221g\226\232\320[\034 \232\006\006\211#\234\317we`b\032I\re\267\325\211\303h\263N\030X\355?\304\255n\364\304Ys\230d\372\235\aD\316\253\313\3428\b3j\231ekt\336$\256\222\274\024c\004\277J\v\212\301\252\361\205\233;,\031\rpec\177\327v\246\230(\252\a\002+\231\215\224\vQ\232\002\345\246\031\373g\215#\374\355\357\221\234\377\236t\236z\230\357\346ii[ut\b0\270w\337\241\032\274T\335`\t\t\353]\361\034\250\327/d\237]\301\036\221\306e\360G:\305\241f\223\256h\020\001\221\3375\a\326\017\235\"@\357dj.)\252\354>\3147\354\301\337\017\332\036\262\031\252\307E\261_a67\362R|\244L\232\002\230m\276\347;\022\0019\016\213\264\305\232\b\026\002\354\226\264\0361\032\255\272o\351K\314\b\025\356\022\223x\341x\"\347*\017\201\251Puh$T\036]?}\034\223q\022\206\342\032-\234,\225\242\345\304}^\212^BV\315:3\201e\345\231\216\022\251\260\020\326\303%\325\242\313Ft\270 \227\347`\303\020\234\3305\343\365\213M\250(\353\243\306hGs\235J\276\346\203i\205\274\352\212\037\215VkQG#\227\202Kk\275o\020l-\246\"F:-\"x\025\346\242\377?7i\370?\002f\272}u[\225\271\352I\223\352\334)N\234\371\261\037Z\ao\312\2