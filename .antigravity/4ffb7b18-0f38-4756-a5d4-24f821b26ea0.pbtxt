    end_line: 353
    content: "import React, { useState } from \'react\';\nimport { X, Sparkles, AlertCircle, CheckCircle2, KeyRound, Mail, User as UserIcon, Phone, ArrowRight } from \'lucide-react\';\nimport { useAuth } from \'../../context/AuthContext.tsx\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  defaultTab?: \'login\' | \'register\';\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({ isOpen, onClose, defaultTab = \'login\' }) => {\n  const { login, register } = useAuth();\n  const [tab, setTab] = useState<\'login\' | \'register\' | \'forgot\'>(defaultTab);\n\n  const [name, setName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [phone, setPhone] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n\n  const [resetToken, setResetToken] = useState(\'\');\n  const [newPassword, setNewPassword] = useState(\'\');\n  const [resetStep, setResetStep] = useState<1 | 2>(1);\n\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [success, setSuccess] = useState<string | null>(null);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setSuccess(null);\n    setLoading(true);\n\n    try {\n      if (tab === \'login\') {\n        await login(email, password);\n        onClose();\n      } else if (tab === \'register\') {\n        await register(name, email, password, phone);\n        onClose();\n      } else if (tab === \'forgot\') {\n        if (resetStep === 1) {\n          const res = await fetch(\'/api/auth/forgot-password\', {\n            method: \'POST\',\n            headers: { \'Content-Type\': \'application/json\' },\n            body: JSON.stringify({ email })\n          });\n          const data = await res.json();\n          if (!res.ok) throw new Error(data.error || \'Request failed\');\n          setSuccess(data.message + (data.demoOtp ? ` (Demo OTP: ${data.demoOtp})` : \'\'));\n          if (data.demoOtp) setResetToken(data.demoOtp);\n          setResetStep(2);\n        } else {\n          const res = await fetch(\'/api/auth/reset-password\', {\n            method: \'POST\',\n            headers: { \'Content-Type\': \'application/json\' },\n            body: JSON.stringify({ email, token: resetToken, newPassword })\n          });\n          const data = await res.json();\n          if (!res.ok) throw new Error(data.error || \'Password reset failed\');\n          setSuccess(data.message);\n          setTimeout(() => {\n            setTab(\'login\');\n            setResetStep(1);\n          }, 1500);\n        }\n      }\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const fillDemoAccount = (role: \'admin\' | \'subscriber\' | \'unpaid\') => {\n    setError(null);\n    if (role === \'admin\') {\n      setEmail(\'admin@bangla.ai\');\n      setPassword(\'AdminPassword123!\');\n    } else if (role === \'subscriber\') {\n      setEmail(\'subscriber@bangla.ai\');\n      setPassword(\'UserPassword123!\');\n    } else {\n      setEmail(\'unpaid@bangla.ai\');\n      setPassword(\'UserPassword123!\');\n    }\n    setTab(\'login\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm animate-in fade-in\">\n      <div className=\"relative w-full max-w-sm bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-800 overflow-hidden\">\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-1.5 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors\"\n          aria-label=\"Close\"\n        >\n          <X className=\"w-4 h-4\" />\n        </button>\n\n        {/* Modal Header */}\n        <div className=\"px-6 pt-6 pb-4 border-b border-gray-100 dark:border-gray-800 text-center\">\n          <div className=\"inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white mb-2.5 font-bold\">\n            <Sparkles className=\"w-5 h-5\" />\n          </div>\n          <h2 className=\"text-base font-bold text-gray-900 dark:text-white\">\n            {tab === \'login\' && \'Sign In to Bangla AI\'}\n            {tab === \'register\' && \'Create Your Account\'}\n            {tab === \'forgot\' && \'Reset Password\'}\n          </h2>\n          <p className=\"text-[11px] text-gray-400 mt-0.5\">\n            Access top foundation models in one unified subscription\n          </p>\n\n          {/* Switcher */}\n          {tab !== \'forgot\' && (\n            <div className=\"grid grid-cols-2 p-1 bg-gray-100 dark:bg-gray-800 rounded-lg mt-3 text-xs font-medium\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setTab(\'login\');\n                  setError(null);\n                }}\n                className={`py-1.5 rounded-md transition-all ${\n                  tab === \'login\'\n                    ? \'bg-white dark:bg-gray-900 text-gray-900 dark:text-white font-semibold shadow-2xs\'\n                    : \'text-gray-500 hover:text-gray-900 dark:text-gray-400\'\n                }`}\n              >\n                Sign In\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setTab(\'register\');\n                  setError(null);\n                }}\n                className={`py-1.5 rounded-md transition-all ${\n                  tab === \'register\'\n                    ? \'bg-white dark:bg-gray-900 text-gray-900 dark:text-white font-semibold shadow-2xs\'\n                    : \'text-gray-500 hover:text-gray-900 dark:text-gray-400\'\n                }`}\n              >\n                Sign Up\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* Quick Demo Accounts */}\n        {tab === \'login\' && (\n          <div className=\"px-6 py-2.5 bg-gray-50 dark:bg-gray-850/50 border-b border-gray-100 dark:border-gray-800 text-[11px]\">\n            <span className=\"text-gray-400 font-medium block mb-1.5\">\342\232\241 Instant Demo Sign-In:</span>\n            <div className=\"grid grid-cols-3 gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => fillDemoAccount(\'subscriber\')}\n                className=\"py-1 px-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md text-[10px] font-medium text-gray-800 dark:text-gray-200 hover:border-gray-400 text-center truncate\"\n              >\n                \342\255\220 Subscriber\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => fillDemoAccount(\'admin\')}\n                className=\"py-1 px-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md text-[10px] font-medium text-amber-600 dark:text-amber-400 hover:border-amber-400 text-center truncate\"\n              >\n                \360\237\221\221 Admin\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => fillDemoAccount(\'unpaid\')}\n                className=\"py-1 px-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md text-[10px] font-medium text-gray-500 hover:border-gray-400 text-center truncate\"\n              >\n                \360\237\221\244 Free User\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Form */}\n        <form onSubmit={handleSubmit} className=\"p-6 space-y-3\">\n          {error && (\n            <div className=\"p-2.5 text-xs bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-300 rounded-lg flex items-start gap-2\">\n              <AlertCircle className=\"w-3.5 h-3.5 shrink-0 mt-0.5\" />\n              <span>{error}</span>\n            </div>\n          )}\n\n          {success && (\n            <div className=\"p-2.5 text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-300 rounded-lg flex items-start gap-2\">\n              <CheckCircle2 className=\"w-3.5 h-3.5 shrink-0 mt-0.5\" />\n              <span>{success}</span>\n            </div>\n          )}\n\n          {tab === \'register\' && (\n            <div>\n              <label className=\"block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1\">\n                Full Name *\n              </label>\n              <div className=\"relative\">\n                <UserIcon className=\"w-3.5 h-3.5 absolute left-3 top-2.5 text-gray-400\" />\n                <input\n                  type=\"text\"\n                  required\n                  value={name}\n                  onChange={e => setName(e.target.value)}\n                  placeholder=\"e.g. Tanvir Ahmed\"\n                  className=\"w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-gray-400\"\n                />\n              </div>\n            </div>\n          )}\n\n          <div>\n            <label className=\"block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1\">\n              Email Address *\n            </label>\n            <div className=\"relative\">\n              <Mail className=\"w-3.5 h-3.5 absolute left-3 top-2.5 text-gray-400\" />\n              <input\n                type=\"email\"\n                required\n                value={email}\n                onChange={e => setEmail(e.target.value)}\n                placeholder=\"name@domain.com\"\n                className=\"w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-gray-400\"\n              />\n            </div>\n          </div>\n\n          {tab === \'register\' && (\n            <div>\n              <label className=\"block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1\">\n                Phone Number (for bKash / Nagad verification)\n              </label>\n              <div className=\"relative\">\n                <Phone className=\"w-3.5 h-3.5 absolute left-3 top-2.5 text-gray-400\" />\n                <input\n                  type=\"tel\"\n                  value={phone}\n                  onChange={e => setPhone(e.target.value)}\n                  placeholder=\"017xxxxxxxx\"\n                  className=\"w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-gray-400\"\n                />\n              </div>\n            </div>\n          )}\n\n          {tab !== \'forgot\' && (\n            <div>\n              <div className=\"flex items-center justify-between mb-1\">\n                <label className=\"text-xs font-medium text-gray-700 dark:text-gray-300\">\n                  Password *\n                </label>\n                {tab === \'login\' && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setTab(\'forgot\');\n                      setError(null);\n                    }}\n                    className=\"text-[11px] text-gray-400 hover:text-gray-700 dark:hover:text-gray-200\"\n                  >\n                    Forgot?\n                  </button>\n                )}\n              </div>\n              <div className=\"relative\">\n                <KeyRound className=\"w-3.5 h-3.5 absolute left-3 top-2.5 text-gray-400\" />\n                <input\n                  type=\"password\"\n                  required\n                  value={password}\n                  onChange={e => setPassword(e.target.value)}\n                  placeholder=\"Minimum 6 characters\"\n                  className=\"w-full pl-8 pr-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-gray-400\"\n                />\n              </div>\n            </div>\n          )}\n\n          {tab === \'forgot\' && resetStep === 2 && (\n            <>\n              <div>\n                <label className=\"block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1\">\n                  OTP Reset Code *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={resetToken}\n                  onChange={e => setResetToken(e.target.value)}\n                  placeholder=\"RESET-XXXXXX\"\n                  className=\"w-full px-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white font-mono focus:outline-none focus:ring-1 focus:ring-gray-400\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1\">\n                  New Password *\n                </label>\n                <input\n                  type=\"password\"\n                  required\n                  value={newPassword}\n                  onChange={e => setNewPassword(e.target.value)}\n                  placeholder=\"Set new secure password\"\n                  className=\"w-full px-3 py-2 text-xs rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-gray-400\"\n                />\n              </div>\n            </>\n          )}\n\n          <button\n            type=\"submit\"\n            disabled={loading}\n            className=\"w-full py-2.5 px-4 rounded-lg font-semibold text-xs text-white dark:text-gray-950 bg-gray-950 hover:bg-black dark:bg-white dark:hover:bg-gray-100 transition-all flex items-center justify-center gap-1.5 shadow-xs disabled:opacity-50 mt-2\"\n          >\n            {loading ? (\n              <span className=\"inline-block w-3.5 h-3.5 border-2 border-white dark:border-gray-950 border-t-transparent rounded-full animate-spin\" />\n            ) : (\n              <>\n                <span>\n                  {tab === \'login\' && \'Sign In\'}\n                  {tab === \'register\' && \'Create Account\'}\n                  {tab === \'forgot\' && (resetStep === 1 ? \'Send Reset OTP\' : \'Update Password\')}\n                </span>\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </>\n            )}\n          </button>\n\n          {tab === \'forgot\' && (\n            <button\n              type=\"button\"\n              onClick={() => {\n                setTab(\'login\');\n                setError(null);\n                setResetStep(1);\n              }}\n              className=\"w-full text-center text-[11px] text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 pt-1\"\n            >\n              \342\206\220 Back to Sign In\n            </button>\n          )}\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 354
    num_bytes: 14878
    line_range_bytes: 14878
  }
}
