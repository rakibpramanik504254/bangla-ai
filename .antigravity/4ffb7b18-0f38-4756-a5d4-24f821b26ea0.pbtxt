        instruction: "import React from \'react\';\nimport { Shield, AlertTriangle, FileText, Lock, Eye, Database, Scale, Mail } from \'lucide-react\';\n\nexport const PrivacyPolicyPage: React.FC = () => {\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10\">\n      {/* Header */}\n      <div className=\"text-center space-y-3\">\n        <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-semibold\">\n          <Shield className=\"w-4 h-4 text-emerald-600\" />\n          <span>\340\246\206\340\246\207\340\246\250\340\246\277 \340\246\223 \340\246\241\340\247\207\340\246\237\340\246\276 \340\246\270\340\247\201\340\246\260\340\246\225\340\247\215\340\246\267\340\246\276 \340\246\250\340\247\200\340\246\244\340\246\277\340\246\256\340\246\276\340\246\262\340\246\276</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white\">\n          \340\246\227\340\247\213\340\246\252\340\246\250\340\247\200\340\246\257\340\246\274\340\246\244\340\246\276 \340\246\250\340\247\200\340\246\244\340\246\277 (Privacy Policy)\n        </h1>\n        <p className=\"text-xs text-gray-500\">\340\246\270\340\246\260\340\247\215\340\246\254\340\246\266\340\247\207\340\246\267 \340\246\270\340\246\202\340\246\270\340\247\215\340\246\225\340\246\260\340\246\243: \340\246\250\340\246\255\340\247\207\340\246\256\340\247\215\340\246\254\340\246\260 \340\247\250\340\247\246\340\247\250\340\247\254 \342\200\242 \340\246\242\340\246\276\340\246\225\340\246\276, \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266</p>\n      </div>\n\n      {/* Prominent Legal Disclaimer Callout */}\n      <div className=\"bg-amber-50 dark:bg-amber-950/40 border-2 border-amber-300 dark:border-amber-700/80 rounded-2xl p-5 text-amber-900 dark:text-amber-200 text-xs sm:text-sm flex items-start gap-3.5 shadow-sm\">\n        <AlertTriangle className=\"w-6 h-6 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5\" />\n        <div className=\"space-y-1\">\n          <p className=\"font-bold text-sm\">\340\246\227\340\247\201\340\246\260\340\247\201\340\246\244\340\247\215\340\246\254\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\206\340\246\207\340\246\250\340\246\277 \340\246\270\340\246\244\340\246\260\340\247\215\340\246\225\340\246\244\340\246\276 (Legal Review Notice):</p>\n          <p className=\"leading-relaxed\">\n            \340\246\217\340\246\237\340\246\277 <strong>\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\217\340\246\206\340\246\207 (Bangla AI)</strong> \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\237\340\246\253\340\246\260\340\247\215\340\246\256\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\252\340\247\215\340\246\260\340\246\243\340\247\200\340\246\244 \340\246\217\340\246\225\340\246\237\340\246\277 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\213\340\246\252\340\246\257\340\247\213\340\246\227\340\247\200 \340\246\241\340\247\215\340\246\260\340\246\276\340\246\253\340\246\237 \340\246\254\340\246\276 \340\246\226\340\246\270\340\246\241\340\246\274\340\246\276 \340\246\227\340\247\213\340\246\252\340\246\250\340\247\200\340\246\257\340\246\274\340\246\244\340\246\276 \340\246\250\340\247\200\340\246\244\340\246\277\340\246\256\340\246\276\340\246\262\340\246\276\340\245\244 \340\246\217\340\246\207 \340\246\226\340\246\270\340\246\241\340\246\274\340\246\276\340\246\237\340\246\277 \340\246\270\340\246\276\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200 \340\246\241\340\247\207