      create_file {
        instruction: "/**\n * Pure billing, formatting, and subscription calculation utilities for Bangla AI\n */\n\nexport interface PlanConfig {\n  id: \'monthly\' | \'yearly\';\n  nameBn: string;\n  nameEn: string;\n  priceBDT: number;\n  durationDays: number;\n  monthlyEquivalentBDT?: number;\n  savePercent?: number;\n  featuresBn: string[];\n}\n\nexport const PLANS: Record<\'monthly\' | \'yearly\', PlanConfig> = {\n  monthly: {\n    id: \'monthly\',\n    nameBn: \'\340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250\',\n    nameEn: \'Monthly Plan\',\n    priceBDT: 1299,\n    durationDays: 30,\n    featuresBn: [\n      \'\340\246\266\340\247\200\340\246\260\340\247\215\340\246\267 \340\246\217\340\246\206\340\246\207 \340\246\256\340\246\241\340\247\207\340\246\262\340\246\270\340\246\256\340\247\202\340\246\271\340\247\207 \340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\247\215\340\246\270\340\247\207\340\246\270 (Gemini, GPT-4, Claude, DeepSeek)\',\n      \'\340\246\270\340\247\201\340\246\252\340\246\276\340\246\260\340\246\253\340\246\276\340\246\270\340\247\215\340\246\237 \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\223 \340\246\207\340\246\202\340\246\260\340\247\207\340\246\234\340\246\277 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237\',\n      \'\340\246\252\340\247\215\340\246\260\340\246\244\340\246\277 \340\246\256\340\246\276\340\246\270\340\247\207 \340\247\253\340\247\246,\340\247\246\340\247\246\340\247\246 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250 \340\246\225\340\247\213\340\246\237\340\246\276\',\n      \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\271\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\246\277 \340\246\223 \340\246\270\340\247\207\340\246\255 \340\246\270\340\247\201\340\246\254\340\246\277\340\246\247\340\246\276\',\n      \'\340\246\254\340\246\277\340\246\225\340\246\276\340\246\266, \340\246\250\340\246\227\340\246\246 \340\246\223 \340\246\260\340\246\225\340\247\207\340\246\237\340\247\207 \340\246\270\340\246\271\340\246\234 \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237\',\n      \'\340\247\250\340\247\252/\340\247\255 \340\246\225\340\246\276\340\246\270\340\247\215\340\246\237\340\246\256\340\246\276\340\246\260 \340\246\270\340\246\276\340\246\252\340\247\213\340\246\260\340\247\215\340\246\237\'\n    ]\n  },\n  yearly: {\n    id: \'yearly\',\n    nameBn: \'\340\246\254\340\246\276\340\247\216\340\246\270\340\246\260\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250\',\n    nameEn: \'Yearly Plan\',\n    priceBDT: 9999,\n    durationDays: 365,\n    monthlyEquivalentBDT: 833,\n    savePercent: 36,\n    featuresBn: [\n      \'\340\246\270\340\246\254\340\246\225\340\246\277\340\246\233\340\247\201 \340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\260 \340\246\217\340\246\254\340\246\202 \340\246\206\340\246\260\340\246\223 \340\246\254\340\247\207\340\246\266\340\246\277\',\n      \'\340\246\252\340\247\215\340\246\260\340\246\244\340\246\277 \340\246\256\340\246\276\340\246\270\340\247\207 \340\246\252\340\247\215\340\246\260\340\246\276\340\246\257\340\246\274 \340\247\251\340\247\254% \340\246\252\340\246\260\340\247\215\340\246\257\340\246\250\340\247\215\340\246\244 \340\246\270\340\246\276\340\246\266\340\247\215\340\246\260\340\246\257\340\246\274 (\340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\256\340\246\276\340\246\244\340\247\215\340\246\260 \340\247\263\340\247\256\340\247\251\340\247\251)\',\n      \'\340\246\252\340\247\215\340\246\260\340\246\244\340\246\277 \340\246\254\340\246\233\340\246\260\340\247\207 \340\247\255,\340\247\253\340\247\246,\340\247\246\340\247\246\340\247\246 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250 \340\246\225\340\247\213\340\246\237\340\246\276\',\n      \'\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\252\340\247\215\340\246\260\340\246\277\340\246\256\340\246\277\340\246\257\340\246\274\340\246\276\340\246\256 \340\246\256\340\246\241\340\247\207\340\246\262\340\247\207\340\246\260 \340\246\206\340\246\260\340\247\215\340\246\262\340\246\277 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\247\215\340\246\270\340\247\207\340\246\270\',\n      \'\340\246\205\340\246\227\340\247\215\340\246\260\340\246\276\340\246\247\340\246\277\340\246\225\340\246\276\340\246\260\340\246\255\340\246\277\340\246\244\340\247\215\340\246\244\340\246\277\340\246\225 \340\246\211\340\246\232\340\247\215\340\246\232\340\246\227\340\246\244\340\246\277\340\246\260 \340\246\270\340\246\276\340\246\260\340\247\215\340\246\255\340\246\276\340\246\260 \340\246\260\340\247\207\340\246\270\340\246\252\340\246\250\340\247\215\340\246\270\',\n      \'\340\246\241\340\247\207\340\246\241\340\246\277\340\246\225\340\247\207\340\246\237\340\247\207\340\246\241 \340\246\255\340\246\277\340\246\206\340\246\207\340\246\252\340\246\277 \340\246\270\340\246\276\340\246\252\340\247\213\340\246\260\340\247\215\340\246\237\'\n    ]\n  }\n};\n\n/**\n * Converts Western digits (0-9) to Bengali digits (\340\247\246-\340\247\257)\n */\nexport function toBanglaDigits(input: number | string): string {\n  const bnDigits = [\'\340\247\246\', \'\340\247\247\', \'\340\247\250\', \'\340\247\251\', \'\340\247\252\', \'\340\247\253\', \'\340\247\254\', \'\340\247\255\', \'\340\247\256\', \'\340\247\257\'];\n  const str = input.toString();\n  return str.replace(/[0-9]/g, (digit) => bnDigits[parseInt(digit, 10)]);\n}\n\n/**\n * Formats an amount in Bangladeshi Taka with Bengali digits and commas (e.g., \"\340\247\263\340\247\247,\340\247\250\340\247\257\340\247\257\")\n */\nexport function formatBDT(amount: number): string {\n  const parts = amount.toLocaleString(\'en-IN\').split(\'.\');\n  const intPart = toBanglaDigits(parts[0]);\n  if (parts.length > 1) {\n    return `\340\247\263${intPart}.${toBanglaDigits(parts[1])}`;\n  }\n  return `\340\247\263${intPart}`;\n}\n\n/**\n * Checks if a subscription is currently active based on status and expiry date\n */\nexport function isSubscriptionActive(subscription?: {\n  status?: string;\n  expires_at?: string | number | Date;\n} | null): boolean {\n  if (!subscription) return false;\n  if (subscription.status !== \'active\') return false;\n  if (!subscription.expires_at) return false;\n\n  const expiryTime = new Date(subscription.expires_at).getTime();\n  const now = Date.now();\n  return expiryTime > now;\n}\n\n/**\n * Calculates new expiration date when activating or renewing a plan\n */\nexport function calculateExpiryDate(\n  planId: \'monthly\' | \'yearly\',\n  currentExpiresAt?: string | number | Date | null\n): Date {\n  const days = PLANS[planId]?.durationDays || 30;\n  const msToAdd = days * 24 * 60 * 60 * 1000;\n\n  let baseTime = Date.now();\n  if (currentExpiresAt) {\n    const currentExpiry = new Date(currentExpiresAt).getTime();\n    if (currentExpiry > baseTime) {\n      // User is already active, extend from current expiry\n      baseTime = currentExpiry;\n    }\n  }\n\n  return new Date(baseTime + msToAdd);\n}\n\n/**\n * Calculates remaining usage and percentage\n */\nexport function calculateUsageStats(limit: number, currentUsage: number) {\n  const safeLimit = Math.max(1, limit);\n  const remaining = Math.max(0, safeLimit - currentUsage);\n  const percentage = Math.min(100, Math.round((currentUsage / safeLimit) * 100));\n  const isLimitReached = currentUsage >= safeLimit;\n\n  return {\n    limit: safeLimit,\n    used: currentUsage,\n    remaining,\n    percentage,\n    isLimitReached\n  };\n}\n\n/**\n * Estimates token count for combined prompt and response\n * Accommodates Bengali script (which uses more UTF-8 bytes and token subwords)\n */\nexport function estimateTokens(prompt: string, completion: string = \'\'): {\n  promptTokens: number;\n  completionTokens: number;\n  totalTokens: number;\n} {\n  const countScript = (str: string) => {\n    if (!str) return 0;\n    // Count Bangla unicode characters (range \\u0980-\\u09FF)\n    const banglaChars = (str.match(/[\\u0980-\\u09FF]/g) || []).length;\n    const otherChars = str.length - banglaChars;\n    // Average: 1 Bengali token \342\211\210 2 characters, 1 English token \342\211\210 4 characters\n    return Math.max(1, Math.ceil(banglaChars / 2 + otherChars / 4));\n  };\n\n  const promptTokens = countScript(prompt);\n  const completionTokens = countScript(completion);\n  return {\n    promptTokens,\n    completionTokens,\n    totalTokens: promptTokens + completionTokens\n  };\n}\n"
        path {
          absolute_uri: "file:///src/utils/billing.ts"
        }
        overwrite: true
      }
    }
