              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    <label className=\"block font-semibold mb-1\">\340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\247\340\246\276\340\246\260\340\246\243 \340\246\225\340\246\260\340\247\201\340\246\250:</label>"
