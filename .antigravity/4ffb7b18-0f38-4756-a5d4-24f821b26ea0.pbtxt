              text: "          <h2 className=\"text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider font-mono\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            4. Security Architecture & Storage"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
