  view_file {
    absolute_path_uri: "file:///src/db/database.ts"
    start_line: 459
    end_line: 519
    content: "      chats,\n      messages,\n      ai_providers,\n      ai_models,\n      usage_records,\n      settings\n    };\n\n    fs.writeFileSync(this.dataFile, JSON.stringify(initialData, null, 2), \'utf-8\');\n    return initialData;\n  }\n\n  // --- User Operations ---\n  public getUserByEmail(email: string): User | undefined {\n    return this.data.users.find(u => u.email.toLowerCase() === email.toLowerCase());\n  }\n\n  public getUserById(id: string): User | undefined {\n    return this.data.users.find(u => u.id === id);\n  }\n\n  public createUser(userData: {\n    email: string;\n    password: string;\n    name: string;\n    phone?: string;\n    role?: \'user\' | \'admin\';\n  }): User {\n    const now = new Date().toISOString();\n    const newUser: User = {\n      id: `usr_${crypto.randomUUID().slice(0, 8)}`,\n      email: userData.email.toLowerCase(),\n      password_hash: hashPassword(userData.password),\n      name: userData.name,\n      phone: userData.phone || \'\',\n      role: userData.role || \'user\',\n      status: \'active\',\n      usage_limit: this.data.settings.global_usage_limit || 50000,\n      current_usage: 0,\n      created_at: now,\n      updated_at: now\n    };\n    this.data.users.push(newUser);\n    this.save();\n    return newUser;\n  }\n\n  public updateUser(id: string, updates: Partial<User>): User | undefined {\n    const user = this.getUserById(id);\n    if (!user) return undefined;\n\n    Object.assign(user, updates, { updated_at: new Date().toISOString() });\n    this.save();\n    return user;\n  }\n\n  public deleteUser(id: string): boolean {\n    const initialLen = this.data.users.length;\n    this.data.users = this.data.users.filter(u => u.id !== id);\n    this.data.subscriptions = this.data.subscriptions.filter(s => s.user_id !== id);\n    this.data.chats = this.data.chats.filter(c => c.user_id !== id);"
    num_lines: 799
    num_bytes: 23286
    line_range_bytes: 1796
  }
}
