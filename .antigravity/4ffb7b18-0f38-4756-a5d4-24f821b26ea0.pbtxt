  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { X, CheckCircle, ShieldCheck, Copy, Check, ArrowRight, Zap, Sparkles } from \'lucide-react\';\nimport { useAuth } from \'../../context/AuthContext.tsx\';\nimport { PLANS, formatBDT } from \'../../utils/billing.ts\';\n\ninterface PaymentModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  defaultPlan?: \'monthly\' | \'yearly\';\n  onSuccessRedirectToChat?: () => void;\n}\n\nexport const PaymentModal: React.FC<PaymentModalProps> = ({\n  isOpen,\n  onClose,\n  defaultPlan = \'monthly\',\n  onSuccessRedirectToChat\n}) => {\n  const { user, token, refreshUser, openAuthModal } = useAuth();\n  const [selectedPlan, setSelectedPlan] = useState<\'monthly\' | \'yearly\'>(defaultPlan);\n  const [gateway, setGateway] = useState<\'bkash\' | \'nagad\' | \'rocket\' | \'sslcommerz\'>(\'bkash\');\n  const [senderNumber, setSenderNumber] = useState(user?.phone || \'\');\n  const [trxId, setTrxId] = useState(\'\');\n  const [copied, setCopied] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [success, setSuccess] = useState<string | null>(null);\n\n  if (!isOpen) return null;\n\n  const plan = PLANS[selectedPlan];\n  const merchantNumber = \'01711-000000\'; // Bangla AI official merchant simulation\n\n  const handleCopyMerchant = () => {\n    navigator.clipboard.writeText(merchantNumber.replace(/[^0-9]/g, \'\'));\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleQuickTestPayment = () => {\n    setSenderNumber(user?.phone || \'01812345678\');\n    const randomTrx = (gateway === \'bkash\' ? \'BK\' : gateway === \'nagad\' ? \'NG\' : \'RC\') +\n      Math.random().toString(36).substring(2, 9).toUpperCase();\n    setTrxId(randomTrx);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!user || !token) {\n      onClose();\n      openAuthModal(\'login\');\n      return;\n    }\n\n    if (!trxId.trim()) {\n      setError(\'\340\246\246\340\246\257\340\246\274\340\246\276 \340\246\225\340\246\260\340\247\207 \340\246\237\340\247\215\340\246\260\340\246\276\340\246\250\340\246\234\340\247\215\340\246\257\340\246\276\340\246\225\340\246\266\340\246\250 \340\246\206\340\246\207\340\246\241\340\246\277 (TrxID) \340\246\252\340\247\215\340\246\260\340\246\246\340\246\276\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\');\n      return;\n    }\n\n    setError(null);\n    setLoading(true);\n\n    try {\n      const res = await fetch(\'/api/subscription/checkout\', {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({\n          planId: selectedPlan,\n          paymentMethod: gateway,\n          trxId: trxId.trim(),\n          senderNumber: senderNumber || user.phone\n        })\n      });\n\n      const data = await res.json();\n      if (!res.ok) {\n        throw new Error(data.error || \'\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\254\340\247\215\340\246\257\340\246\260\340\247\215\340\246\245 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\');\n      }\n\n      setSuccess(\'\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\270\340\246\253\340\246\262\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207!\');\n      await refreshUser();\n\n      setTimeout(() => {\n        onClose();\n        if (onSuccessRedirectToChat) {\n          onSuccessRedirectToChat();\n        }\n      }, 1500);\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/65 backdrop-blur-sm animate-in fade-in\">\n      <div className=\"relative w-full max-w-xl bg-white dark:bg-gray-800 rounded-3xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors z-10\"\n          aria-label=\"\340\246\254\340\246\250\340\247\215\340\246\247 \340\246\225\340\246\260\340\247\201\340\246\250\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"overflow-y-auto p-6 sm:p-8 space-y-6\">\n          {/* Header */}\n          <div className=\"text-center\">\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-semibold mb-2\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n              <span>\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\217\340\246\206\340\246\207 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\227\340\247\207\340\246\237\340\246\223\340\246\257\340\246\274\340\247\207</span>\n            </div>\n            <h2 className=\"text-2xl font-bold text-gray-900 dark:text-white\">\n              \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\254\340\247\207\340\246\233\340\247\207 \340\246\250\340\246\277\340\246\250 \340\246\217\340\246\254\340\246\202 \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\270\340\246\256\340\247\215\340\246\252\340\246\250\340\247\215\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\n            </h2>\n            <p className=\"text-xs text-gray-500 dark:text-gray-400 mt-1\">\n              \340\246\254\340\246\277\340\246\225\340\246\276\340\246\266, \340\246\250\340\246\227\340\246\246, \340\246\260\340\246\225\340\247\207\340\246\237 \340\246\254\340\246\276 \340\246\225\340\246\276\340\246\260\340\247\215\340\246\241\340\247\207\340\246\260 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256\340\247\207 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\202\340\246\260\340\247\215\340\246\243 \340\246\250\340\246\277\340\246\260\340\246\276\340\246\252\340\246\246 \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237\n            </p>\n          </div>\n\n          {/* Plan Selector */}\n          <div className=\"grid grid-cols-2 gap-3\">\n            <button\n              type=\"button\"\n              onClick={() => setSelectedPlan(\'monthly\')}\n              className={`p-4 rounded-2xl border text-left transition-all ${\n                selectedPlan === \'monthly\'\n                  ? \'border-emerald-600 bg-emerald-50/50 dark:bg-emerald-950/30 ring-2 ring-emerald-500/20\'\n                  : \'border-gray-200 dark:border-gray-700 hover:border-gray-300\'\n              }`}\n            >\n              <div className=\"flex justify-between items-start\">\n                <span className=\"text-xs font-bold text-gray-600 dark:text-gray-400\">\340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250</span>\n                <span className=\"w-4 h-4 rounded-full border flex items-center justify-center border-emerald-600\">\n                  {selectedPlan === \'monthly\' && <span className=\"w-2 h-2 rounded-full bg-emerald-600\" />}\n                </span>\n              </div>\n              <p className=\"text-xl font-extrabold text-gray-900 dark:text-white mt-1\">\n                {formatBDT(PLANS.monthly.priceBDT)}\n                <span className=\"text-xs font-normal text-gray-500\"> /\340\246\256\340\246\276\340\246\270</span>\n              </p>\n              <p className=\"text-[11px] text-gray-500 mt-1\">\340\247\251\340\247\246 \340\246\246\340\246\277\340\246\250\340\247\207\340\246\260 \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246 \342\200\242 \340\247\253\340\247\246,\340\247\246\340\247\246\340\247\246 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250</p>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setSelectedPlan(\'yearly\')}\n              className={`p-4 rounded-2xl border text-left transition-all relative ${\n                selectedPlan === \'yearly\'\n                  ? \'border-emerald-600 bg-emerald-50/50 dark:bg-emerald-950/30 ring-2 ring-emerald-500/20\'\n                  : \'border-gray-200 dark:border-gray-700 hover:border-gray-300\'\n              }`}\n            >\n              <span className=\"absolute -top-2.5 right-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-xs\">\n                \340\247\251\340\247\254% \340\246\270\340\246\276\340\246\266\340\247\215\340\246\260\340\246\257\340\246\274!\n              </span>\n              <div className=\"flex justify-between items-start\">\n                <span className=\"text-xs font-bold text-gray-600 dark:text-gray-400\">\340\246\254\340\246\276\340\247\216\340\246\270\340\246\260\340\246\277\340\246\225 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250</span>\n                <span className=\"w-4 h-4 rounded-full border flex items-center justify-center border-emerald-600\">\n                  {selectedPlan === \'yearly\' && <span className=\"w-2 h-2 rounded-full bg-emerald-600\" />}\n                </span>\n              </div>\n              <p className=\"text-xl font-extrabold text-gray-900 dark:text-white mt-1\">\n                {formatBDT(PLANS.yearly.priceBDT)}\n                <span className=\"text-xs font-normal text-gray-500\"> /\340\246\254\340\246\233\340\246\260</span>\n              </p>\n              <p className=\"text-[11px] text-gray-500 mt-1\">\340\247\251\340\247\254\340\247\253 \340\246\246\340\246\277\340\246\250\340\247\207\340\246\260 \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246 \342\200\242 \340\247\255,\340\247\253\340\247\246,\340\247\246\340\247\246\340\247\246 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250</p>\n            </button>\n          </div>\n\n          {/* Payment Gateway Picker */}\n          <div>\n            <label className=\"block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2\">\n              \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256 \340\246\254\340\247\207\340\246\233\340\247\207 \340\246\250\340\246\277\340\246\250:\n            </label>\n            <div className=\"grid grid-cols-4 gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => setGateway(\'bkash\')}\n                className={`py-2.5 px-2 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all ${\n                  gateway === \'bkash\'\n                    ? \'border-[#E2136E] bg-pink-50/50 dark:bg-pink-950/20 ring-1 ring-[#E2136E]\'\n                    : \'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50\'\n                }`}\n              >\n                <div className=\"w-6 h-6 rounded-full bg-[#E2136E] flex items-center justify-center text-white font-black text-xs\">\n                  b\n                </div>\n                <span className=\"text-xs font-bold text-gray-800 dark:text-gray-200\">\340\246\254\340\246\277\340\246\225\340\246\276\340\246\266</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setGateway(\'nagad\')}\n                className={`py-2.5 px-2 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all ${\n                  gateway === \'nagad\'\n                    ? \'border-[#F7941D] bg-orange-50/50 dark:bg-orange-950/20 ring-1 ring-[#F7941D]\'\n                    : \'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50\'\n                }`}\n              >\n                <div className=\"w-6 h-6 rounded-full bg-[#F7941D] flex items-center justify-center text-white font-black text-xs\">\n                  \340\246\250\n                </div>\n                <span className=\"text-xs font-bold text-gray-800 dark:text-gray-200\">\340\246\250\340\246\227\340\246\246</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setGateway(\'rocket\')}\n                className={`py-2.5 px-2 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all ${\n                  gateway === \'rocket\'\n                    ? \'border-[#8C3494] bg-purple-50/50 dark:bg-purple-950/20 ring-1 ring-[#8C3494]\'\n                    : \'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50\'\n                }`}\n              >\n                <div className=\"w-6 h-6 rounded-full bg-[#8C3494] flex items-center justify-center text-white font-black text-xs\">\n                  R\n                </div>\n                <span className=\"text-xs font-bold text-gray-800 dark:text-gray-200\">\340\246\260\340\246\225\340\247\207\340\246\237</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setGateway(\'sslcommerz\')}\n                className={`py-2.5 px-2 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all ${\n                  gateway === \'sslcommerz\'\n                    ? \'border-blue-600 bg-blue-50/50 dark:bg-blue-950/20 ring-1 ring-blue-600\'\n                    : \'border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50\'\n                }`}\n              >\n                <div className=\"w-6 h-6 rounded-full bg-blue-600 flex items-center justify-center text-white font-black text-xs\">\n                  \360\237\222\263\n                </div>\n                <span className=\"text-xs font-bold text-gray-800 dark:text-gray-200\">\340\246\225\340\246\276\340\246\260\340\247\215\340\246\241</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Payment Instructions Box */}\n          <div className=\"bg-gray-50 dark:bg-gray-900/70 rounded-2xl p-4 border border-gray-200 dark:border-gray-700 text-xs text-gray-700 dark:text-gray-300 space-y-2\">\n            <p className=\"font-semibold text-gray-900 dark:text-white flex items-center gap-1.5\">\n              <span>\340\247\247. \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 {gateway === \'bkash\' ? \'\340\246\254\340\246\277\340\246\225\340\246\276\340\246\266\' : gateway === \'nagad\' ? \'\340\246\250\340\246\227\340\246\246\' : gateway === \'rocket\' ? \'\340\246\260\340\246\225\340\247\207\340\246\237\' : \'\340\246\225\340\246\276\340\246\260\340\247\215\340\246\241\'} \340\246\205\340\247\215\340\246\257\340\246\276\340\246\252 \340\246\223\340\246\252\340\247\207\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250:</span>\n            </p>\n            <div className=\"flex items-center justify-between bg-white dark:bg-gray-800 p-2.5 rounded-xl border border-gray-200 dark:border-gray-700\">\n              <div>\n                <span className=\"text-[10px] text-gray-500 block\">\340\246\256\340\246\276\340\246\260\340\247\215\340\246\232\340\247\207\340\246\250\340\247\215\340\246\237 / \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260:</span>\n                <span className=\"font-mono text-sm font-bold text-gray-900 dark:text-white\">{merchantNumber}</span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handleCopyMerchant}\n                className=\"px-2.5 py-1 text-xs bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg font-medium flex items-center gap-1 transition-colors\"\n              >\n                {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copied ? \'\340\246\225\340\246\252\340\246\277 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\' : \'\340\246\225\340\246\252\340\246\277 \340\246\225\340\246\260\340\247\201\340\246\250\'}</span>\n              </button>\n            </div>\n            <p>\n              \340\247\250. \340\246\237\340\246\276\340\246\225\340\246\276\340\246\260 \340\246\252\340\246\260\340\246\277\340\246\256\340\246\276\340\246\243 \340\246\246\340\246\277\340\246\250: <strong className=\"text-emerald-600 font-bold\">{formatBDT(plan.priceBDT)}</strong>\n            </p>\n            <p>\n              \340\247\251. \340\246\262\340\247\207\340\246\250\340\246\246\340\247\207\340\246\250 \340\246\270\340\246\256\340\247\215\340\246\252\340\246\250\340\247\215\340\246\250 \340\246\225\340\246\260\340\246\276\340\246\260 \340\246\252\340\246\260 \340\246\250\340\246\277\340\246\232\340\247\207\340\246\260 \340\246\254\340\246\225\340\247\215\340\246\270\340\247\207 \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 <strong>\340\246\252\340\247\215\340\246\260\340\247\207\340\246\260\340\246\225 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260</strong> \340\246\217\340\246\254\340\246\202 \340\246\252\340\247\215\340\246\260\340\246\276\340\246\252\340\247\215\340\246\244 <strong>Transaction ID (TrxID)</strong> \340\246\246\340\246\277\340\246\250\340\245\244\n            </p>\n          </div>\n\n          {/* Test Fill Helper */}\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[11px] text-gray-500\">\340\246\237\340\247\207\340\246\270\340\247\215\340\246\237 \340\246\256\340\247\213\340\246\241 \340\246\217\340\246\225\340\247\215\340\246\237\340\246\277\340\246\255:</span>\n            <button\n              type=\"button\"\n              onClick={handleQuickTestPayment}\n              className=\"text-[11px] text-emerald-600 dark:text-emerald-400 hover:underline font-semibold flex items-center gap-1\"\n            >\n              <Zap className=\"w-3 h-3 text-amber-500 fill-amber-500\" />\n              <span>\340\246\237\340\247\207\340\246\270\340\247\215\340\246\237 TrxID \340\246\205\340\246\237\340\247\213-\340\246\253\340\246\277\340\246\262 \340\246\225\340\246\260\340\247\201\340\246\250</span>\n            </button>\n          </div>\n\n          {/* Verification Form */}\n          <form onSubmit={handleSubmit} className=\"space-y-3.5\">\n            {error && (\n              <div className=\"p-3 text-xs bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 rounded-xl\">\n                {error}\n              </div>\n            )}\n\n            {success && (\n              <div className=\"p-3 text-xs bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 rounded-xl flex items-center gap-2\">\n                <CheckCircle className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                <span>{success}</span>\n              </div>\n            )}\n\n            <div>\n              <label className=\"block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1\">\n                \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\256\340\247\213\340\246\254\340\246\276\340\246\207\340\246\262 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260 *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={senderNumber}\n                onChange={e => setSenderNumber(e.target.value)}\n                placeholder=\"\340\246\257\340\247\207\340\246\256\340\246\250: 01812345678\"\n                className=\"w-full px-3 py-2 text-sm rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1\">\n                \340\246\237\340\247\215\340\246\260\340\246\276\340\246\250\340\246\234\340\247\215\340\246\257\340\246\276\340\246\225\340\246\266\340\246\250 \340\246\206\340\246\207\340\246\241\340\246\277 (TrxID) *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={trxId}\n                onChange={e => setTrxId(e.target.value)}\n                placeholder=\"\340\246\257\340\247\207\340\246\256\340\246\250: BKB8792019X\"\n                className=\"w-full px-3 py-2 text-sm rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white font-mono uppercase focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"w-full py-3 px-4 rounded-xl font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 disabled:opacity-50\"\n            >\n              {loading ? (\n                <span className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n              ) : (\n                <>\n                  <ShieldCheck className=\"w-4 h-4\" />\n                  <span>\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\257\340\246\276\340\246\232\340\246\276\340\246\207 \340\246\223 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\232\340\246\276\340\246\262\340\247\201 \340\246\225\340\246\260\340\247\201\340\246\250</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </>\n              )}\n            </button>\n          </form>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
