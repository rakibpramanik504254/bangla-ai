              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            User credentials and database entities are protected using role-based access control (RBAC), environment-level secret isolation, and secure HMAC token verification. All sensitive external API keys are maintained exclusively on server-side clusters and are never exposed to browser runtimes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
