      thinking_signature: "\022\347\b\n\344\b\001i\024}\023\223g\257\272\234W\376\246\270<r\210\370\244L\026\337#\223\373P\265.H\246\f\207@~\372wI(\342X\"\254o\250.\306\347B6\240\375\230#aC\213\035(,\r\377\254\377-\005\b\207*c\227%\301\234w%\0167\213\352\032<P\016\"\225#~\365\266\017C\032\367\272\372\315\271g\204\313&l\334\036\361\344\363\364Q\214\257\006fN\255\347GwY%b2\242I9\266\371hS\275\364w\205\361j^\033\022\022\201\203M\230;\326\245\b\236,\265\274\234\331(p\021,\330\313l\374\365\355U\237b\327@\327s\275\213m3\272\234\256\206\034AGV\225Z\207\241\344I\237\355i3\202\372P\307s\b\357\203\255\363]\322a\211\2606\264\221JSP7\265@\017\345\223\320\371\0043<\320\233\370\241\017\340J\224k\306\210\275u\342\030\303\215\034\271\351w\031\311\345O\377\253\333\a\273\227\323\204C x\023\233lX\0309#\251*\252\372>\347\376`h\370\001D\030\371}\306\222\204n}0e\220D\370\263\234_\247\017z\224Z\207\276\330\224\244[8\"K\2129\372\327\361\363\275\270\343\251:\211\317;I\177x{j\f\272b\r\337\243I\221\303>4\326\035$C\023v-\335\033\325\210;\330Z&\r[0\355\n\207(\235^\3535\353v\212\327\316\263\f\342\000#BR`\305I)\322}.\376\230\376\207~\351\303v~\376\031\3200\270$\223@\215\340\302\346iE\206#j\rae\362\235t\023.\314\365t+\375R\301\352\273\256\216\322\032\302]Y\031\346\340\203)H\234\260\367Rq_\336n\367\263?\3550nc\b\236>\334\306\303yW\353\313\311\227\223\203\215-\342\f\212\024\246\240\253\245f\264Q\275\352\244X\351c~\2647m\223=\205\n\241\235\244\350\330\206\274\032\261O\266\2615\034$\213\3112,\006\362\2474\330vK\031\376Y\276n?s|9\272\204i\261\271\371\356\001\356P\365ZBt\210\vE;C])\"\266qv\2271Y$\304\000\207\307\325_9\345\256\026\330\321h\317\241\321\017\250\345jP\027\216\361p9\237l\314T\356\255|\250-n\036\2150\'\342\267g\232\225I\364\373[\353\204%\247\232\032\366,\273\024\\1\036\250\276\f3f%0;\2009\347?\320\032E@E\274\035\322\bR\320\273\301\337\322\003m\222Q\305\022\361\376\021\342\364\345\340K;\343\031\352>\352\374\366:P\026s\263R\023aS\017\231\365tF\313\341\004\355\004\026\212\351\263\341K\321\300Rd\