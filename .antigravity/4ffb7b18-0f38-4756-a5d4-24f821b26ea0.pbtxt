            lines {
              text: "                  \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200\340\246\225\340\247\207 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\252\340\247\215\340\246\260\340\246\246\340\246\276\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250"
