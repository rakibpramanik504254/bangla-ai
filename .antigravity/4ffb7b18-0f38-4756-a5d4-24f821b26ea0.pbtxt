            lines {
              text: "            <li><strong>\340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237 \340\246\270\340\246\256\340\247\215\340\246\252\340\246\260\340\247\215\340\246\225\340\246\277\340\246\244 \340\246\244\340\246\245\340\247\215\340\246\257:</strong> \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\250\340\246\276\340\246\256, \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\247\215\340\246\260\340\247\207\340\246\270, \340\246\252\340\246\276\340\246\270\340\246\223\340\246\257\340\246\274\340\246\276\340\246\260\340\247\215\340\246\241\340\247\207\340\246\260 \340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\247\215\340\246\237\340\247\213\340\246\227\340\247\215\340\246\260\340\246\276\340\246\253\340\246\277\340\246\225 \340\246\271\340\247\215\340\246\257\340\246\276\340\246\266 (Cryptographic Scrypt Hash), \340\246\217\340\246\254\340\246\202 \340\246\257\340\247\213\340\246\227\340\246\276\340\246\257\340\247\213\340\246\227\340\247\207\340\246\260 \340\246\256\340\247\213\340\246\254\340\246\276\340\246\207\340\246\262 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260\340\245\244</li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <li><strong>\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\223 \340\246\254\340\246\277\340\246\262\340\246\277\340\246\202 \340\246\270\340\246\202\340\246\225\340\247\215\340\246\260\340\246\276\340\246\250\340\247\215\340\246\244 \340\246\244\340\246\245\340\247\215\340\246\257:</strong> \340\246\254\340\246\277\340\246\225\340\246\276\340\246\266, \340\246\250\340\246\227\340\246\246, \340\246\260\340\246\225\340\247\207\340\246\237 \340\246\254\340\246\276 \340\246\225\340\246\276\340\246\260\340\247\215\340\246\241\340\247\207\340\246\260 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256\340\247\207 \340\246\252\340\247\215\340\246\260\340\246\246\340\246\244\340\247\215\340\246\244 \340\246\237\340\247\215\340\246\260\340\246\276\340\246\250\340\246\234\340\247\215\340\246\257\340\246\276\340\246\225\340\246\266\340\246\250 \340\246\206\340\246\207\340\246\241\340\246\277 (TrxID), \340\246\252\340\247\215\340\246\260\340\247\207\340\246\260\340\246\225\340\247\207\340\246\260 \340\246\206\340\246\202\340\246\266\340\246\277\340\246\225 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260, \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\277\340\246\244 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\223 \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237\340\247\207\340\246\260 \340\246\244\340\246\276\340\246\260\340\246\277\340\246\226\340\245\244 \340\246\206\340\246\256\340\246\260\340\246\276 \340\246\225\340\246\226\340\246\250\340\247\213 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\246\225\340\246\276\340\246\260\340\247\200\340\246\260