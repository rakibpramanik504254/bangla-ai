            }
            lines {
              text: "        role: \'assistant\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        content: `Launching a successful, scalable e-commerce venture in Bangladesh requires a structured strategy across four core pillars:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### 1. Legal & Regulatory Compliance"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* **Trade License:** Obtain from your respective City Corporation or Union Parishad."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* **e-TIN & BIN:** Register for tax identification and VAT compliance with the NBR."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* **DBID (Digital Business ID):** Mandatory registration from the Ministry of Commerce."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### 2. Payment Infrastructure"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* **Mobile Financial Services (MFS):** Integrate direct merchant accounts with bKash and Nagad (covering >80% of digital transactions)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* **Payment Gateway Aggregators:** SSLCommerz or Shurjopay for Visa, Mastercard, and internet banking."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### 3. Last-Mile Logistics & Fulfillment"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* Partner with dependable courier networks such as Pathao Courier, Steadfast, or RedX with automated API tracking."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* Set up a clear Reverse Logistics & Return Management SOP."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### 4. Digital Marketing & Customer Retention"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* Run targeted Meta Ads with engaging video content and WhatsApp/Messenger chat conversion funnels."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "* Offer reliable Cash on Delivery (COD) alongside frictionless MFS pre-payments.`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        model_id: \'mod_gemini_2_5_flash\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
