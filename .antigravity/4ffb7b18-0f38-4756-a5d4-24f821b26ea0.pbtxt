        use_fast_apply: true
        replacement_chunks {
          target_content: "# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n"
          replacement_content: "# Bangla AI (\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\217\340\246\206\340\246\207) Environment Configuration Template\n\n# Server & Port Configuration\nPORT=3000\nNODE_ENV=\"development\"\nAPP_URL=\"https://ais-dev-viywiqxns7sqv4qvsjio2j-517651776127.asia-east1.run.app\"\n\n# Session & Security\n# Secret key used for signing session tokens and hashing\nAUTH_SECRET=\"bangla-ai-secret-salt-super-secure-key-2026\"\n\n# Default Model Provider Keys (Placeholders to be configured by the owner or in the Admin Panel)\n# Google Gemini API Key (Can be auto-injected from AI Studio secrets or set here)\nGEMINI_API_KEY=\"AIzaSy_YOUR_GEMINI_API_KEY_HERE\"\n\n# OpenAI API Key (Optional default, also configurable in Admin Panel)\nOPENAI_API_KEY=\"sk-proj-YOUR_OPENAI_API_KEY_HERE\"\n\n# Anthropic Claude API Key (Optional default, also configurable in Admin Panel)\nANTHROPIC_API_KEY=\"sk-ant-YOUR_ANTHROPIC_API_KEY_HERE\"\n\n# DeepSeek API Key (Optional default, also configurable in Admin Panel)\nDEEPSEEK_API_KEY=\"sk-YOUR_DEEPSEEK_API_KEY_HERE\"\n\n# Bangladeshi Payment Gateway Configuration (Placeholders)\n# bKash Merchant API Credentials\nBKASH_APP_KEY=\"your_bkash_app_key\"\nBKASH_APP_SECRET=\"your_bkash_app_secret\"\nBKASH_USERNAME=\"your_bkash_username\"\nBKASH_PASSWORD=\"your_bkash_password\"\nBKASH_BASE_URL=\"https://tokenized.sandbox.bka.sh/v1.2.0-beta\"\n\n# Nagad Merchant Credentials\nNAGAD_MERCHANT_ID=\"your_nagad_merchant_id\"\nNAGAD_PUBLIC_KEY=\"your_nagad_public_key\"\nNAGAD_PRIVATE_KEY=\"your_nagad_private_key\"\n\n# SSLCommerz Credentials\nSSLCOMMERZ_STORE_ID=\"your_sslcommerz_store_id\"\nSSLCOMMERZ_STORE_PASS=\"your_sslcommerz_store_password\"\nSSLCOMMERZ_IS_SANDBOX=true\n\n# Database Path (Local persistent storage file or PostgreSQL connection)\nDATABASE_FILE=\"data/bangla_ai.json\""
          start_line: 1
          end_line: 9
        }
      }
    }
