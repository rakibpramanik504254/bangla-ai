  planner_response {
    thinking: "**Constructing User Account Page**\n\nI\'m now focused on building the User Account Page, specifically `src/components/pages/AccountPage.tsx`. I\'ve outlined the core features: Profile information, subscription status, plan details, and a usage meter. The goal is to present this data clearly and effectively on the user\'s account page. I\342\200\231m currently pondering the best data structure to store this for the display.\n\n\n"
    tool_calls {
      id: "call_16533505195874488161"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport {\\n  User,\\n  CreditCard,\\n  Shield,\\n  Clock,\\n  Zap,\\n  CheckCircle,\\n  AlertCircle,\\n  ArrowUpRight,\\n  RefreshCw,\\n  Phone,\\n  Mail,\\n  Calendar,\\n  Sparkles\\n} from \'lucide-react\';\\nimport { useAuth } from \'../../context/AuthContext.tsx\';\\nimport { formatBDT, toBanglaDigits, isSubscriptionActive } from \'../../utils/billing.ts\';\\nimport { Payment } from \'../../types/index.ts\';\\n\\nexport const AccountPage: React.FC = () => {\\n  const { user, token, refreshUser, openPaymentModal } = useAuth();\\n  const [payments, setPayments] = useState<Payment[]>([]);\\n  const [loadingPayments, setLoadingPayments] = useState(true);\\n\\n  useEffect(() => {\\n    const fetchPayments = async () => {\\n      if (!token) return;\\n      try {\\n        const res = await fetch(\'/api/payments/history\', {\\n          headers: { Authorization: `Bearer ${token}` }\\n        });\\n        if (res.ok) {\\n          const data = await res.json();\\n          setPayments(data);\\n        }\\n      } catch (err) {\\n        console.error(\'Failed to load payment history:\', err);\\n      } finally {\\n        setLoadingPayments(false);\\n      }\\n    };\\n    fetchPayments();\\n  }, [token]);\\n\\n  if (!user) {\\n    return (\\n      <div className=\\\"max-w-2xl mx-auto px-4 py-20 text-center\\\">\\n        <AlertCircle className=\\\"w-12 h-12 text-amber-500 mx-auto mb-3\\\" />\\n        <h2 className=\\\"text-xl font-bold text-gray-900 dark:text-white\\\">\340\246\262\340\246\227\340\246\207\340\246\250 \340\246\252\340\247\215\340\246\260\340\246\257\340\246\274\340\247\213\340\246\234\340\246\250</h2>\\n        <p className=\\\"text-xs text-gray-500 mt-1\\\">\340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\252\340\247\215\340\246\260\340\247\213\340\246\253\340\246\276\340\246\207\340\246\262 \340\246\246\340\247\207\340\246\226\340\246\244\340\247\207 \340\246\205\340\246\250\340\247\201\340\246\227\340\247\215\340\246\260\340\246\271 \340\246\225\340\246\260\340\247\207 \340\246\262\340\246\227\340\246\207\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244</p>\\n      </div>\\n    );\\n  }\\n\\n  const sub = user.subscription;\\n  const active = user.role === \'admin\' || isSubscriptionActive(sub);\\n  const remainingTokens = Math.max(0, user.usage_limit - user.current_usage);\\n  const usagePercent = Math.min(100, Math.round((user.current_usage / Math.max(1, user.usage_limit)) * 100));\\n\\n  return (\\n    <div className=\\\"max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-8 animate-in fade-in\\\">\\n      {/* Title */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 dark:border-gray-800 pb-5\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white\\\">\\n            \340\246\206\340\246\256\340\246\276\340\246\260 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\225\340\246\276\340\246\211\340\246\250\340\247\215\340\246\237 \340\246\223 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250\\n          </h1>\\n          <p className=\\\"text-xs text-gray-500 mt-1\\\">\\n            \340\246\206\340\246\252\340\246\250\340\246\276\340\246\260 \340\246\252\340\247\215\340\246\260\340\247\213\340\246\253\340\246\276\340\246\207\340\246\262 \340\246\244\340\246\245\340\247\215\340\246\257, \340\246\254\340\246\260\340\247\215\340\246\244\340\246\256\340\246\276\340\246\250 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250\340\247\207\340\246\260 \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246 \340\246\217\340\246\254\340\246\202 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\254\340\246\277\340\246\254\340\246\260\340\246\243\\n          </p>\\n        </div>\\n        <button\\n          onClick={() => refreshUser()}\\n          className=\\\"self-start sm:self-auto px-3 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 text-xs font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-1.5 transition-colors\\\"\\n        >\\n          <RefreshCw className=\\\"w-3.5 h-3.5\\\" />\\n          <span>\340\246\260\340\246\277\340\246\253\340\247\215\340\246\260\340\247\207\340\246\266</span>\\n        </button>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-6\\\">\\n        {/* Profile Card */}\\n        <div className=\\\"bg-white dark:bg-gray-800 rounded-3xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm space-y-4\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-12 h-12 rounded-2xl bg-emerald-600 text-white font-bold text-lg flex items-center justify-center shadow-md\\\">\\n              {user.name.slice(0, 1).toUpperCase()}\\n            </div>\\n            <div>\\n              <h3 className=\\\"font-bold text-gray-900 dark:text-white text-base\\\">{user.name}</h3>\\n              <span className=\\\"text-[11px] font-semibold px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300\\\">\\n                {user.role === \'admin\' ? \'\340\246\270\340\246\277\340\246\270\340\247\215\340\246\237\340\247\207\340\246\256 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\241\340\246\256\340\246\277\340\246\250\' : \'\340\246\270\340\246\246\340\246\270\340\247\215\340\246\257\'}\\n              </span>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"space-y-2.5 pt-3 border-t border-gray-100 dark:border-gray-700 text-xs\\\">\\n            <div className=\\\"flex items-center gap-2 text-gray-600 dark:text-gray-300\\\">\\n              <Mail className=\\\"w-4 h-4 text-gray-400 shrink-0\\\" />\\n              <span className=\\\"truncate\\\">{user.email}</span>\\n            </div>\\n            <div className=\\\"flex items-center gap-2 text-gray-600 dark:text-gray-300\\\">\\n              <Phone className=\\\"w-4 h-4 text-gray-400 shrink-0\\\" />\\n              <span>{user.phone || \'\340\246\253\340\247\213\340\246\250 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260 \340\246\270\340\246\202\340\246\257\340\247\201\340\246\225\340\247\215\340\246\244 \340\246\250\340\247\207\340\246\207\'}</span>\\n            </div>\\n            <div className=\\\"flex items-center gap-2 text-gray-600 dark:text-gray-300\\\">\\n              <Shield className=\\\"w-4 h-4 text-emerald-500 shrink-0\\\" />\\n              <span>\340\246\270\340\247\215\340\246\237\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\270: <strong className=\\\"text-emerald-600 dark:text-emerald-400\\\">\340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 (Active)</strong></span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Subscription Status Card */}\\n        <div className=\\\"md:col-span-2 bg-white dark:bg-gray-800 rounded-3xl p-6 sm:p-7 border border-gray-200 dark:border-gray-700 shadow-sm flex flex-col justify-between\\\">\\n          <div>\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 mb-4\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <CreditCard className=\\\"w-5 h-5 text-emerald-600\\\" />\\n                <h3 className=\\\"font-bold text-gray-900 dark:text-white text-lg\\\">\340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\270\340\247\215\340\246\237\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\270</h3>\\n              </div>\\n              <span\\n                className={`text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1.5 ${\\n                  active\\n                    ? \'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300\'\\n                    : \'bg-red-100 dark:bg-red-950/60 text-red-800 dark:text-red-300\'\\n                }`}\\n              >\\n                {active ? (\\n                  <>\\n                    <CheckCircle className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                    <span>\340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <AlertCircle className=\\\"w-3.5 h-3.5 text-red-600\\\" />\\n                    <span>\340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\250\340\247\207\340\246\207 \340\246\254\340\246\276 \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246\340\247\213\340\246\244\340\247\215\340\246\244\340\247\200\340\246\260\340\247\215\340\246\243</span>\\n                  </>\\n                )}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2\\\">\\n              <div className=\\\"bg-gray-50 dark:bg-gray-900/50 p-3.5 rounded-2xl border border-gray-200/70 dark:border-gray-700/70\\\">\\n                <span className=\\\"text-[11px] text-gray-500 block\\\">\340\246\254\340\246\260\340\247\215\340\246\244\340\246\256\340\246\276\340\246\250 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250:</span>\\n                <p className=\\\"font-extrabold text-sm sm:text-base text-gray-900 dark:text-white mt-0.5\\\">\\n                  {sub ? sub.plan_name : \'\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\250\340\247\207\340\246\207\'}\\n                </p>\\n                {sub && (\\n                  <span className=\\\"text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold\\\">\\n                    {formatBDT(sub.amount)}\\n                  </span>\\n                )}\\n              </div>\\n\\n              <div className=\\\"bg-gray-50 dark:bg-gray-900/50 p-3.5 rounded-2xl border border-gray-200/70 dark:border-gray-700/70\\\">\\n                <span className=\\\"text-[11px] text-gray-500 block\\\">\340\246\252\340\246\260\340\246\254\340\246\260\340\247\215\340\246\244\340\247\200 \340\246\260\340\246\277\340\246\250\340\246\277\340\246\211 / \340\246\256\340\247\207\340\246\257\340\246\274\340\246\276\340\246\246:</span>\\n                <p className=\\\"font-extrabold text-sm sm:text-base text-gray-900 dark:text-white mt-0.5\\\">\\n                  {sub?.expires_at ? new Date(sub.expires_at).toLocaleDateString(\'bn-BD\', {\\n                    day: \'numeric\',\\n                    month: \'long\',\\n                    year: \'numeric\'\\n                  }) : \'\342\200\224\'}\\n                </p>\\n                <span className=\\\"text-[10px] text-gray-400\\\">\\n                  {sub?.expires_at ? toBanglaDigits(new Date(sub.expires_at).toLocaleTimeString(\'bn-BD\')) : \'\340\246\252\340\247\215\340\246\260\340\246\257\340\247\213\340\246\234\340\247\215\340\246\257 \340\246\250\340\246\257\340\246\274\'}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"bg-gray-50 dark:bg-gray-900/50 p-3.5 rounded-2xl border border-gray-200/70 dark:border-gray-700/70\\\">\\n                <span className=\\\"text-[11px] text-gray-500 block\\\">\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256:</span>\\n                <p className=\\\"font-extrabold text-sm sm:text-base text-gray-900 dark:text-white mt-0.5 uppercase\\\">\\n                  {sub?.payment_method || \'\342\200\224\'}\\n                </p>\\n                <span className=\\\"text-[10px] text-gray-400 font-mono truncate block\\\">\\n                  {sub?.trx_id ? `Trx: ${sub.trx_id}` : \'\'}\\n                </span>\\n              </div>\\n            </div>\\n\\n            {/* Usage Progress Bar */}\\n            <div className=\\\"mt-6 space-y-2\\\">\\n              <div className=\\\"flex justify-between text-xs\\\">\\n                <span className=\\\"font-semibold text-gray-700 dark:text-gray-300\\\">\\n                  \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\271\340\246\277\340\246\270\340\246\276\340\246\254:\\n                </span>\\n                <span className=\\\"font-bold text-gray-900 dark:text-white\\\">\\n                  \340\246\254\340\246\276\340\246\225\340\246\277 \340\246\206\340\246\233\340\247\207 <strong className=\\\"text-emerald-600 dark:text-emerald-400\\\">{toBanglaDigits(remainingTokens.toLocaleString())}</strong> / {toBanglaDigits(user.usage_limit.toLocaleString())} \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250 ({toBanglaDigits(usagePercent)}% \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\247\203\340\246\244)\\n                </span>\\n              </div>\\n              <div className=\\\"w-full h-3 rounded-full bg-gray-100 dark:bg-gray-700 overflow-hidden\\\">\\n                <div\\n                  className={`h-full rounded-full transition-all duration-500 ${\\n                    usagePercent > 85 ? \'bg-red-500\' : usagePercent > 60 ? \'bg-amber-500\' : \'bg-emerald-500\'\\n                  }`}\\n                  style={{ width: `${usagePercent}%` }}\\n                />\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-wrap items-center justify-between gap-3\\\">\\n            <span className=\\\"text-xs text-gray-500\\\">\\n              \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\206\340\246\252\340\246\227\340\247\215\340\246\260\340\247\207\340\246\241 \340\246\254\340\246\276 \340\246\260\340\246\277\340\246\250\340\246\277\340\246\211 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\232\340\246\276\340\246\250?\\n            </span>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                onClick={() => openPaymentModal(\'monthly\')}\\n                className=\\\"px-4 py-2 rounded-xl text-xs font-bold bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white transition-colors\\\"\\n              >\\n                \340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 \340\246\260\340\246\277\340\246\250\340\246\277\340\246\211 (\340\247\263\340\247\247,\340\247\250\340\247\257\340\247\257)\\n              </button>\\n              <button\\n                onClick={() => openPaymentModal(\'yearly\')}\\n                className=\\\"px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all\\\"\\n              >\\n                \340\246\254\340\246\276\340\247\216\340\246\270\340\246\260\340\246\277\340\246\225 \340\246\206\340\246\252\340\246\227\340\247\215\340\246\260\340\247\207\340\246\241 (\340\247\263\340\247\257,\340\247\257\340\247\257\340\247\257 - \340\247\251\340\247\254% \340\246\270\340\246\276\340\246\266\340\247\215\340\246\260\340\246\257\340\246\274)\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Payment History Table */}\\n      <div className=\\\"bg-white dark:bg-gray-800 rounded-3xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <h3 className=\\\"font-bold text-gray-900 dark:text-white text-base flex items-center gap-2\\\">\\n            <Calendar className=\\\"w-4 h-4 text-emerald-600\\\" />\\n            <span>\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\223 \340\246\207\340\246\250\340\246\255\340\246\257\340\246\274\340\247\207\340\246\270 \340\246\271\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\246\277</span>\\n          </h3>\\n          <span className=\\\"text-xs text-gray-500\\\">\340\246\256\340\247\213\340\246\237 \340\246\262\340\247\207\340\246\250\340\246\246\340\247\207\340\246\250: {toBanglaDigits(payments.length)}\340\246\237\340\246\277</span>\\n        </div>\\n\\n        {loadingPayments ? (\\n          <div className=\\\"py-8 text-center text-xs text-gray-400\\\">\340\246\244\340\246\245\340\247\215\340\246\257 \340\246\262\340\247\213\340\246\241 \340\246\271\340\246\232\340\247\215\340\246\233\340\247\207...</div>\\n        ) : payments.length === 0 ? (\\n          <div className=\\\"py-8 text-center text-xs text-gray-500\\\">\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\252\340\247\202\340\246\260\340\247\215\340\246\254\340\246\254\340\246\260\340\247\215\340\246\244\340\247\200 \340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\260\340\247\207\340\246\225\340\246\260\340\247\215\340\246\241 \340\246\250\340\247\207\340\246\207\340\245\244</div>\\n        ) : (\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left text-xs\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-gray-100 dark:border-gray-700 text-gray-400\\\">\\n                  <th className=\\\"pb-3 font-semibold\\\">\340\246\244\340\246\276\340\246\260\340\246\277\340\246\226</th>\\n                  <th className=\\\"pb-3 font-semibold\\\">\340\246\252\340\247\207\340\246\256\340\247\207\340\246\250\340\247\215\340\246\237 \340\246\256\340\246\276\340\246\247\340\247\215\340\246\257\340\246\256</th>\\n                  <th className=\\\"pb-3 font-semibold\\\">\340\246\237\340\247\215\340\246\260\340\246\276\340\246\250\340\246\234\340\247\215\340\246\257\340\246\276\340\246\225\340\246\266\340\246\250 \340\246\206\340\246\207\340\246\241\340\246\277 (TrxID)</th>\\n                  <th className=\\\"pb-3 font-semibold\\\">\340\246\237\340\246\276\340\246\225\340\246\276\340\246\260 \340\246\252\340\246\260\340\246\277\340\246\256\340\246\276\340\246\243</th>\\n                  <th className=\\\"pb-3 font-semibold\\\">\340\246\270\340\247\215\340\246\237\340\247\215\340\246\257\340\246\276\340\246\237\340\246\276\340\246\270</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-gray-100 dark:divide-gray-700/60\\\">\\n                {payments.map(p => (\\n                  <tr key={p.id} className=\\\"hover:bg-gray-50 dark:hover:bg-gray-900/30\\\">\\n                    <td className=\\\"py-3 text-gray-600 dark:text-gray-300\\\">\\n                      {new Date(p.created_at).toLocaleDateString(\'bn-BD\')}\\n                    </td>\\n                    <td className=\\\"py-3 font-semibold text-gray-900 dark:text-white uppercase\\\">\\n                      {p.gateway}\\n                    </td>\\n                    <td className=\\\"py-3 font-mono text-gray-700 dark:text-gray-300\\\">\\n                      {p.trx_id}\\n                    </td>\\n                    <td className=\\\"py-3 font-bold text-emerald-600 dark:text-emerald-400\\\">\\n                      {formatBDT(p.amount)}\\n                    </td>\\n                    <td className=\\\"py-3\\\">\\n                      <span className=\\\"px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold\\\">\\n                        \340\246\270\340\246\256\340\247\215\340\246\252\340\246\250\340\247\215\340\246\250 (Completed)\\n                      </span>\\n                    </td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n            </table>\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"User account page with profile, subscription status, usage progress, and payment history\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/AccountPage.tsx\", \"toolAction\":\"Writing AccountPage component\", \"toolSummary\":\"Create AccountPage.tsx\"}"
      thinking_signature: "\022\265\005\n\262\005\001i\024}\023\n\217\177KP\336\277\343i\272\227\247L\244j}ra\245\030\253\206:=\327\303\322&\022d\322\273\3502!\273\354\216\257\210Y\244\n\317i\323\201\243\257\006j4\205.\201\326\270w\374B7\364Q\315~\214\351\301\316\346\023`\333\330=j>\203\252\207n\"\245\261\021\314\363K;\0020n\021\234o\004\222\243\234\276\001\267G\273\250x_\360\002;}C\352\023\340=v\356}\260\220y\346\346L<\205\237OqN\250\255\331\322q\253\032L\354\310,n\276L\252\245\2209\351\362\027\004\"r\260\035\a\017\362y\325\016\367\365p\024\021\310\250\255\231\215\016W\005\337\371[\v\310\207\225\302c\"\315F1g2\233{KL\233\377\343zF\340\222\214@\273\371ar\261\312\333\264\303g\273\0311\234g+\300\033\272\241\027\244h:\200\2574T\3156\347\367i\331\343\255\361Uy\214\276\310N\3713\3367\236\356\257\361S\216o\307\3505w\261\037\201\211\235\325Q|\264\334P\322\274=No\177P\340\340\365!\266.\343}\264I\246\242\020S\025\033.\235z$\353\363ud\374\366\302\252Y\200\006\255\206=\350\205\000\320\'\344Nq\237\255\357+\221Cv\365\200\030)\271\003\314\225\325\345R\201\303\245y\223%\362c\267\006\354\"\342o\223?Lw\303\234\344W\364\201\216.\272\364\034\363\317l\"\v\204\373\214\341\026\316\312\274\026\200q[\210\tE\215\230\316.\022O;\030cO}X\200\213r\353\366\312\3555\027 \327Vu\267\263]\036My4$P^\350\337x\367?T\220\330\3151\031\306\026s~\337d\006n]\024mN\\J\256j\253ex$L\207%\354d,\367\266w\374%ZU\317\027\325\240\216E\032\035\372\236\331\262\354\217{34\220\334\313\020^\361d\321A\321\272\244mg\336z|\214\217Tm}\'v\314\200-d\245+F\2358\'d\232KX\207\035\211\221mJW\262D(\262\305\035\273\353\234\026\244\234\353)\034\213j$_W.\236\357\240\223\002o\376\003+\207C\2547Gx\353\217\024Z\200\f\237\267\0032[R\031I\344\312\343\353\021\206\230VgJ\246\243\317\005\217=\022bO?\342`=s\250\374\204\vL\000\326\303\214\177\333\242 \034\2247\226\336\255\310\242\327\251\177k\3419$\024%\244\330\305c\366\235\354\b\342\027\346Vp\022\327\234\250\362\306V\264\256\350\243Kw\252\274C&\265\325\322x\257\217E\317\201\312p8E\330\'\021\2