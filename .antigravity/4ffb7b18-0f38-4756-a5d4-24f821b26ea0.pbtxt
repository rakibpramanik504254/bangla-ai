            }
            lines {
              text: "1. **\340\246\206\340\246\207\340\246\250\340\246\277 \340\246\252\340\247\215\340\246\260\340\246\270\340\247\215\340\246\244\340\247\201\340\246\244\340\246\277 \340\246\223 \340\246\205\340\246\250\340\247\201\340\246\256\340\247\213\340\246\246\340\246\250:**"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - \340\246\237\340\247\215\340\246\260\340\247\207\340\246\241 \340\246\262\340\246\276\340\246\207\340\246\270\340\247\207\340\246\250\340\247\215\340\246\270 (\340\246\270\340\247\215\340\246\245\340\246\276\340\246\250\340\247\200\340\246\257\340\246\274 \340\246\270\340\246\277\340\246\237\340\246\277 \340\246\225\340\246\260\340\247\215\340\246\252\340\247\213\340\246\260\340\247\207\340\246\266\340\246\250/\340\246\207\340\246\211\340\246\250\340\246\277\340\246\257\340\246\274\340\246\250 \340\246\252\340\246\260\340\246\277\340\246\267\340\246\246 \340\246\245\340\247\207\340\246\225\340\247\207)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - \340\246\207-\340\246\237\340\246\277\340\246\206\340\246\207\340\246\217\340\246\250 (TIN) \340\246\270\340\246\276\340\246\260\340\247\215\340\246\237\340\246\277\340\246\253\340\246\277\340\246\225\340\247\207\340\246\237"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - \340\246\255\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\260\340\247\207\340\246\234\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\247\207\340\246\266\340\246\250 (BIN)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "   - \340\246\207-\340\246\225\340\247\215\340\246\257\340\246\276\340\246\254 (e-CAB) \340\246\270\340\246\246\340\246\270\340\247\215\340\246\257\340\246\252\340\246\246 \340\246\223 \340\246\241\340\246\277\340\246\254\340\246\277\340\246\206\340\246\207\340\246\241\340\246\277 (DBID)"
