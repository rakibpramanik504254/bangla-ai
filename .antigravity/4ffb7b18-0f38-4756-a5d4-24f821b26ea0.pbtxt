  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect, useRef } from \'react\';\nimport {\n  MessageSquare,\n  Plus,\n  Send,\n  Trash2,\n  Edit2,\n  Check,\n  X,\n  Sparkles,\n  Bot,\n  Brain,\n  Code2,\n  ChevronDown,\n  Lock,\n  Copy,\n  Zap,\n  PanelLeftClose,\n  PanelLeftOpen,\n  ArrowRight,\n  ShieldAlert,\n  Search,\n  Pin\n} from \'lucide-react\';\nimport { useAuth } from \'../../context/AuthContext.tsx\';\nimport { Chat, Message, AiModel } from \'../../types/index.ts\';\nimport { toBanglaDigits, formatBDT, isSubscriptionActive } from \'../../utils/billing.ts\';\n\n// Lightweight, safe markdown formatter for code blocks, bold, bullets, headers\nconst FormattedMessage: React.FC<{ content: string }> = ({ content }) => {\n  const [copiedIndex, setCopiedIndex] = useState<number | null>(null);\n\n  const handleCopyCode = (code: string, idx: number) => {\n    navigator.clipboard.writeText(code);\n    setCopiedIndex(idx);\n    setTimeout(() => setCopiedIndex(null), 2000);\n  };\n\n  // Split by code blocks ```lang ... ```\n  const parts = content.split(/(```[\\s\\S]*?```)/g);\n\n  return (\n    <div className=\"space-y-3 leading-relaxed text-sm\">\n      {parts.map((part, index) => {\n        if (part.startsWith(\'```\') && part.endsWith(\'```\')) {\n          const firstLineEnd = part.indexOf(\'\\n\');\n          const lang = part.substring(3, firstLineEnd).trim() || \'code\';\n          const code = part.substring(firstLineEnd + 1, part.length - 3);\n\n          return (\n            <div key={index} className=\"rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-950 text-gray-100 my-2 shadow-sm font-mono text-xs\">\n              <div className=\"flex items-center justify-between px-4 py-1.5 bg-gray-900 border-b border-gray-800 text-[11px] text-gray-400\">\n                <span>{lang}</span>\n                <button\n                  type=\"button\"\n                  onClick={() => handleCopyCode(code, index)}\n                  className=\"flex items-center gap-1 hover:text-white px-2 py-0.5 rounded hover:bg-gray-800 transition-colors\"\n                >\n                  {copiedIndex === index ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                      <span className=\"text-emerald-400 font-sans\">\340\246\225\340\246\252\340\246\277 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207!</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span className=\"font-sans\">\340\246\225\340\247\213\340\246\241 \340\246\225\340\246\252\340\246\277</span>\n                    </>\n                  )}\n                </button>\n              </div>\n              <pre className=\"p-4 overflow-x-auto font-mono text-xs leading-relaxed text-emerald-300\">\n                <code>{code}</code>\n              </pre>\n            </div>\n          );\n        }\n\n        // Standard text lines with headers and bullets\n        const lines = part.split(\'\\n\');\n        return (\n          <div key={index} className=\"space-y-1.5\">\n            {lines.map((line, lIdx) => {\n              if (line.startsWith(\'### \')) {\n                return (\n                  <h4 key={lIdx} className=\"text-base font-bold text-gray-900 dark:text-white pt-2\">\n                    {line.substring(4)}\n                  </h4>\n                );\n              }\n              if (line.startsWith(\'## \')) {\n                return (\n                  <h3 key={lIdx} className=\"text-lg font-bold text-gray-900 dark:text-white pt-2.5\">\n                    {line.substring(3)}\n                  </h3>\n                );\n              }\n              if (line.startsWith(\'* \') || line.startsWith(\'- \')) {\n                return (\n                  <div key={lIdx} className=\"flex items-start gap-2 pl-2\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0\" />\n                    <span>{parseBold(line.substring(2))}</span>\n                  </div>\n                );\n              }\n              if (/^\\d+\\.\\s/.test(line)) {\n                return (\n                  <div key={lIdx} className=\"pl-2 font-medium\">\n                    {parseBold(line)}\n                  </div>\n                );\n              }\n              if (line.trim() === \'\') {\n                return <div key={lIdx} className=\"h-1\" />;\n              }\n              return (\n                <p key={lIdx} className=\"text-gray-800 dark:text-gray-200\">\n                  {parseBold(line)}\n                </p>\n              );\n            })}\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n\nfunction parseBold(text: string) {\n  const segments = text.split(/(\\*\\*.*?\\*\\*)/g);\n  return segments.map((seg, i) => {\n    if (seg.startsWith(\'**\') && seg.endsWith(\'**\')) {\n      return (\n        <strong key={i} className=\"font-bold text-gray-950 dark:text-white\">\n          {seg.slice(2, -2)}\n        </strong>\n      );\n    }\n    if (seg.startsWith(\'*\') && seg.endsWith(\'*\')) {\n      return (\n        <em key={i} className=\"italic text-gray-500 dark:text-gray-400\">\n          {seg.slice(1, -1)}\n        </em>\n      );\n    }\n    return seg;\n  });\n}\n\nexport const ChatInterface: React.FC = () => {\n  const { user, token, refreshUser, openPaymentModal } = useAuth();\n  const [chats, setChats] = useState<Chat[]>([]);\n  const [activeChatId, setActiveChatId] = useState<string | null>(null);\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [models, setModels] = useState<AiModel[]>([]);\n  const [selectedModelId, setSelectedModelId] = useState<string>(\'mod_gemini_2_5_flash\');\n\n  // Input & Streaming states\n  const [inputMessage, setInputMessage] = useState(\'\');\n  const [isStreaming, setIsStreaming] = useState(false);\n  const [streamedText, setStreamedText] = useState(\'\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [sidebarOpen, setSidebarOpen] = useState(true);\n  const [modelDropdownOpen, setModelDropdownOpen] = useState(false);\n\n  // Edit title state\n  const [editingChatId, setEditingChatId] = useState<string | null>(null);\n  const [editTitle, setEditTitle] = useState(\'\');\n\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n  const inputRef = useRef<HTMLTextAreaElement>(null);\n\n  const isSubscribed = user?.isSubscribed || user?.role === \'admin\';\n\n  // Load Models\n  useEffect(() => {\n    fetch(\'/api/models\')\n      .then(r => r.json())\n      .then(data => {\n        setModels(data);\n        const def = data.find((m: AiModel) => m.is_default) || data[0];\n        if (def) setSelectedModelId(def.id);\n      })\n      .catch(console.error);\n  }, []);\n\n  // Load Chats\n  const fetchChats = async () => {\n    if (!token) return;\n    try {\n      const res = await fetch(\'/api/chats\', {\n        headers: { Authorization: `Bearer ${token}` }\n      });\n      if (res.ok) {\n        const data = await res.json();\n        setChats(data);\n        if (data.length > 0 && !activeChatId) {\n          setActiveChatId(data[0].id);\n        }\n      }\n    } catch (err) {\n      console.error(\'Failed to load chats:\', err);\n    }\n  };\n\n  useEffect(() => {\n    fetchChats();\n  }, [token]);\n\n  // Load Messages for active chat\n  useEffect(() => {\n    if (!activeChatId || !token) {\n      setMessages([]);\n      return;\n    }\n\n    fetch(`/api/chats/${activeChatId}`, {\n      headers: { Authorization: `Bearer ${token}` }\n    })\n      .then(r => r.json())\n      .then(data => {\n        if (data.messages) {\n          setMessages(data.messages);\n        }\n      })\n      .catch(console.error);\n  }, [activeChatId, token]);\n\n  // Auto scroll to bottom\n  useEffect(() => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  }, [messages, streamedText]);\n\n  // Handle New Chat\n  const handleCreateNewChat = async () => {\n    if (!token) return;\n    try {\n      const res = await fetch(\'/api/chats\', {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({\n          title: \'\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237\',\n          modelId: selectedModelId\n        })\n      });\n      if (res.ok) {\n        const newChat = await res.json();\n        setChats(prev => [newChat, ...prev]);\n        setActiveChatId(newChat.id);\n        setMessages([]);\n        setInputMessage(\'\');\n        inputRef.current?.focus();\n      }\n    } catch (err) {\n      console.error(\'Create chat error:\', err);\n    }\n  };\n\n  // Delete chat\n  const handleDeleteChat = async (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    if (!token) return;\n    try {\n      const res = await fetch(`/api/chats/${id}`, {\n        method: \'DELETE\',\n        headers: { Authorization: `Bearer ${token}` }\n      });\n      if (res.ok) {\n        setChats(prev => prev.filter(c => c.id !== id));\n        if (activeChatId === id) {\n          const remaining = chats.filter(c => c.id !== id);\n          setActiveChatId(remaining.length > 0 ? remaining[0].id : null);\n        }\n      }\n    } catch (err) {\n      console.error(\'Delete chat error:\', err);\n    }\n  };\n\n  // Rename chat\n  const handleSaveRename = async (id: string, e: React.FormEvent) => {\n    e.preventDefault();\n    if (!editTitle.trim() || !token) return;\n    try {\n      const res = await fetch(`/api/chats/${id}`, {\n        method: \'PATCH\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({ title: editTitle.trim() })\n      });\n      if (res.ok) {\n        setChats(prev => prev.map(c => (c.id === id ? { ...c, title: editTitle.trim() } : c)));\n        setEditingChatId(null);\n      }\n    } catch (err) {\n      console.error(\'Rename chat error:\', err);\n    }\n  };\n\n  // Handle Send Message & SSE Stream\n  const handleSendMessage = async (customPrompt?: string) => {\n    const textToSend = (customPrompt || inputMessage).trim();\n    if (!textToSend || isStreaming || !token) return;\n\n    // Check subscription access gating\n    if (!isSubscribed) {\n      openPaymentModal(\'monthly\');\n      return;\n    }\n\n    setInputMessage(\'\');\n    setIsStreaming(true);\n    setStreamedText(\'\');\n\n    // Optimistic user message in UI\n    const tempUserMsg: Message = {\n      id: \'temp_\' + Date.now(),\n      chat_id: activeChatId || \'temp\',\n      role: \'user\',\n      content: textToSend,\n      model_id: selectedModelId,\n      tokens_used: 0,\n      created_at: new Date().toISOString()\n    };\n    setMessages(prev => [...prev, tempUserMsg]);\n\n    try {\n      const response = await fetch(\'/api/chat/stream\', {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n          Authorization: `Bearer ${token}`\n        },\n        body: JSON.stringify({\n          chatId: activeChatId,\n          message: textToSend,\n          modelId: selectedModelId\n        })\n      });\n\n      if (!response.ok) {\n        const errorData = await response.json();\n        throw new Error(errorData.error || \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\252\340\247\215\340\246\260\340\246\270\340\247\207\340\246\270\340\246\277\340\246\202 \340\246\254\340\247\215\340\246\257\340\246\260\340\247\215\340\246\245 \340\246\271\340\246\257\340\246\274\340\247\207\340\246\233\340\247\207\');\n      }\n\n      const reader = response.body?.getReader();\n      const decoder = new TextDecoder();\n      let fullAssistantText = \'\';\n\n      if (reader) {\n        while (true) {\n          const { done, value } = await reader.read();\n          if (done) break;\n\n          const textChunk = decoder.decode(value, { stream: true });\n          const lines = textChunk.split(\'\\n\');\n\n          for (const line of lines) {\n            if (line.startsWith(\'data: \')) {\n              try {\n                const data = JSON.parse(line.substring(6));\n\n                if (data.type === \'start\') {\n                  if (!activeChatId) {\n                    setActiveChatId(data.chatId);\n                    fetchChats();\n                  }\n                } else if (data.type === \'chunk\') {\n                  fullAssistantText += data.text;\n                  setStreamedText(fullAssistantText);\n                } else if (data.type === \'done\') {\n                  setMessages(prev => [...prev, data.assistantMessage]);\n                  setStreamedText(\'\');\n                  refreshUser();\n                } else if (data.type === \'error\') {\n                  throw new Error(data.error);\n                }\n              } catch (parseErr) {\n                // partial chunk skip\n              }\n            }\n          }\n        }\n      }\n    } catch (err: any) {\n      setMessages(prev => [\n        ...prev,\n        {\n          id: \'err_\' + Date.now(),\n          chat_id: activeChatId || \'\',\n          role: \'assistant\',\n          content: `\342\232\240\357\270\217 \340\246\244\340\247\215\340\246\260\340\247\201\340\246\237\340\246\277: ${err.message}`,\n          model_id: selectedModelId,\n          tokens_used: 0,\n          created_at: new Date().toISOString()\n        }\n      ]);\n      setStreamedText(\'\');\n    } finally {\n      setIsStreaming(false);\n    }\n  };\n\n  const selectedModel = models.find(m => m.id === selectedModelId) || models[0];\n  const filteredChats = chats.filter(c => c.title.toLowerCase().includes(searchQuery.toLowerCase()));\n\n  const suggestions = [\n    \'\340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\246\276\340\246\257\340\246\274\340\246\277\340\246\225 \340\246\205\340\246\202\340\246\266\340\247\200\340\246\246\340\246\276\340\246\260\340\246\277\340\246\244\340\247\215\340\246\254\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\217\340\246\225\340\246\237\340\246\277 \340\246\206\340\246\250\340\247\201\340\246\267\340\247\215\340\246\240\340\246\276\340\246\250\340\246\277\340\246\225 \340\246\207\340\246\256\340\247\207\340\246\207\340\246\262\340\247\207\340\246\260 \340\246\226\340\246\270\340\246\241\340\246\274\340\246\276 \340\246\244\340\247\210\340\246\260\340\246\277 \340\246\225\340\246\260\340\247\213\',\n    \'\340\246\234\340\246\276\340\246\255\340\246\276\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\247\215\340\246\237\340\247\207 \340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266\340\246\277 \340\246\256\340\247\213\340\246\254\340\246\276\340\246\207\340\246\262 \340\246\250\340\246\256\340\247\215\340\246\254\340\246\260 \340\246\255\340\247\215\340\246\257\340\246\276\340\246\262\340\246\277\340\246\241\340\247\207\340\246\266\340\246\250 \340\246\225\340\247\213\340\246\241 \340\246\262\340\246\277\340\246\226\340\247\207 \340\246\246\340\246\276\340\246\223\',\n    \'\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276\340\246\246\340\247\207\340\246\266\340\247\207 \340\246\207-\340\246\225\340\246\256\340\246\276\340\246\260\340\247\215\340\246\270 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\270\340\246\276 \340\246\270\340\246\256\340\247\215\340\246\252\340\247\215\340\246\260\340\246\270\340\246\276\340\246\260\340\246\243\340\247\207 \340\247\253\340\246\237\340\246\277 \340\246\270\340\247\207\340\246\260\340\246\276 \340\246\241\340\246\277\340\246\234\340\246\277\340\246\237\340\246\276\340\246\262 \340\246\256\340\246\276\340\246\260\340\247\215\340\246\225\340\247\207\340\246\237\340\246\277\340\246\202 \340\246\225\340\247\214\340\246\266\340\246\262\',\n    \'\340\246\217\340\246\225\340\246\237\340\246\277 \340\246\234\340\246\237\340\246\277\340\246\262 \340\246\252\340\246\276\340\246\207\340\246\245\340\246\250 \340\246\205\340\247\215\340\246\257\340\246\276\340\246\262\340\246\227\340\246\260\340\246\277\340\246\246\340\246\256 \340\246\223 \340\246\237\340\246\276\340\246\207\340\246\256 \340\246\225\340\246\256\340\246\252\340\247\215\340\246\262\340\247\207\340\246\225\340\247\215\340\246\270\340\246\277\340\246\237\340\246\277 \340\246\270\340\246\271\340\246\234 \340\246\255\340\246\276\340\246\267\340\246\276\340\246\257\340\246\274 \340\246\254\340\247\201\340\246\235\340\246\277\340\246\257\340\246\274\340\247\207 \340\246\254\340\246\262\340\247\213\'\n  ];\n\n  return (\n    <div className=\"flex h-[calc(100vh-4rem)] overflow-hidden bg-white dark:bg-gray-900 transition-colors\">\n      {/* Collapsible Sidebar */}\n      <aside\n        className={`${\n          sidebarOpen ? \'w-72 sm:w-80\' : \'w-0\'\n        } shrink-0 border-r border-gray-200 dark:border-gray-800 bg-gray-50/70 dark:bg-gray-950/70 flex flex-col transition-all duration-300 overflow-hidden relative z-20`}\n      >\n        <div className=\"p-3.5 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between gap-2\">\n          <button\n            onClick={handleCreateNewChat}\n            className=\"flex-1 py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs flex items-center justify-center gap-2 shadow-sm transition-all\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>\340\246\250\340\246\244\340\247\201\340\246\250 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\266\340\247\201\340\246\260\340\247\201 \340\246\225\340\246\260\340\247\201\340\246\250</span>\n          </button>\n          <button\n            onClick={() => setSidebarOpen(false)}\n            aria-label=\"\340\246\270\340\246\276\340\246\207\340\246\241\340\246\254\340\246\276\340\246\260 \340\246\262\340\247\201\340\246\225\340\246\276\340\246\250\"\n            className=\"p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-lg hover:bg-gray-200/50 dark:hover:bg-gray-800 transition-colors\"\n          >\n            <PanelLeftClose className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Search Chats */}\n        <div className=\"px-3 pt-3\">\n          <div className=\"relative\">\n            <Search className=\"w-3.5 h-3.5 absolute left-2.5 top-2.5 text-gray-400\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={e => setSearchQuery(e.target.value)}\n              placeholder=\"\340\246\271\340\246\277\340\246\270\340\247\215\340\246\237\340\247\215\340\246\260\340\246\277 \340\246\205\340\246\250\340\247\201\340\246\270\340\246\250\340\247\215\340\246\247\340\246\276\340\246\250...\"\n              className=\"w-full pl-8 pr-2.5 py-1.5 text-xs rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-emerald-500\"\n            />\n          </div>\n        </div>\n\n        {/* Chats History List */}\n        <div className=\"flex-1 overflow-y-auto p-2 space-y-1\">\n          {filteredChats.length === 0 ? (\n            <div className=\"p-6 text-center text-xs text-gray-400\">\n              {searchQuery ? \'\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\226\340\247\201\340\246\201\340\246\234\340\247\207 \340\246\252\340\246\276\340\246\223\340\246\257\340\246\274\340\246\276 \340\246\257\340\246\276\340\246\257\340\246\274\340\246\250\340\246\277\' : \'\340\246\217\340\246\226\340\246\250\340\247\213 \340\246\225\340\247\213\340\246\250\340\247\213 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\250\340\247\207\340\246\207\340\245\244 \340\246\250\340\246\244\340\247\201\340\246\250 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\266\340\247\201\340\246\260\340\247\201 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\'}\n            </div>\n          ) : (\n            filteredChats.map(c => (\n              <div\n                key={c.id}\n                onClick={() => setActiveChatId(c.id)}\n                className={`group flex items-center justify-between p-2.5 rounded-xl cursor-pointer text-xs transition-colors ${\n                  activeChatId === c.id\n                    ? \'bg-emerald-100/70 dark:bg-emerald-950/60 text-emerald-950 dark:text-emerald-200 font-semibold\'\n                    : \'text-gray-700 dark:text-gray-300 hover:bg-gray-200/50 dark:hover:bg-gray-900\'\n                }`}\n              >\n                <div className=\"flex items-center gap-2 truncate flex-1 mr-1\">\n                  <MessageSquare className=\"w-3.5 h-3.5 shrink-0 text-emerald-600 dark:text-emerald-400\" />\n                  {editingChatId === c.id ? (\n                    <form onSubmit={e => handleSaveRename(c.id, e)} className=\"flex-1\" onClick={e => e.stopPropagation()}>\n                      <input\n                        type=\"text\"\n                        autoFocus\n                        value={editTitle}\n                        onChange={e => setEditTitle(e.target.value)}\n                        onBlur={() => setEditingChatId(null)}\n                        className=\"w-full bg-white dark:bg-gray-900 px-1 py-0.5 rounded border border-emerald-500 text-xs focus:outline-none\"\n                      />\n                    </form>\n                  ) : (\n                    <span className=\"truncate\">{c.title}</span>\n                  )}\n                </div>\n\n                <div className=\"flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                  <button\n                    onClick={e => {\n                      e.stopPropagation();\n                      setEditingChatId(c.id);\n                      setEditTitle(c.title);\n                    }}\n                    aria-label=\"\340\246\250\340\246\276\340\246\256 \340\246\252\340\246\260\340\246\277\340\246\254\340\246\260\340\247\215\340\246\244\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\"\n                    className=\"p-1 hover:text-emerald-600 rounded\"\n                  >\n                    <Edit2 className=\"w-3 h-3\" />\n                  </button>\n                  <button\n                    onClick={e => handleDeleteChat(c.id, e)}\n                    aria-label=\"\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\256\340\247\201\340\246\233\340\247\201\340\246\250\"\n                    className=\"p-1 hover:text-red-500 rounded\"\n                  >\n                    <Trash2 className=\"w-3 h-3\" />\n                  </button>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Sidebar Footer Info */}\n        <div className=\"p-3 border-t border-gray-200 dark:border-gray-800 text-[11px] text-gray-500 flex items-center justify-between\">\n          <span>\340\246\256\340\247\213\340\246\237 \340\246\270\340\246\202\340\246\260\340\246\225\340\247\215\340\246\267\340\246\277\340\246\244 \340\246\232\340\247\215\340\246\257\340\246\276\340\246\237:</span>\n          <span className=\"font-bold text-gray-900 dark:text-white\">{toBanglaDigits(chats.length)}</span>\n        </div>\n      </aside>\n\n      {/* Main Chat Canvas */}\n      <main className=\"flex-1 flex flex-col h-full overflow-hidden relative\">\n        {/* Top Header / Model Selector Bar */}\n        <div className=\"h-14 border-b border-gray-200 dark:border-gray-800 px-4 flex items-center justify-between gap-3 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm z-10\">\n          <div className=\"flex items-center gap-2\">\n            {!sidebarOpen && (\n              <button\n                onClick={() => setSidebarOpen(true)}\n                aria-label=\"\340\246\270\340\246\276\340\246\207\340\246\241\340\246\254\340\246\276\340\246\260 \340\246\226\340\247\201\340\246\262\340\247\201\340\246\250\"\n                className=\"p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors\"\n              >\n                <PanelLeftOpen className=\"w-4 h-4\" />\n              </button>\n            )}\n\n            {/* Model Selector Dropdown */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setModelDropdownOpen(!modelDropdownOpen)}\n                className=\"flex items-center gap-2 px-3 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-emerald-500 bg-gray-50 dark:bg-gray-800 text-xs font-bold text-gray-900 dark:text-white transition-all shadow-2xs\"\n              >\n                <Sparkles className=\"w-3.5 h-3.5 text-emerald-500\" />\n                <span>{selectedModel?.display_name || \'\340\246\256\340\246\241\340\247\207\340\246\262 \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\250 \340\246\225\340\246\260\340\247\201\340\246\250\'}</span>\n                <span className=\"text-[10px] font-semibold px-1.5 py-0.2 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300\">\n                  {selectedModel?.badge === \'reasoning\'\n                    ? \'\340\246\257\340\247\201\340\246\225\340\247\215\340\246\244\340\246\277\340\246\266\340\246\225\340\247\215\340\246\244\340\246\277\'\n                    : selectedModel?.badge === \'coding\'\n                    ? \'\340\246\225\340\247\213\340\246\241\340\246\277\340\246\202\'\n                    : \'\340\246\270\340\247\201\340\246\252\340\246\276\340\246\260\340\246\253\340\246\276\340\246\270\340\247\215\340\246\237\'}\n                </span>\n                <ChevronDown className=\"w-3.5 h-3.5 text-gray-400\" />\n              </button>\n\n              {/* Model Dropdown Menu */}\n              {modelDropdownOpen && (\n                <div\n                  className=\"absolute left-0 mt-2 w-72 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-2xl py-2 z-50 animate-in fade-in slide-in-from-top-2\"\n                  onClick={() => setModelDropdownOpen(false)}\n                >\n                  <div className=\"px-3 py-1.5 text-[10px] uppercase font-bold text-gray-400 border-b border-gray-100 dark:border-gray-700\">\n                    \340\246\211\340\246\252\340\246\262\340\246\254\340\247\215\340\246\247 \340\246\266\340\247\200\340\246\260\340\247\215\340\246\267\340\246\270\340\247\215\340\246\245\340\246\276\340\246\250\340\247\200\340\246\257\340\246\274 \340\246\217\340\246\206\340\246\207 \340\246\256\340\246\241\340\247\207\340\246\262\340\246\270\340\246\256\340\247\202\340\246\271\n                  </div>\n                  {models.map(m => (\n                    <button\n                      key={m.id}\n                      onClick={() => setSelectedModelId(m.id)}\n                      className={`w-full text-left px-3.5 py-2.5 text-xs flex items-start gap-2.5 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors ${\n                        selectedModelId === m.id\n                          ? \'bg-emerald-50/70 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 font-bold\'\n                          : \'text-gray-800 dark:text-gray-200\'\n                      }`}\n                    >\n                      <div className=\"mt-0.5\">\n                        {m.badge === \'reasoning\' ? (\n                          <Brain className=\"w-4 h-4 text-purple-500\" />\n                        ) : m.badge === \'coding\' ? (\n                          <Code2 className=\"w-4 h-4 text-amber-500\" />\n                        ) : (\n                          <Bot className=\"w-4 h-4 text-emerald-500\" />\n                        )}\n                      </div>\n                      <div className=\"flex-1\">\n                        <div className=\"flex items-center justify-between\">\n                          <span>{m.display_name}</span>\n                          {selectedModelId === m.id && <Check className=\"w-3.5 h-3.5 text-emerald-600\" />}\n                        </div>\n                        <p className=\"text-[10px] text-gray-400 font-normal line-clamp-1 mt-0.5\">\n                          {m.description_bn}\n                        </p>\n                      </div>\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n          </div>\n\n          {/* User Usage Indicator */}\n          {user && (\n            <div className=\"flex items-center gap-2 text-xs\">\n              <div className=\"hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/80 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-[11px] font-semibold\">\n                <Zap className=\"w-3 h-3 text-amber-500 fill-amber-500\" />\n                <span>\340\246\254\340\246\276\340\246\225\340\246\277 \340\246\237\340\247\213\340\246\225\340\247\207\340\246\250: {toBanglaDigits((user.usage_limit - user.current_usage).toLocaleString())}</span>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Subscription Gating Banner if unpaid */}\n        {!isSubscribed && (\n          <div className=\"bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 text-white p-3 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-md z-10\">\n            <div className=\"flex items-center gap-2.5 text-xs sm:text-sm\">\n              <Lock className=\"w-4 h-4 shrink-0\" />\n              <span>\n                <strong>\340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\252\340\247\215\340\246\260\340\246\257\340\246\274\340\247\213\340\246\234\340\246\250:</strong> \340\246\217\340\246\206\340\246\207 \340\246\256\340\246\241\340\247\207\340\246\262\340\246\270\340\246\256\340\247\202\340\246\271 \340\246\254\340\247\215\340\246\257\340\246\254\340\246\271\340\246\276\340\246\260\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257 \340\246\205\340\246\250\340\247\201\340\246\227\340\247\215\340\246\260\340\246\271 \340\246\225\340\246\260\340\247\207 \340\246\256\340\246\276\340\246\270\340\246\277\340\246\225 (\340\247\263\340\247\247,\340\247\250\340\247\257\340\247\257) \340\246\254\340\246\276 \340\246\254\340\246\276\340\247\216\340\246\270\340\246\260\340\246\277\340\246\225 (\340\247\263\340\247\257,\340\247\257\340\247\257\340\247\257) \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\n              </span>\n            </div>\n            <button\n              onClick={() => openPaymentModal(\'monthly\')}\n              className=\"px-4 py-1.5 rounded-xl bg-white text-gray-900 font-extrabold text-xs shadow-sm hover:bg-gray-100 transition-colors shrink-0\"\n            >\n              \340\246\217\340\246\226\340\246\250\340\246\207 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\276\340\246\207\340\246\254 \340\246\225\340\246\260\340\247\201\340\246\250\n            </button>\n          </div>\n        )}\n\n        {/* Messages Stream Container */}\n        <div className=\"flex-1 overflow-y-auto px-4 sm:px-8 py-6 space-y-6\">\n          {messages.length === 0 && !isStreaming ? (\n            <div className=\"h-full flex flex-col items-center justify-center max-w-2xl mx-auto text-center py-12 space-y-6\">\n              <div className=\"w-16 h-16 rounded-3xl bg-gradient-to-tr from-emerald-500 to-cyan-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/20\">\n                <Sparkles className=\"w-8 h-8 text-amber-200\" />\n              </div>\n              <div className=\"space-y-2\">\n                <h2 className=\"text-2xl font-bold text-gray-900 dark:text-white\">\n                  \340\246\266\340\247\201\340\246\255 \340\246\205\340\246\252\340\246\260\340\246\276\340\246\271\340\247\215\340\246\250! \340\246\206\340\246\256\340\246\277 \340\246\225\340\246\277\340\246\255\340\246\276\340\246\254\340\247\207 \340\246\270\340\246\276\340\246\271\340\246\276\340\246\257\340\247\215\340\246\257 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\252\340\246\276\340\246\260\340\246\277?\n                </h2>\n                <p className=\"text-xs sm:text-sm text-gray-500 dark:text-gray-400 max-w-md mx-auto\">\n                  \340\246\250\340\246\277\340\246\260\340\247\215\340\246\254\340\246\276\340\246\232\340\246\277\340\246\244 \340\246\256\340\246\241\340\247\207\340\246\262: <strong>{selectedModel?.display_name}</strong>\340\245\244 \340\246\250\340\246\277\340\246\232\340\247\207 \340\246\257\340\247\207\340\246\225\340\247\213\340\246\250\340\247\213 \340\246\252\340\247\215\340\246\260\340\246\266\340\247\215\340\246\250 \340\246\262\340\246\277\340\246\226\340\247\201\340\246\250 \340\246\254\340\246\276 \340\246\270\340\246\276\340\246\234\340\247\207\340\246\270\340\247\215\340\246\237\340\247\207\340\246\241 \340\246\252\340\247\215\340\246\260\340\246\256\340\247\215\340\246\252\340\246\237\340\247\207 \340\246\225\340\247\215\340\246\262\340\246\277\340\246\225 \340\246\225\340\246\260\340\247\201\340\246\250\340\245\244\n                </p>\n              </div>\n\n              {/* Prompt Suggestions */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full text-left pt-4\">\n                {suggestions.map((s, idx) => (\n                  <button\n                    key={idx}\n                    type=\"button\"\n                    onClick={() => handleSendMessage(s)}\n                    className=\"p-3.5 rounded-2xl border border-gray-200 dark:border-gray-800 hover:border-emerald-500 dark:hover:border-emerald-600 bg-gray-50/50 dark:bg-gray-800/50 hover:bg-emerald-50/30 dark:hover:bg-emerald-950/20 text-xs text-gray-800 dark:text-gray-200 transition-all flex items-start justify-between gap-2 group\"\n                  >\n                    <span>{s}</span>\n                    <ArrowRight className=\"w-3.5 h-3.5 text-gray-400 group-hover:text-emerald-500 group-hover:translate-x-0.5 transition-all shrink-0 mt-0.5\" />\n                  </button>\n                ))}\n              </div>\n            </div>\n          ) : (\n            <div className=\"max-w-3xl mx-auto space-y-6\">\n              {messages.map((m, idx) => (\n                <div\n                  key={m.id || idx}\n                  className={`flex gap-3 sm:gap-4 ${m.role === \'user\' ? \'justify-end\' : \'justify-start\'}`}\n                >\n                  {m.role === \'assistant\' && (\n                    <div className=\"w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm mt-0.5\">\n                      <Sparkles className=\"w-4 h-4 text-amber-200\" />\n                    </div>\n                  )}\n\n                  <div\n                    className={`max-w-[85%] sm:max-w-[78%] rounded-3xl px-5 py-3.5 shadow-xs ${\n                      m.role === \'user\'\n                        ? \'bg-emerald-600 text-white font-medium rounded-tr-sm\'\n                        : \'bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-tl-sm border border-gray-200/80 dark:border-gray-700/80\'\n                    }`}\n                  >\n                    {m.role === \'user\' ? (\n                      <p className=\"whitespace-pre-wrap text-sm\">{m.content}</p>\n                    ) : (\n                      <FormattedMessage content={m.content} />\n                    )}\n                  </div>\n\n                  {m.role === \'user\' && user && (\n                    <div className=\"w-8 h-8 rounded-xl bg-gray-800 dark:bg-gray-700 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm mt-0.5\">\n                      {user.name.slice(0, 1).toUpperCase()}\n                    </div>\n                  )}\n                </div>\n              ))}\n\n              {/* Streaming Real-Time Output */}\n              {isStreaming && (\n                <div className=\"flex gap-3 sm:gap-4 justify-start animate-in fade-in\">\n                  <div className=\"w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm mt-0.5 animate-pulse\">\n                    <Sparkles className=\"w-4 h-4 text-amber-200\" />\n                  </div>\n                  <div className=\"max-w-[85%] sm:max-w-[78%] rounded-3xl rounded-tl-sm px-5 py-3.5 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 border border-gray-200/80 dark:border-gray-700/80 shadow-xs\">\n                    {streamedText ? (\n                      <FormattedMessage content={streamedText} />\n                    ) : (\n                      <div className=\"flex items-center gap-2 text-xs text-gray-400 py-1\">\n                        <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\" />\n                        <span>{selectedModel?.display_name} \340\246\211\340\246\244\340\247\215\340\246\244\340\246\260 \340\246\252\340\247\215\340\246\260\340\246\270\340\247\215\340\246\244\340\247\201\340\246\244 \340\246\225\340\246\260\340\246\233\340\247\207...</span>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              )}\n\n              <div ref={messagesEndRef} />\n            </div>\n          )}\n        </div>\n\n        {/* Centered Input Box Bar */}\n        <div className=\"p-4 sm:p-5 border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900\">\n          <div className=\"max-w-3xl mx-auto relative\">\n            <form\n              onSubmit={e => {\n                e.preventDefault();\n                handleSendMessage();\n              }}\n              className=\"relative flex items-end rounded-2xl border border-gray-300 dark:border-gray-700 bg-gray-50/70 dark:bg-gray-800/70 shadow-sm focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/20 transition-all p-1.5\"\n            >\n              <textarea\n                ref={inputRef}\n                rows={1}\n                value={inputMessage}\n                onChange={e => setInputMessage(e.target.value)}\n                onKeyDown={e => {\n                  if (e.key === \'Enter\' && !e.shiftKey) {\n                    e.preventDefault();\n                    handleSendMessage();\n                  }\n                }}\n                placeholder={\n                  isSubscribed\n                    ? `\340\246\254\340\246\276\340\246\202\340\246\262\340\246\276 \340\246\254\340\246\276 \340\246\207\340\246\202\340\246\260\340\247\207\340\246\234\340\246\277\340\246\244\340\247\207 \340\246\262\340\246\277\340\246\226\340\247\201\340\246\250 (${selectedModel?.display_name})...`\n                    : \'\340\246\232\340\247\215\340\246\257\340\246\276\340\246\237 \340\246\225\340\246\260\340\246\244\340\247\207 \340\246\270\340\246\276\340\246\254\340\246\270\340\247\215\340\246\225\340\247\215\340\246\260\340\246\277\340\246\252\340\246\266\340\246\250 \340\246\252\340\247\215\340\246\262\340\247\215\340\246\257\340\246\276\340\246\250 \340\246\270\340\246\225\340\247\215\340\246\260\340\246\277\340\246\257\340\246\274 \340\246\225\340\246\260\340\247\201\340\246\250...\'\n                }\n                disabled={!isSubscribed}\n                className=\"w-full resize-none bg-transparent px-3.5 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none max-h-36 disabled:opacity-60\"\n              />\n\n              <button\n                type=\"submit\"\n                disabled={!inputMessage.trim() || isStreaming || !isSubscribed}\n                className=\"p-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 text-white font-semibold transition-all shrink-0 shadow-sm\"\n                aria-label=\"\340\246\254\340\246\276\340\246\260\340\247\215\340\246\244\340\246\276 \340\246\252\340\246\276\340\246\240\340\246\276\340\246\250\"\n              >\n                <Send className=\"w-4 h-4\" />\n              </button>\n            </form>\n\n            <div className=\"flex items-center justify-between text-[11px] text-gray-400 px-2 mt-2\">\n              <span>Enter \340\246\232\340\246\276\340\246\252\340\247\201\340\246\250 \340\246\252\340\246\276\340\246\240\340\246\276\340\246\244\340\247\207 \342\200\242 Shift+Enter \340\246\250\340\246\244\340\247\201\340\246\250 \340\246\262\340\246\276\340\246\207\340\246\250\340\247\207\340\246\260 \340\246\234\340\246\250\340\247\215\340\246\257</span>\n              <span className=\"truncate max-w-[200px]\">\340\246\256\340\246\241\340\247\207\340\246\262: {selectedModel?.display_name}</span>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n};\n"
