    absolute_path_uri: "file:///src/db/database.ts"
    end_line: 129
    content: "import fs from \'node:fs\';\nimport path from \'node:path\';\nimport crypto from \'node:crypto\';\nimport { PLANS, calculateExpiryDate } from \'../utils/billing.ts\';\n\nexport interface User {\n  id: string;\n  email: string;\n  password_hash: string;\n  name: string;\n  phone: string;\n  role: \'user\' | \'admin\';\n  status: \'active\' | \'suspended\';\n  usage_limit: number; // Tokens per billing cycle\n  current_usage: number;\n  reset_token?: string | null;\n  reset_token_expires_at?: string | null;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Subscription {\n  id: string;\n  user_id: string;\n  plan_id: \'monthly\' | \'yearly\';\n  plan_name: string;\n  amount: number;\n  currency: \'BDT\';\n  status: \'active\' | \'expired\' | \'cancelled\';\n  started_at: string;\n  expires_at: string;\n  auto_renew: boolean;\n  payment_method: string;\n  trx_id: string;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Payment {\n  id: string;\n  user_id: string;\n  subscription_id?: string;\n  amount: number;\n  currency: \'BDT\';\n  gateway: \'bkash\' | \'nagad\' | \'rocket\' | \'sslcommerz\';\n  trx_id: string;\n  sender_number: string;\n  status: \'completed\' | \'pending\' | \'failed\';\n  gateway_response?: string;\n  created_at: string;\n}\n\nexport interface Chat {\n  id: string;\n  user_id: string;\n  title: string;\n  model_id: string;\n  pinned: boolean;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Message {\n  id: string;\n  chat_id: string;\n  role: \'user\' | \'assistant\' | \'system\';\n  content: string;\n  model_id: string;\n  tokens_used: number;\n  created_at: string;\n}\n\nexport interface AiProvider {\n  id: string;\n  name: string;\n  slug: string;\n  api_key: string;\n  base_url?: string;\n  is_active: boolean;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface AiModel {\n  id: string;\n  provider_id: string;\n  model_name: string;\n  display_name: string;\n  description_en: string;\n  badge: \'super_fast\' | \'reasoning\' | \'coding\' | \'balanced\';\n  is_enabled: boolean;\n  is_default: boolean;\n  context_window: number;\n  max_output_tokens: number;\n  sort_order: number;\n  created_at: string;\n}\n\nexport interface UsageRecord {\n  id: string;\n  user_id: string;\n  chat_id?: string;\n  model_id: string;\n  prompt_tokens: number;\n  completion_tokens: number;\n  total_tokens: number;\n  created_at: string;\n}\n\nexport interface SystemSettings {\n  global_usage_limit: number;\n  default_monthly_price: number;\n  default_yearly_price: number;\n  support_email: string;\n  support_phone: string;\n  announcement?: string;\n}\n\ninterface DatabaseData {\n  users: User[];\n  subscriptions: Subscription[];\n  payments: Payment[];\n  chats: Chat[];\n  messages: Message[];\n  ai_providers: AiProvider[];\n  ai_models: AiModel[];\n  usage_records: UsageRecord[];\n  settings: SystemSettings;\n}\n"
    num_lines: 799
